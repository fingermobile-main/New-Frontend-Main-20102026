# Production Environment Configuration
# Copy this file to .env.production and update with production-grade secure credentials
# IMPORTANT: Never commit actual production secrets to version control!

# Database Configuration - Production
DB_HOST=prod-db.fingermobile.com
DB_PORT=5432
DB_NAME=fingermobile_production
DB_USER=fingermobile_prod_user
DB_PASSWORD=CHANGE_ME_PRODUCTION_ULTRA_SECURE_DB_PASSWORD_MIN_64_CHARS_USE_PASSWORD_MANAGER
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_ULTRA_SECURE_DB_PASSWORD_MIN_64_CHARS_USE_PASSWORD_MANAGER
DB_URL=postgresql://fingermobile_prod_user:CHANGE_ME_PRODUCTION_ULTRA_SECURE_DB_PASSWORD_MIN_64_CHARS_USE_PASSWORD_MANAGER@prod-db.fingermobile.com:5432/fingermobile_production

# Gems Backend Database - Production
GEMS_DB_NAME=gems_production
GEMS_DB_URL=postgresql://fingermobile_prod_user:CHANGE_ME_PRODUCTION_ULTRA_SECURE_DB_PASSWORD_MIN_64_CHARS_USE_PASSWORD_MANAGER@prod-db.fingermobile.com:5432/gems_production

# OwnIt Database - Production
OWNIT_DB_NAME=ownit_production
OWNIT_DB_URL=postgresql://fingermobile_prod_user:CHANGE_ME_PRODUCTION_ULTRA_SECURE_DB_PASSWORD_MIN_64_CHARS_USE_PASSWORD_MANAGER@prod-db.fingermobile.com:5432/ownit_production

# Stercs Database - Production
STERCS_DB_NAME=stercs_production
STERCS_DB_USER=stercs_prod_user
STERCS_DB_PASSWORD=CHANGE_ME_STERCSS_PRODUCTION_ULTRA_SECURE_PASSWORD_MIN_64_CHARS
STERCS_DB_URL=postgresql://stercs_prod_user:CHANGE_ME_STERCSS_PRODUCTION_ULTRA_SECURE_PASSWORD_MIN_64_CHARS@prod-db.fingermobile.com:5432/stercs_production

# Redis Configuration - Production
REDIS_URL=rediss://:CHANGE_ME_PRODUCTION_ULTRA_SECURE_REDIS_PASSWORD_MIN_64_CHARS@prod-redis.fingermobile.com:6380
REDIS_PASSWORD=CHANGE_ME_PRODUCTION_ULTRA_SECURE_REDIS_PASSWORD_MIN_64_CHARS

# JWT Configuration - Production (Use strong, unique secret)
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET_MIN_128_CHARS_GENERATE_WITH_CRYPTO_RANDOM_BYTES
JWT_EXPIRES_IN=6h

# API Keys and Secrets - Production
API_KEY_PREFIX=fmp_
API_KEY_LENGTH=64

# AWS Configuration - Production
AWS_ACCESS_KEY_ID=CHANGE_ME_PRODUCTION_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=CHANGE_ME_PRODUCTION_AWS_SECRET_ACCESS_KEY_MIN_40_CHARS
AWS_REGION=us-east-1
AWS_S3_BUCKET=fingermobile-production-assets-unique-suffix

# Email Configuration - Production (Use production email service)
EMAIL_SERVICE_API_KEY=CHANGE_ME_PRODUCTION_EMAIL_SERVICE_API_KEY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_PRODUCTION_SMTP_USER@fingermobile.com
SMTP_PASS=CHANGE_ME_PRODUCTION_SMTP_APP_PASSWORD_16_CHARS

# Social Media APIs - Production (Use production app credentials)
GOOGLE_CLIENT_ID=CHANGE_ME_PRODUCTION_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_PRODUCTION_GOOGLE_CLIENT_SECRET
FACEBOOK_APP_ID=CHANGE_ME_PRODUCTION_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=CHANGE_ME_PRODUCTION_FACEBOOK_APP_SECRET

# Payment Gateway - Production (Use live mode with real credentials)
PAYPAL_CLIENT_ID=CHANGE_ME_PRODUCTION_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_ME_PRODUCTION_PAYPAL_CLIENT_SECRET
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_PRODUCTION_STRIPE_PUBLISHABLE_KEY
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_PRODUCTION_STRIPE_SECRET_KEY

# Push Notifications - Production
FCM_SERVER_KEY=CHANGE_ME_PRODUCTION_FCM_SERVER_KEY

# Test Configuration - Production (Separate test database)
TEST_DB_URI=mongodb://prod-mongo.fingermobile.com:27017/test_fingermobile_prod
TEST_USER_PASSWORD=CHANGE_ME_PRODUCTION_TEST_PASSWORD_ULTRA_SECURE

# Production Settings
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://www.fingermobile.com
BACKEND_URL=https://api.fingermobile.com

# Logging - Warning level for production (reduce log volume)
LOG_LEVEL=warn

# Security - Strict CORS for production
CORS_ORIGIN=https://www.fingermobile.com,https://admin.fingermobile.com
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX_REQUESTS=100

# Additional Production Security Settings
SESSION_SECRET=CHANGE_ME_PRODUCTION_SESSION_SECRET_MIN_128_CHARS
ENCRYPTION_KEY=CHANGE_ME_PRODUCTION_ENCRYPTION_KEY_MIN_256_BITS_BASE64
ALLOWED_ORIGINS=https://www.fingermobile.com,https://admin.fingermobile.com
SECURE_COOKIES=true
HTTPS_ONLY=true
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
