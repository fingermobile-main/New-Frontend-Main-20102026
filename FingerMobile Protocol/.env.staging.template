# Staging Environment Configuration for OpenAI Integration
# Copy this to .env.staging and fill in actual values

# Application Configuration
NODE_ENV=staging
PORT=3000
APP_URL=https://staging.fingermobileprotocol.com

# Database Configuration (Staging)
DB_HOST=staging-db.fingermobileprotocol.com
DB_PORT=5432
DB_NAME=fingermobile_staging
DB_USER=fingermobile_staging
DB_PASSWORD=YOUR_STAGING_DB_PASSWORD

# Redis Configuration (Staging)
REDIS_HOST=staging-redis.fingermobileprotocol.com
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_STAGING_REDIS_PASSWORD

# JWT Configuration
JWT_SECRET=YOUR_STAGING_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=YOUR_STAGING_REFRESH_SECRET_MIN_32_CHARS
JWT_REFRESH_EXPIRES_IN=30d

# OpenAI Configuration (Use test keys for staging)
OPENAI_API_KEY=sk-svcacct-YOUR_STAGING_TEST_KEY
OPENAI_ORGANIZATION=org-your-org-id

# Payment Gateway Configuration (Use sandbox/test keys)
PAYSTACK_SECRET_KEY=sk_test_YOUR_PAYSTACK_TEST_KEY
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-YOUR_FLUTTERWAVE_TEST_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_test_YOUR_STRIPE_WEBHOOK_SECRET

# AI Feature Configuration
AI_CACHE_TTL=3600
AI_RATE_LIMIT_WINDOW=60000
AI_MAX_CONCURRENT_REQUESTS=100

# Logging Configuration
LOG_LEVEL=debug
LOG_FILE_PATH=/var/log/fingermobile/staging

# Sentry Configuration (Error Monitoring)
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
SENTRY_ENVIRONMENT=staging

# CORS Configuration
CORS_ORIGIN=https://staging.fingermobileprotocol.com,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
