{
  "name": "lush-pressies-backend-api",
  "version": "1.0.0",
  "description": "Backend API for the Lush Pressies app with LinkedIn-style 3-column layout, privacy controls, and advanced matching features",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "seed": "node scripts/seed-db.js",
    "migrate": "node scripts/run-migrations.js",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write src/**/*.js"
  },
  "keywords": [
    "dating-app",
    "matching",
    "privacy",
    "gamification",
    "social-network",
    "real-time-chat",
    "geolocation",
    "escrow-gifting",
    "linkedin-style",
    "three-column-layout"
  ],
  "author": "Lush Pressies Team",
  "license": "MIT",
  "dependencies": {
    "aws-sdk": "^2.1401.0",
    "axios": "^1.4.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^7.0.1",
    "firebase-admin": "^11.9.0",
    "geo-tz": "^8.1.9",
    "helmet": "^6.1.5",
    "hpp": "^0.2.3",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^6.9.3",
    "pg": "^8.11.0",
    "redis": "^4.6.7",
    "sharp": "^0.32.1",
    "socket.io": "^4.7.2",
    "stripe": "^12.12.0",
    "turf": "^3.0.14",
    "twilio": "^4.15.0",
    "uuid": "^9.0.0",
    "validator": "^13.9.0"
  },
  "devDependencies": {
    "babel-jest": "^29.5.0",
    "eslint": "^8.42.0",
    "faker": "^6.6.6",
    "jest": "^29.5.0",
    "nodemon": "^2.0.22",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lush-pressies/backend-api.git"
  },
  "bugs": {
    "url": "https://github.com/lush-pressies/backend-api/issues"
  },
  "homepage": "https://github.com/lush-pressies/backend-api#readme"
}
