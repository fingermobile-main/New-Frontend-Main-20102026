{
  "extends": "./tsconfig.json",
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*test.ts",
    "src/**/*test.tsx",
    "src/**/*spec.ts",
    "src/**/*spec.tsx",
    "src/setupTests.js",
    "src/setupTests.ts"
  ]
}