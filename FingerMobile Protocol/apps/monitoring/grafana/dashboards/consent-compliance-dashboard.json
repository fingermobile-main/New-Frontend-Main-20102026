{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "🛡️ Regulatory Compliance & Privacy Governance (NDPA / GDPR / EU AI Act)",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Platform Consent Compliance Rate",
      "type": "gauge",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(user_consent_recorded_total{status=\"success\"}[5m])) / sum(rate(user_consent_recorded_total[5m])) * 100",
          "legendFormat": "Compliance Rate (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "EU AI Act Opt-In Adoption",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(user_consent_active{flag=\"ai_training\"}) / sum(user_consent_active{flag=\"essential\"}) * 100",
          "legendFormat": "AI Training Consent (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "purple", "value": 40 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Data Erasure SLA Compliance (< 72 Hours)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(data_erasure_requests_completed_under_sla_total[1h])) / sum(rate(data_erasure_requests_total[1h])) * 100",
          "legendFormat": "SLA Met (%)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Unconsented Route Blocks (ConsentGuard)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "sum(increase(http_requests_blocked_consent_guard_total[1h]))",
          "legendFormat": "Blocked Requests (403)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "📊 Granular Consent Flag Distribution & Ingestion",
      "type": "row"
    },
    {
      "id": 5,
      "title": "Granular Opt-In Trends over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 9 },
      "targets": [
        {
          "expr": "sum(rate(user_consent_flag_toggled_total{flag=\"functional\"}[5m]))",
          "legendFormat": "Functional"
        },
        {
          "expr": "sum(rate(user_consent_flag_toggled_total{flag=\"analytics\"}[5m]))",
          "legendFormat": "Analytics"
        },
        {
          "expr": "sum(rate(user_consent_flag_toggled_total{flag=\"marketing\"}[5m]))",
          "legendFormat": "Marketing"
        },
        {
          "expr": "sum(rate(user_consent_flag_toggled_total{flag=\"ai_training\"}[5m]))",
          "legendFormat": "AI Training"
        }
      ]
    },
    {
      "id": 6,
      "title": "WORM S3 Audit Logging Ingestion Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 9 },
      "targets": [
        {
          "expr": "sum(rate(s3_audit_log_objects_written_total[5m]))",
          "legendFormat": "S3 Objects Locked/sec"
        },
        {
          "expr": "sum(rate(kafka_consent_events_produced_total[5m]))",
          "legendFormat": "Kafka Events Ingested/sec"
        }
      ]
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["fingermobile", "compliance", "gdpr", "ndpa", "eu-ai-act"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "timezone": "browser",
  "title": "FingerMobile - Privacy & Regulatory Consent Compliance Console",
  "version": 1
}
