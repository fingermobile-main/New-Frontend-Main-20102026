# ==========================================
# FingerMobile Protocol - Staging Environment Variables
# Date: June 11, 2026
# IMPORTANT: Copy this to .env.staging and fill in actual values
# NEVER commit .env.staging to version control
# ==========================================

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=staging
PORT=3000
HOST=0.0.0.0
WS_PORT=3001

# ==========================================
# DATABASE CONFIGURATION (PostgreSQL)
# ==========================================
DB_USER=fingermobile_staging
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fingermobile_staging

# Database Connection Pool
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=30000

# ==========================================
# REDIS CONFIGURATION
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456
REDIS_DB=0
REDIS_SESSION_TTL=86400

# ==========================================
# JWT & AUTHENTICATION
# ==========================================
JWT_SECRET=CHANGE_THIS_JWT_SECRET_MUST_BE_AT_LEAST_32_CHARACTERS_LONG_FOR_SECURITY
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ==========================================
# AWS/S3 CONFIGURATION (File Storage)
# ==========================================
AWS_ACCESS_KEY_ID=CHANGE_THIS_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_THIS_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=fingermobile-staging
AWS_CLOUDFRONT_DOMAIN=staging-cdn.fingermobileprotocol.com

# ==========================================
# EMAIL CONFIGURATION (SendGrid)
# ==========================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=CHANGE_THIS_SENDGRID_API_KEY
EMAIL_FROM=noreply@staging.fingermobileprotocol.com

# ==========================================
# PAYMENT GATEWAY CONFIGURATION
# ==========================================
PAYSTACK_SECRET_KEY=sk_test_CHANGE_THIS_PAYSTACK_KEY
PAYSTACK_PUBLIC_KEY=pk_test_CHANGE_THIS_PAYSTACK_KEY
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_CHANGE_THIS_KEY

# ==========================================
# AI SERVICES (OpenAI)
# ==========================================
OPENAI_API_KEY=sk-proj-CHANGE_THIS_OPENAI_KEY
AI_RATE_LIMIT_PER_MINUTE=60
AI_CREDIT_COST_CHAT=1
AI_CREDIT_COST_IMAGE=10

# ==========================================
# SECURITY CONFIGURATION
# ==========================================
CORS_ORIGINS=https://staging.fingermobileprotocol.com,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true
CSRF_PROTECTION=true

# ==========================================
# MONITORING & LOGGING
# ==========================================
SENTRY_DSN=https://CHANGE_THIS@sentry.io/PROJECT_ID
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=true

# ==========================================
# GRAFANA ADMIN
# ==========================================
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# ==========================================
# FEATURE FLAGS
# ==========================================
ENABLE_2FA=true
ENABLE_BIOMETRIC=true
ENABLE_AI_FEATURES=true
ENABLE_PAYMENTS=true
ENABLE_WEBSOCKET=true
ENABLE_MONITORING=true

# ==========================================
# CDN & CACHE
# ==========================================
CDN_URL=https://staging-cdn.fingermobileprotocol.com
CACHE_TTL=3600
ENABLE_GZIP=true