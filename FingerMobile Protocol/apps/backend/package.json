{
  "name": "fingermobile-backend",
  "version": "1.0.0",
  "description": "Backend for the FingerMobile platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:ts": "tsc --project tsconfig.json",
    "build:watch": "tsc --watch --project tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:security": "jest __tests__/security.test.js",
    "test:nexusgnn": "jest __tests__/services/nexusgnn.test.js --forceExit",
    "init:nexusgnn": "node database/init_nexusgnn.js",
    "lint": "eslint .",
    "setup-logs": "mkdir -p logs",
    "db:migrate": "node database/run_migrations.js",
    "db:migrate:master": "node database/run_master_migration.js",
    "db:rollback": "node database/rollback_migrations.js",
    "db:migrate:make": "knex migrate:make --knexfile knexfile.ts",
    "db:seed": "knex seed:run --knexfile knexfile.ts",
    "seed:content": "node database/seed_product_forum_data.js"
  },
