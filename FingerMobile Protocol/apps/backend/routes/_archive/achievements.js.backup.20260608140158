const express = require("express");
const router = express.Router();
const { identityDb } = require("../db");

// Get all achievements with filters
router.get("/", async (req, res) => {
  try {
    const {
      category,
      rarity,
      limit = 20,
      offset = 0,
      sortBy = 'created_at',
      sortOrder = 'DESC'
    } = req.query;

    let query = `SELECT a.*, COUNT(aa.member_id) as unlocked_count
                 FROM achievements a
                 LEFT JOIN achievement_awards aa ON a.id = aa.achievement_id
                 WHERE 1=1`;
    const params = [];
    let paramIndex = 0;

    if (category) {
      paramIndex++;
      query += ` AND a.category = $${paramIndex}`;
      params.push(category);
    }

    if (rarity) {
      paramIndex++;
      query += ` AND a.rarity = $${paramIndex}`;
      params.push(rarity);
    }

    query += ` GROUP BY a.id ORDER BY a.${sortBy} ${sortOrder} LIMIT $${paramIndex + 1} OFFSET $${paramIndex + 2}`;
    params.push(parseInt(limit), parseInt(offset));

    const { rows } = await identityDb.query(query, params);
    res.json(rows);
  } catch (err) {
    console.error("Error fetching achievements:", err);
    res.status(500).json({ error: "Server error" });
  }
});

// Get a specific achievement by ID
router.get("/:achievementId", async (req, res) => {
  try {
    const { achievementId } = req.params;

    const { rows } = await identityDb.query(
      `SELECT a.*, COUNT(aa.member_id) as unlocked_count
       FROM achievements a
       LEFT JOIN achievement_awards aa ON a.id = aa.achievement_id
       WHERE a.id = $1
       GROUP BY a.id`,
      [achievementId],
    );

    if (rows.length === 0) {
      return res.status(404).json({ error: "Achievement not found" });
    }

    res.json(rows[0]);
  } catch (err) {
    console.error("Error fetching achievement:", err);
    res.status(500).json({ error: "Server error" });
  }
});

// Get achievements for a specific user
router.get("/user/:userId", async (req, res) => {
  try {
    const { userId } = req.params;
    const requestingUserId = req.member.id;

    // Only allow viewing own achievements or if admin
    if (requestingUserId !== userId && !req.member.isAdmin) {
      return res.status(403).json({ error: "Access denied" });
    }

    const { rows } = await identityDb.query(
      `SELECT a.*, aa.awarded_at, aa.progress
       FROM achievements a
       JOIN achievement_awards aa ON a.id = aa.achievement_id
       WHERE aa.member_id = $1
       ORDER BY aa.awarded_at DESC`,
      [userId],
    );

    res.json(rows);
  } catch (err) {
    console.error("Error fetching user achievements:", err);
    res.status(500).json({ error: "Server error" });
  }
});

// Create a new achievement (admin only)
router.post("/", async (req, res) => {
  try {
    const {
      title,
      description,
      category,
      rarity,
      points_value,
      icon_url,
      secret = false,
      prerequisites
    } = req.body;

    // Verify user has admin privileges
    if (!req.member || !req.member.isAdmin) {
      return res.status(403).json({ error: "Access denied" });
    }

    const { rows } = await identityDb.query(
      `INSERT INTO achievements 
       (title, description, category, rarity, points_value, icon_url, secret, prerequisites)
       VALUES ($1, $2, $3, $4, $5, $6, $7, $8)
       RETURNING *`,
      [title, description, category, rarity, points_value, icon_url, secret, prerequisites],
    );

    res.status(201).json(rows[0]);
  } catch (err) {
    console.error("Error creating achievement:", err);
    res.status(500).json({ error: "Server error" });
  }
});

// Award an achievement to a user (admin only or system triggered)
router.post("/award", async (req, res) => {
  try {
    const {
      achievement_id,
      member_id,
      custom_message
    } = req.body;

    // Verify user has admin privileges or is the system
    if (!req.member || (!req.member.isAdmin && req.member.id !== member_id)) {
      return res.status(403).json({ error: "Access denied" });
    }

    // Check if achievement exists
    const achievementCheck = await identityDb.query(
      "SELECT * FROM achievements WHERE id = $1",
      [achievement_id]
    );

    if (achievementCheck.rows.length === 0) {
      return res.status(404).json({ error: "Achievement not found" });
    }

    // Check if already awarded
    const existingAward = await identityDb.query(
      "SELECT * FROM achievement_awards WHERE achievement_id = $1 AND member_id = $2",
      [achievement_id, member_id]
    );

    if (existingAward.rows.length > 0) {
      return res.status(400).json({ error: "Achievement already awarded to this user" });
    }

    const { rows } = await identityDb.query(
      `INSERT INTO achievement_awards 
       (achievement_id, member_id, awarded_at, progress, custom_message)
       VALUES ($1, $2, CURRENT_TIMESTAMP, 100, $3)
       RETURNING *`,
      [achievement_id, member_id, custom_message]
    );

    // Update member's achievement points
    await identityDb.query(
      `UPDATE members 
       SET total_points = total_points + (SELECT points_value FROM achievements WHERE id = $1)
       WHERE id = $2`,
      [achievement_id, member_id]
    );

    res.status(201).json(rows[0]);
  } catch (err) {
    console.error("Error awarding achievement:", err);
    res.status(500).json({ error: "Server error" });
  }
});

// Update achievement progress (for in-progress achievements)
router.put("/progress", async (req, res) => {
  try {
    const {
      achievement_id,
      progress
    } = req.body;

    const member_id = req.member.id;

    // Check if achievement exists
    const achievementCheck = await identityDb.query(
      "SELECT * FROM achievements WHERE id = $1",
      [achievement_id]
    );

    if (achievementCheck.rows.length === 0) {
      return res.status(404).json({ error: "Achievement not found" });
    }

    // Check if user has started this achievement
    const existingRecord = await identityDb.query(
      "SELECT * FROM achievement_awards WHERE achievement_id = $1 AND member_id = $2",
      [achievement_id, member_id]
    );

    if (existingRecord.rows.length === 0) {
      // Create new record if not started
      await identityDb.query(
        `INSERT INTO achievement_awards 
         (achievement_id, member_id, progress)
         VALUES ($1, $2, $3)`,
        [achievement_id, member_id, progress]
      );
    } else {
      // Update existing progress
      await identityDb.query(
        `UPDATE achievement_awards 
         SET progress = $1, updated_at = CURRENT_TIMESTAMP
         WHERE achievement_id = $2 AND member_id = $3`,
        [progress, achievement_id, member_id]
      );
    }

    res.json({ message: "Progress updated successfully" });
  } catch (err) {
    console.error("Error updating achievement progress:", err);
    res.status(500).json({ error: "Server error" });
  }
});

// Get leaderboard for achievements
router.get("/leaderboard", async (req, res) => {
  try {
    const {
      category,
      limit = 20,
      offset = 0
    } = req.query;

    let query = `SELECT m.id, m.membername, m.avatar_url, 
                 COUNT(aa.achievement_id) as achievements_unlocked,
                 SUM(a.points_value) as total_points
                 FROM members m
                 LEFT JOIN achievement_awards aa ON m.id = aa.member_id
                 LEFT JOIN achievements a ON aa.achievement_id = a.id
                 WHERE aa.awarded_at IS NOT NULL`;

    const params = [];
    let paramIndex = 0;

    if (category) {
      paramIndex++;
      query += ` AND a.category = $${paramIndex}`;
      params.push(category);
    }

    query += ` GROUP BY m.id, m.membername, m.avatar_url
               HAVING COUNT(aa.achievement_id) > 0
               ORDER BY total_points DESC, achievements_unlocked DESC
               LIMIT $${paramIndex + 1} OFFSET $${paramIndex + 2}`;
    params.push(parseInt(limit), parseInt(offset));

    const { rows } = await identityDb.query(query, params);
    res.json(rows);
  } catch (err) {
    console.error("Error fetching achievement leaderboard:", err);
    res.status(500).json({ error: "Server error" });
  }
});

module.exports = router;