// Get trending media items
router.get("/trending", async (req, res) => {
  try {
    const {
      limit = 20,
      days = 7 // Trending from last N days
    } = req.query;

    const { rows } = await contentDb.query(
      `SELECT m.*, u.membername as uploader_name,
       COUNT(ml.id) as view_count
       FROM media_items m
       JOIN members u ON m.uploader_id = u.id
       LEFT JOIN media_logs ml ON m.id = ml.media_id AND ml.action = 'view'
       WHERE m.created_at >= NOW() - INTERVAL '${days} days'
       GROUP BY m.id, u.membername
       ORDER BY view_count DESC
       LIMIT $1`,
      [parseInt(limit)]
    );

    res.json(rows);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

module.exports = router;
