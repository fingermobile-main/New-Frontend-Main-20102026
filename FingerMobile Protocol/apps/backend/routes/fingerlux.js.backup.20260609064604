// Submit review
router.post("/items/:itemId/reviews", async (req, res) => {
  try {
    const { itemId } = req.params;
    const { rating, title, review_text, images } = req.body;
    const reviewerId = req.member?.id;

    if (!reviewerId) {
      return res.status(401).json({ error: "Authentication required" });
    }

    if (!rating || rating < 1 || rating > 5) {
      return res.status(400).json({ error: "Rating must be between 1 and 5" });
    }

    // Check if user already reviewed this item
    const existingReview = await contentDb.query(
      "SELECT id FROM fingerlux_reviews WHERE item_id = $1 AND reviewer_id = $2",
      [itemId, reviewerId]
    );

    if (existingReview.rows.length > 0) {
      return res.status(409).json({ error: "You have already reviewed this item" });
    }

    // Verify purchase (optional - can be enhanced with order history)
    const verifiedPurchase = false; // TODO: Check order history

    const { rows } = await contentDb.query(
      `INSERT INTO fingerlux_reviews 
       (item_id, reviewer_id, rating, title, review_text, images, verified_purchase, status)
       VALUES ($1, $2, $3, $4, $5, $6, $7, 'pending')
       RETURNING *`,
      [itemId, reviewerId, rating, title, review_text, images || [], verifiedPurchase]
    );

    res.status(201).json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

