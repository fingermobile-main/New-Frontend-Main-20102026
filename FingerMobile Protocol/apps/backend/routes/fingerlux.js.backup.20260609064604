      );
    }

    const cart = cartResult.rows[0];

    // Get cart items
    const itemsResult = await contentDb.query(
      `SELECT fci.*, fi.title, fi.cover_image, fi.stock_quantity,
              fb.name as brand_name
       FROM fingerlux_cart_items fci
       JOIN fingerlux_items fi ON fci.item_id = fi.id
       LEFT JOIN fingerlux_brands fb ON fi.brand_id = fb.id
       WHERE fci.cart_id = $1
       ORDER BY fci.created_at DESC`,
      [cart.id]
    );

    res.json({
      cart,
      items: itemsResult.rows
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Add item to cart
router.post("/cart", async (req, res) => {
  try {
    const { item_id, quantity = 1, customizations } = req.body;
    const userId = req.member?.id;

    if (!userId) {
      return res.status(401).json({ error: "Authentication required" });
    }

    // Get or create cart
    let cartResult = await contentDb.query(
      "SELECT id FROM fingerlux_shopping_carts WHERE user_id = $1",
      [userId]
    );

    if (cartResult.rows.length === 0) {
      cartResult = await contentDb.query(
        "INSERT INTO fingerlux_shopping_carts (user_id) VALUES ($1) RETURNING id",
        [userId]
      );
    }

    const cartId = cartResult.rows[0].id;

    // Get item price
    const itemResult = await contentDb.query(
      "SELECT id, price, stock_quantity FROM fingerlux_items WHERE id = $1 AND status = 'available'",
      [item_id]
    );

    if (itemResult.rows.length === 0) {
      return res.status(404).json({ error: "Item not found or unavailable" });
    }

    const item = itemResult.rows[0];

    if (quantity > item.stock_quantity) {
      return res.status(400).json({ 
        error: `Only ${item.stock_quantity} items available` 
      });
    }

    // Add or update cart item
    const { rows } = await contentDb.query(
      `INSERT INTO fingerlux_cart_items (cart_id, item_id, quantity, unit_price, customizations)
       VALUES ($1, $2, $3, $4, $5)
       ON CONFLICT (cart_id, item_id) 
       DO UPDATE SET quantity = fingerlux_cart_items.quantity + $3, updated_at = NOW()
       RETURNING *`,
      [cartId, item_id, quantity, item.price, customizations]
    );

    res.status(201).json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Update cart item quantity
router.put("/cart/:itemId", async (req, res) => {
  try {
    const { itemId } = req.params;
    const { quantity } = req.body;
    const userId = req.member?.id;

    if (!userId) {
      return res.status(401).json({ error: "Authentication required" });
    }

    if (quantity <= 0) {
      // Remove item if quantity is 0 or negative
      await contentDb.query(
        `DELETE FROM fingerlux_cart_items fci
         USING fingerlux_shopping_carts fsc
         WHERE fci.cart_id = fsc.id AND fci.item_id = $1 AND fsc.user_id = $2`,
        [itemId, userId]
      );
      return res.json({ success: true });
    }

    const { rows } = await contentDb.query(
      `UPDATE fingerlux_cart_items fci
       SET quantity = $1, updated_at = NOW()
       FROM fingerlux_shopping_carts fsc
       WHERE fci.cart_id = fsc.id AND fci.item_id = $2 AND fsc.user_id = $3
       RETURNING fci.*`,
      [quantity, itemId, userId]
    );

    if (rows.length === 0) {
      return res.status(404).json({ error: "Cart item not found" });
    }

    res.json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

