// Search luxury items
router.get("/search", async (req, res) => {
  try {
    const { q, category, brand, min_price, max_price, condition, limit = 20, offset = 0 } = req.query;

    let query = `SELECT fi.*, fb.name as brand_name, fc.name as category_name
                 FROM fingerlux_items fi
                 JOIN fingerlux_brands fb ON fi.brand_id = fb.id
                 JOIN fingerlux_categories fc ON fi.category_id = fc.id
                 WHERE fi.status = 'available'`;
    
    const params = [];
    let paramIndex = 0;

    if (q) {
      paramIndex++;
      query += ` AND (fi.title ILIKE $${paramIndex} OR fi.description ILIKE $${paramIndex})`;
      params.push(`%${q}%`);
    }

    if (category) {
      paramIndex++;
      query += ` AND fi.category_id = $${paramIndex}`;
      params.push(category);
    }

    if (brand) {
      paramIndex++;
      query += ` AND fi.brand_id = $${paramIndex}`;
      params.push(brand);
    }

    if (min_price) {
      paramIndex++;
      query += ` AND fi.price >= $${paramIndex}`;
      params.push(parseFloat(min_price));
    }

    if (max_price) {
      paramIndex++;
      query += ` AND fi.price <= $${paramIndex}`;
      params.push(parseFloat(max_price));
    }

    if (condition) {
      paramIndex++;
      query += ` AND fi.condition = $${paramIndex}`;
      params.push(condition);
    }

    query += ` ORDER BY fi.created_at DESC LIMIT $${paramIndex + 1} OFFSET $${paramIndex + 2}`;
    params.push(parseInt(limit), parseInt(offset));

    const { rows } = await contentDb.query(query, params);

    // Get total count
    const countQuery = query.replace(/ORDER BY.*$/, '').replace(/SELECT.*?FROM/, 'SELECT COUNT(*) FROM');
    const countResult = await contentDb.query(countQuery, params.slice(0, -2));

    res.json({
      items: rows,
      total: parseInt(countResult.rows[0].count)
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

