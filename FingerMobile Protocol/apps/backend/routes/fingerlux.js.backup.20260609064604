// Get auction details
router.get("/auctions/:auctionId", async (req, res) => {
  try {
    const { auctionId } = req.params;

    const { rows } = await contentDb.query(
      `SELECT fa.*, fi.*, fb.name as seller_name
       FROM fingerlux_auctions fa
       JOIN fingerlux_items fi ON fa.item_id = fi.id
       LEFT JOIN members fb ON fa.seller_id::text = fb.id::text
       WHERE fa.id = $1`,
      [auctionId]
    );

    if (rows.length === 0) {
      return res.status(404).json({ error: "Auction not found" });
    }

    // Get bids for this auction
    const bidsResult = await contentDb.query(
      `SELECT fb.*, m.username as bidder_name
       FROM fingerlux_bids fb
       LEFT JOIN members m ON fb.bidder_id::text = m.id::text
       WHERE fb.auction_id = $1
       ORDER BY fb.amount DESC
       LIMIT 10`,
      [auctionId]
    );

    res.json({
      auction: rows[0],
      bids: bidsResult.rows
    });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Place bid on auction
router.post("/auctions/:auctionId/bids", async (req, res) => {
  try {
    const { auctionId } = req.params;
    const { amount } = req.body;
    const bidderId = req.member?.id;

    if (!bidderId) {
      return res.status(401).json({ error: "Authentication required" });
    }

    if (!amount || amount <= 0) {
      return res.status(400).json({ error: "Valid bid amount required" });
    }

    // Check auction exists and is active
    const auctionResult = await contentDb.query(
      "SELECT * FROM fingerlux_auctions WHERE id = $1 AND status = 'active'",
      [auctionId]
    );

    if (auctionResult.rows.length === 0) {
      return res.status(404).json({ error: "Active auction not found" });
    }

    const auction = auctionResult.rows[0];

    // Validate bid amount
    const minBid = auction.current_bid || auction.starting_price;
    if (amount <= minBid) {
      return res.status(400).json({ 
        error: `Bid must be greater than ${minBid}` 
      });
    }

    // Place bid
    const { rows } = await contentDb.query(
      `INSERT INTO fingerlux_bids (auction_id, bidder_id, amount)
       VALUES ($1, $2, $3)
       RETURNING *`,
      [auctionId, bidderId, amount]
    );

    res.status(201).json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

