# ============================================
# FingerMobile Protocol - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fingermobile_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3000
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
SESSION_SECRET=your_session_secret_here

# ============================================
# External Services - Algolia
# ============================================
ALGOLIA_API_KEY=your_algolia_api_key_here
ALGOLIA_APP_ID=your_algolia_app_id
ALGOLIA_INDEX_NAME=your_index_name

# ============================================
# Authentication & Security
# ============================================
TOTP_SECRET=your_totp_secret_here
SERVER_PRIVATE_KEY=your_server_private_key_here
ENCRYPTION_KEY=your_encryption_key_here

# ============================================
# AWS Configuration (if using S3/SES)
# ============================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your_bucket_name

# ============================================
# Payment Gateways
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_key

# ============================================
# Email/SMS Services
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token

# ============================================
# Feature Flags
# ============================================
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true
SYNC_DB=false
