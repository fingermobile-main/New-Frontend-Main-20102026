# ╔═══════════════════════════════════════════════════════════╗
# ║  FingerMobile Protocol - Production Environment Template  ║
# ╚═══════════════════════════════════════════════════════════╝

# Instructions:
# 1. Copy this file to .env.production
# 2. Replace all placeholder values with actual secrets
# 3. NEVER commit .env.production to version control
# 4. Use strong, unique passwords for each service
# 5. Rotate passwords regularly (every 90 days recommended)

# ───────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# ───────────────────────────────────────────────────────────
# Database Configuration (PostgreSQL)
# ───────────────────────────────────────────────────────────
# Generate strong password: openssl rand -base64 32
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fingermobile_prod
DB_USER=fingermobile_admin
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=20

# ───────────────────────────────────────────────────────────
# Redis Configuration
# ───────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ───────────────────────────────────────────────────────────
# Session Configuration
# ───────────────────────────────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGE_ME_32_CHARACTER_MINIMUM_SECRET

# Session cookie settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict
SESSION_MAX_AGE=86400000

# ───────────────────────────────────────────────────────────
# JWT Configuration
# ───────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET_MINIMUM_32_CHARS
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ───────────────────────────────────────────────────────────
# OAuth2 / Social Login
# ───────────────────────────────────────────────────────────
# Google OAuth2
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://yourdomain.com/auth/google/callback

# Facebook OAuth2
FACEBOOK_APP_ID=CHANGE_ME_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=CHANGE_ME_FACEBOOK_APP_SECRET
FACEBOOK_CALLBACK_URL=https://yourdomain.com/auth/facebook/callback

# Apple OAuth2
APPLE_CLIENT_ID=CHANGE_ME_APPLE_CLIENT_ID
APPLE_TEAM_ID=CHANGE_ME_APPLE_TEAM_ID
APPLE_KEY_ID=CHANGE_ME_APPLE_KEY_ID
APPLE_PRIVATE_KEY=CHANGE_ME_APPLE_PRIVATE_KEY_PATH
APPLE_CALLBACK_URL=https://yourdomain.com/auth/apple/callback

# ───────────────────────────────────────────────────────────
# Payment Processing
# ───────────────────────────────────────────────────────────
# Stripe
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_STRIPE_SECRET_KEY
STRIPE_PUBLIC_KEY=pk_live_CHANGE_ME_STRIPE_PUBLIC_KEY
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME_STRIPE_WEBHOOK_SECRET

# Paystack
PAYSTACK_SECRET_KEY=sk_live_CHANGE_ME_PAYSTACK_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_live_CHANGE_ME_PAYSTACK_PUBLIC_KEY

# ───────────────────────────────────────────────────────────
# Email Configuration (SMTP)
# ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_SMTP_USERNAME
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=noreply@yourdomain.com
SMTP_SECURE=false

# ───────────────────────────────────────────────────────────
# File Storage (S3/MinIO)
# ───────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=CHANGE_ME_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_AWS_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=fingermobile-uploads
AWS_S3_ENDPOINT=  # Leave empty for AWS, set for MinIO

# ───────────────────────────────────────────────────────────
# WebSocket Configuration
# ───────────────────────────────────────────────────────────
ENABLE_WEBSOCKET=true
WS_HEARTBEAT_INTERVAL=30000
WS_CONNECTION_TIMEOUT=5000

# ───────────────────────────────────────────────────────────
# Backup Configuration
# ───────────────────────────────────────────────────────────
ENABLE_AUTO_BACKUP=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# ───────────────────────────────────────────────────────────
# Logging Configuration
# ───────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_FILE_SIZE=20m
LOG_MAX_FILES=30

# ───────────────────────────────────────────────────────────
# Rate Limiting
# ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ───────────────────────────────────────────────────────────
# CORS Configuration
# ───────────────────────────────────────────────────────────
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
CORS_CREDENTIALS=true

# ───────────────────────────────────────────────────────────
# Frontend URLs
# ───────────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
API_URL=https://api.yourdomain.com

# ───────────────────────────────────────────────────────────
# SSL/TLS Certificates
# ───────────────────────────────────────────────────────────
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
SSL_KEY_PATH=/etc/ssl/private/yourdomain.key

# ───────────────────────────────────────────────────────────
# Monitoring & Analytics
# ───────────────────────────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@sentry.io/PROJECT_ID
DATADOG_API_KEY=CHANGE_ME_DATADOG_API_KEY

# ───────────────────────────────────────────────────────────
# Feature Flags
# ───────────────────────────────────────────────────────────
ENABLE_REGISTRATION=true
ENABLE_SOCIAL_LOGIN=true
ENABLE_MARKETPLACE=true
ENABLE_WEBSOCKET_NOTIFICATIONS=true

# ───────────────────────────────────────────────────────────
# Application-Specific Passwords
# ───────────────────────────────────────────────────────────
# Camus Service
CAMUS_DB_PASSWORD=CHANGE_ME_CAMUS_DB_PASSWORD

# SuperVi-Game Service
SUPERVI_GAME_DB_PASSWORD=CHANGE_ME_SUPERVI_DB_PASSWORD

# MyStorefront Service
MYSTOREFRONT_DB_PASSWORD=CHANGE_ME_STOREFRONT_DB_PASSWORD

# LuminaGallery Service
LUMINA_DB_PASSWORD=CHANGE_ME_LUMINA_DB_PASSWORD

# Permanence Service
PERMANENCE_DB_PASSWORD=CHANGE_ME_PERMANENCE_DB_PASSWORD

# ───────────────────────────────────────────────────────────
# Security Headers
# ───────────────────────────────────────────────────────────
CSP_POLICY=default-src 'self'
HSTS_MAX_AGE=31536000
X_FRAME_OPTIONS=DENY

# ───────────────────────────────────────────────────────────
# GDPR Compliance
# ───────────────────────────────────────────────────────────
GDPR_ENABLED=true
DATA_RETENTION_DAYS=365
AUTO_DELETE_INACTIVE_ACCOUNTS=false

# ═══════════════════════════════════════════════════════════
# END OF TEMPLATE
# ═══════════════════════════════════════════════════════════
