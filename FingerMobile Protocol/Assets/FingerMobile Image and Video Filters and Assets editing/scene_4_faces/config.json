            "mask_mrao": {
                "type" : "texture",
                "streamed": false,
                "file_name": "mask_MRAO.png"
            },

            "retouch_lookupTexEyes": {
                "type" : "texture",
                "file_name": "teeth_highlighter5.png",
                "weight": 1.0
            },

            "retouch_lookupTexTeeth": {
                "type" : "texture",
