#!/usr/bin/env node

/**
 * Install Missing Dependencies Script
 * Installs npm dependencies for apps that don't have node_modules
 */

const { execSync } = require('child_process');
const fs = require('fs');
const path = require('path');

const WORKSPACE_ROOT = '/Users/user/Documents/FingerMobile Protocol Communication/FingerMobile Protocol/apps';

// Apps identified as missing node_modules from audit
const APPS_NEEDING_INSTALL = [
  'gems-database',
  'gems-docker',
  'gems-frontend',
  'LuminaGallery',
  'marketplace',
  'monitoring',
  'dancia4tv'
];

console.log('📦 Installing missing dependencies...\n');

let successCount = 0;
let failCount = 0;

APPS_NEEDING_INSTALL.forEach(appName => {
  const appPath = path.join(WORKSPACE_ROOT, appName);
  
  // Check if app directory exists
  if (!fs.existsSync(appPath)) {
    console.log(`⚠️  Skipping ${appName}: Directory not found`);
    return;
  }
  
  // Check if package.json exists
  const packageJsonPath = path.join(appPath, 'package.json');
  if (!fs.existsSync(packageJsonPath)) {
    console.log(`⚠️  Skipping ${appName}: No package.json found`);
    return;
  }
  
  console.log(`Installing dependencies for: ${appName}`);
  
  try {
    // Check if backend subdirectory has package.json
    const backendPath = path.join(appPath, 'backend');
    const backendPackageJson = path.join(backendPath, 'package.json');
    
    if (fs.existsSync(backendPackageJson)) {
      console.log(`  → Installing in backend/...`);
      execSync('npm install', { 
        cwd: backendPath, 
        stdio: 'inherit',
        timeout: 120000 // 2 minute timeout
      });
    } else {
      // Install at root level
      execSync('npm install', { 
        cwd: appPath, 
        stdio: 'inherit',
        timeout: 120000
      });
    }
    
    console.log(`  ✓ Successfully installed dependencies\n`);
    successCount++;
  } catch (error) {
    console.error(`  ✗ Failed to install dependencies: ${error.message}\n`);
    failCount++;
  }
});

console.log('==========================================');
console.log(`✅ Dependency Installation Complete`);
console.log(`   Successful installations: ${successCount}`);
console.log(`   Failed installations: ${failCount}`);
console.log('==========================================\n');

if (failCount > 0) {
  console.log('⚠️  Some installations failed. Check the output above for details.');
} else {
  console.log('💡 All dependencies installed successfully!');
}
