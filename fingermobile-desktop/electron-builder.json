{
  "appId": "com.fingermobile.desktop",
  "productName": "FingerMobile Desktop",
  "copyright": "Copyright © 2023 FingerMobile",
  "directories": {
    "output": "dist-electron"
  },
  "files": [
    "main.js",
    "preload.js",
    "dist/**/*",
    "package.json",
    "node_modules/**/*",
    "../FingerMobile/dist/**/*"
  ],
  "extraResources": [
    {
      "from": "assets/",
      "to": "assets/",
      "filter": ["**/*"]
    }
  ],
  "mac": {
    "category": "public.app-category.social-networking",
    "target": ["dmg", "zip"],
    "icon": "assets/icon.icns"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico",
    "publisherName": "FingerMobile"
  },
  "linux": {
    "target": ["AppImage", "deb", "rpm"],
    "category": "Network;Chat;VideoConference",
    "icon": "assets/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "publish": {
    "provider": "github",
    "owner": "fingermobile",
    "repo": "fingermobile-desktop"
  }
}
