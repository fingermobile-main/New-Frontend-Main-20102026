# Staging Environment Configuration
# Copy this file to .env.staging and update with staging-specific credentials

# Database Configuration - Staging
DB_HOST=staging-db.fingermobile.com
DB_PORT=5432
DB_NAME=fingermobile_staging
DB_USER=fingermobile_staging_user
DB_PASSWORD=CHANGE_ME_STAGING_SECURE_DB_PASSWORD_MIN_32_CHARS
POSTGRES_PASSWORD=CHANGE_ME_STAGING_SECURE_DB_PASSWORD_MIN_32_CHARS
DB_URL=postgresql://fingermobile_staging_user:CHANGE_ME_STAGING_SECURE_DB_PASSWORD_MIN_32_CHARS@staging-db.fingermobile.com:5432/fingermobile_staging

# Gems Backend Database - Staging
GEMS_DB_NAME=gems_staging
GEMS_DB_URL=postgresql://fingermobile_staging_user:CHANGE_ME_STAGING_SECURE_DB_PASSWORD_MIN_32_CHARS@staging-db.fingermobile.com:5432/gems_staging

# OwnIt Database - Staging
OWNIT_DB_NAME=ownit_staging
OWNIT_DB_URL=postgresql://fingermobile_staging_user:CHANGE_ME_STAGING_SECURE_DB_PASSWORD_MIN_32_CHARS@staging-db.fingermobile.com:5432/ownit_staging

# Stercs Database - Staging
STERCS_DB_NAME=stercs_staging
STERCS_DB_USER=stercs_staging_user
STERCS_DB_PASSWORD=CHANGE_ME_STERCSS_STAGING_PASSWORD_MIN_32_CHARS
STERCS_DB_URL=postgresql://stercs_staging_user:CHANGE_ME_STERCSS_STAGING_PASSWORD_MIN_32_CHARS@staging-db.fingermobile.com:5432/stercs_staging

# Redis Configuration - Staging
REDIS_URL=redis://:CHANGE_ME_STAGING_REDIS_PASSWORD_MIN_32_CHARS@staging-redis.fingermobile.com:6379
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD_MIN_32_CHARS

# JWT Configuration - Staging
JWT_SECRET=CHANGE_ME_STAGING_JWT_SECRET_MIN_64_CHARS_FOR_ENHANCED_SECURITY
JWT_EXPIRES_IN=12h

# API Keys and Secrets - Staging
API_KEY_PREFIX=fmp_stg_
API_KEY_LENGTH=32

# AWS Configuration - Staging
AWS_ACCESS_KEY_ID=CHANGE_ME_STAGING_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_STAGING_AWS_SECRET_KEY_MIN_40_CHARS
AWS_REGION=us-east-1
AWS_S3_BUCKET=fingermobile-staging-assets

# Email Configuration - Staging (Use production email service)
EMAIL_SERVICE_API_KEY=CHANGE_ME_STAGING_EMAIL_API_KEY
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_STAGING_SMTP_USER
SMTP_PASS=CHANGE_ME_STAGING_SMTP_PASSWORD

# Social Media APIs - Staging (Use staging app credentials)
GOOGLE_CLIENT_ID=CHANGE_ME_STAGING_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_STAGING_GOOGLE_CLIENT_SECRET
FACEBOOK_APP_ID=CHANGE_ME_STAGING_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=CHANGE_ME_STAGING_FACEBOOK_APP_SECRET

# Payment Gateway - Staging (Use sandbox mode with real credentials)
PAYPAL_CLIENT_ID=CHANGE_ME_STAGING_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=CHANGE_ME_STAGING_PAYPAL_CLIENT_SECRET
STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME_STAGING_STRIPE_KEY
STRIPE_SECRET_KEY=sk_live_CHANGE_ME_STAGING_STRIPE_SECRET_KEY

# Push Notifications - Staging
FCM_SERVER_KEY=CHANGE_ME_STAGING_FCM_SERVER_KEY

# Test Configuration
TEST_DB_URI=mongodb://staging-mongo.fingermobile.com:27017/test_fingermobile
TEST_USER_PASSWORD=CHANGE_ME_STAGING_TEST_PASSWORD

# Staging Settings
NODE_ENV=staging
PORT=5000
FRONTEND_URL=https://staging.fingermobile.com
BACKEND_URL=https://api-staging.fingermobile.com

# Logging - Info level for staging
LOG_LEVEL=info

# Security - Restrict CORS for staging
CORS_ORIGIN=https://staging.fingermobile.com,https://admin-staging.fingermobile.com
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX_REQUESTS=500
