{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": "."
  },
  "include": ["src", "types.ts", "utils", "services", "components", "middleware", "database.ts", "repository.ts", "api.ts", "auth.ts", "http.ts", "requests.ts", "formulas.ts", "policy.ts", "error-handler.ts", "business-suite-service.ts", "business-suite-controller.ts", "business-suite-store.ts", "business-suite.ts", "useBusinessSuite.ts", "kyc-verification-service.ts", "eligibility-service.ts", "guardian-ai-service.ts", "index.ts", "server.ts", "request-context.ts", "database.js", "repository.js", "app.ts"]
}