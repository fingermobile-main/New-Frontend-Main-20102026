# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fingermobile_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
POSTGRES_PASSWORD=your_secure_postgres_password
DB_URL=postgresql://username:password@localhost:5432/database_name

# Gems Backend Database
GEMS_DB_NAME=gems_db
GEMS_DB_URL=postgresql://username:password@localhost:5432/gems_db

# OwnIt Database
OWNIT_DB_NAME=ownit_db
OWNIT_DB_URL=postgresql://username:password@localhost:5432/ownit_db

# Stercs Database
STERCS_DB_NAME=stercs_db
STERCS_DB_USER=stercs_user
STERCS_DB_PASSWORD=stercs_password
STERCS_DB_URL=postgresql://stercs_user:stercs_password@localhost:5432/stercs_db

# Redis Configuration
REDIS_URL=redis://:your_redis_password@localhost:6379
REDIS_PASSWORD=your_redis_password

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_string_min_32_chars
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=your_very_secure_session_secret_min_32_chars

# OAuth2 Configuration (if applicable)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Email Configuration (if applicable)
EMAIL_HOST=smtp.your-email-provider.com
EMAIL_PORT=587
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_email_password

# Cloud Storage Configuration (if applicable)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name

# Payment Gateway Configuration (if applicable)
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# External API Keys (if applicable)
EXTERNAL_API_KEY=your_external_api_key

# Application Settings
NODE_ENV=development # Change to 'production' in production
PORT=5000
FRONTEND_URL=http://localhost:3000

# Security Settings
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_MIN_LENGTH=8
ENABLE_WEBSOCKET=true
ENABLE_AUTO_BACKUP=true