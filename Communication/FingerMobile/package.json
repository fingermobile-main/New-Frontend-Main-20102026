    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.2.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0",
    "sequelize": "^6.32.0",
    "socket.io": "^4.8.3",
    "typescript": "^5.0.0",
    "uuid": "^9.0.0",
