# ==============================================================================
# FingerMobile Protocol - Self-Hosted Plunk & Deliverability Configuration
# ==============================================================================

# Plunk REST API Configuration
PLUNK_PORT=9000
PLUNK_SECRET=fingermobile_protocol_super_secure_plunk_secret_key_2026
PLUNK_API_URL=http://localhost:9000
PLUNK_APP_URL=http://localhost:9000
PLUNK_API_KEY=pk_test_fingermobile_plunk_api_key_2026

# Outbound Sender Details
EMAIL_FROM=notifications@fingermobileprotocol.com
EMAIL_FROM_NAME=FingerMobile Protocol
EMAIL_SUPPORT=support@fingermobileprotocol.com

# PostgreSQL Database for Plunk
POSTGRES_USER=plunk_user
POSTGRES_PASSWORD=plunk_secure_password_2026
POSTGRES_DB=plunk_db

# Redis Cache & Queue
REDIS_PASSWORD=redis_secure_pass_2026

# Stalwart Mail Server (MTA on Port 25)
MAIL_DOMAIN=mail.fingermobileprotocol.com
STATIC_IPV4_ADDRESS=198.51.100.25
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASS=stalwart_admin_secret_2026

# SMTP Relay Configuration (Internal Bridge from Plunk to Stalwart)
SMTP_HOST=stalwart
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@fingermobileprotocol.com
SMTP_PASS=stalwart_smtp_password

# Technical Deliverability DNS Records
DKIM_SELECTOR=s1
DKIM_DOMAIN=fingermobileprotocol.com
DMARC_POLICY=reject
DMARC_RUA_EMAIL=dmarc-reports@fingermobileprotocol.com

# IP Warm-up Configuration
WARMUP_ENABLED=true
WARMUP_CURRENT_WEEK=1
WARMUP_DAILY_LIMIT=20
