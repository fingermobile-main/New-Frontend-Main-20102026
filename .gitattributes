# Global Git configuration for FingerMobile Protocol project

# Set default behavior to automatically normalize line endings
* text=auto

# Force specific file types to use specific line endings
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat all json files as text
*.json text

# Handle image files without modification
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text

# Handle font files without modification
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Handle archive files as binary
*.zip binary
*.tar.gz binary
*.tar binary
*.gz binary
*.rar binary

# Ignore generated files and build artifacts
node_modules/ export-ignore
dist/ export-ignore
build/ export-ignore
.next/ export-ignore
.nuxt/ export-ignore
.env export-ignore
.env.local export-ignore
.env.*.local export-ignore
*.log binary

# Large files that should be managed by Git LFS
*.psd filter=lfs diff=lfs merge=lfs -text
*.ai filter=lfs diff=lfs merge=lfs -text
*.pdf filter=lfs diff=lfs merge=lfs -text
