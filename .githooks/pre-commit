#!/bin/sh
#
# Pre-commit hook for FingerMobile Protocol project
# Ensures code quality and security checks before allowing commits

echo "Running pre-commit checks for FingerMobile Protocol..."

# Function to check for sensitive data in staged files
check_sensitive_data() {
    echo "🔍 Checking for sensitive data..."
    git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(env|json|yaml|yml|xml|txt|js|ts|jsx|tsx)$' | while read file; do
        if [ -f "$file" ]; then
            if grep -E "(password|secret|token|key|api_key|access_token|client_secret|private_key|secret_key)" "$file" > /dev/null; then
                echo "❌ Potential sensitive data found in $file"
                echo "Please remove sensitive information before committing."
                exit 1
            fi
        fi
    done
}

# Function to check for large files
check_large_files() {
    echo "🔍 Checking for large files..."
    git diff --cached --numstat | awk '$1 > 10000 || $2 > 10000 { print $3 }' | while read file; do
        if [ -n "$file" ]; then
            size=$(stat -f%z "$file" 2>/dev/null || stat -c%s "$file" 2>/dev/null)
            if [ "$size" -gt 10485760 ]; then  # 10MB
                echo "❌ Large file detected: $file ($(($size / 1024 / 1024))MB)"
                echo "Please use Git LFS for large files or exclude them from the commit."
                exit 1
            fi
        fi
    done
}

# Function to check for TODO comments in production code
check_todos() {
    echo "🔍 Checking for TODO comments..."
    git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|ts|jsx|tsx|py|java|cpp|c|h)$' | while read file; do
        if [ -f "$file" ]; then
            if grep -n "TODO" "$file" > /dev/null; then
                echo "⚠️  TODO comment found in $file:"
                grep -n "TODO" "$file" | head -5
                echo "Consider addressing TODO comments before committing to production code."
            fi
        fi
    done
}

# Function to run basic linting on staged files
check_linting() {
    echo "🔍 Running basic linting checks..."
    
    # Check JavaScript/TypeScript files
    for file in $(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|ts|jsx|tsx)$'); do
        if [ -f "$file" ] && command -v npx >/dev/null 2>&1; then
            # Basic syntax check
            if ! node -c "$file" 2>/dev/null; then
                echo "❌ Syntax error in $file"
                node -c "$file" 2>&1 | sed "s/^/   /"
                exit 1
            fi
        fi
    done
}

# Function to check commit message format
check_commit_message() {
    echo "🔍 Checking commit message format..."
    # Get the commit message from the file
    COMMIT_MSG_FILE=.git/COMMIT_EDITMSG
    if [ -f "$COMMIT_MSG_FILE" ]; then
        COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")
        
        # Check if message follows conventional commits format
        if ! echo "$COMMIT_MSG" | grep -E "^(feat|fix|docs|style|refactor|test|chore)(\(.+\))?: .+" >/dev/null 2>&1 && 
           ! echo "$COMMIT_MSG" | grep -E "^Merge " >/dev/null 2>&1 &&
           ! echo "$COMMIT_MSG" | grep -E "^Revert " >/dev/null 2>&1; then
            echo "⚠️  Commit message doesn't follow conventional format"
            echo "Expected format: type(scope): description"
            echo "Example: feat(authentication): add login with social providers"
            echo "Types: feat, fix, docs, style, refactor, test, chore"
        fi
        
        # Check message length
        if [ ${#COMMIT_MSG} -gt 72 ]; then
            echo "⚠️  Commit message is too long (${#COMMIT_MSG} > 72 characters)"
        fi
    fi
}

# Run all checks
check_sensitive_data
check_large_files
check_todos
check_linting
check_commit_message

echo "✅ All pre-commit checks passed!"
exit 0