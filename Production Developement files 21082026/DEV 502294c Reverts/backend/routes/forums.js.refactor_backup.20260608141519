    const {
      limit = 20,
      offset = 0,
      sort_by = "created_at",
      order = "ASC"
    } = req.query;

    const { rows } = await socialDb.query(
      `SELECT fp.*, m.membername as author_name, m.avatar_url as author_avatar
       FROM forum_posts fp
       JOIN members m ON fp.author_id = m.id
       WHERE fp.thread_id = $1
       ORDER BY fp.${sort_by} ${order}
