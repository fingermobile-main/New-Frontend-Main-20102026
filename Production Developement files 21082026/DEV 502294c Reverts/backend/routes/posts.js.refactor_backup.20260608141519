const express = require("express");
const postsController = require('../controllers/postsController.js');
const { contentDb } = require("../db");
const { authenticate } = require("../middleware/authenticate");
const router = express.Router();

// Get all posts with filtering, sorting and pagination
router.get("/", authenticate, async (req, res) => {
  try {
    const { page = 1, limit = 20, category, author_id, sort = "newest" } = req.query;
    
    // Validate page and limit parameters
    const pageNum = parseInt(page) || 1;
    const limitNum = parseInt(limit) || 20;
    const offset = (pageNum - 1) * limitNum;
    
    // Base query with author name and engagement counts
    let query = `
      SELECT p.*, 
             m.membername as author_name,
             COALESCE(pl.like_count, 0) as likes_count,
             COALESCE(pc.comment_count, 0) as comments_count
      FROM posts p
      JOIN members m ON p.member_id = m.id
      LEFT JOIN (
        SELECT post_id, COUNT(*) as like_count 
        FROM post_likes 
        GROUP BY post_id
      ) pl ON p.id = pl.post_id
      LEFT JOIN (
        SELECT post_id, COUNT(*) as comment_count 
        FROM post_comments 
        GROUP BY post_id
      ) pc ON p.id = pc.post_id
      WHERE 1=1
    `;
    
    const params = [];
    
    // Add filters
    if (author_id) {
      params.push(author_id);
      query += ` AND p.member_id = $${params.length}`;
    }
    
    if (category) {
      params.push(category);
      query += ` AND p.category = $${params.length}`;
    }
    
    // Add sorting
    if (sort === "popular") {
      query += ` ORDER BY likes_count DESC, p.created_at DESC`;
    } else if (sort === "oldest") {
      query += ` ORDER BY p.created_at ASC`;
    } else {
      // newest
      query += ` ORDER BY p.created_at DESC`;
    }
    
    // Add pagination
    params.push(limitNum);
    params.push(offset);
    query += ` LIMIT $${params.length - 1} OFFSET $${params.length}`;
    
    // Execute main query
    const { rows: posts } = await contentDb.query(query, params);
    
    // Get total count for pagination
    const countQuery = `
      SELECT COUNT(*) as total 
      FROM posts p
      WHERE 1=1
      ${author_id ? ` AND p.member_id = $1` : ''}
      ${category ? ` AND p.category = ${author_id ? '$2' : '$1'}` : ''}
    `;
    
    const countParams = [];
    if (author_id) countParams.push(author_id);
    if (category) countParams.push(category);
    
    const { rows: countResult } = await contentDb.query(countQuery, countParams);
    const total = parseInt(countResult[0]?.total || 0);
    
    res.json({
      success: true,
      data: {
        posts,
        pagination: {
          currentPage: pageNum,
          totalPages: Math.ceil(total / limitNum),
          totalItems: total,
          itemsPerPage: limitNum
        }
      }
    });
  } catch (err) {
    console.error("Get Posts Error:", err);
    res.status(500).json({
      success: false,
      message: "Server error retrieving posts"
    });
  }
});

// Get a specific post by ID
router.get("/:postId", authenticate, async (req, res) => {
  try {
    const { postId } = req.params;
    const userId = req.member?.id; // Current authenticated user

    // Query to get post details with author info and engagement counts
    const { rows } = await contentDb.query(
      `SELECT p.*, 
             m.membername as author_name,
             COALESCE(pl.like_count, 0) as likes_count,
             COALESCE(pc.comment_count, 0) as comments_count,
             COALESCE(ul.user_liked, false) as user_liked
       FROM posts p
       JOIN members m ON p.member_id = m.id
       LEFT JOIN (
         SELECT post_id, COUNT(*) as like_count 
         FROM post_likes 
         GROUP BY post_id
       ) pl ON p.id = pl.post_id
       LEFT JOIN (
         SELECT post_id, COUNT(*) as comment_count 
         FROM post_comments 
         GROUP BY post_id
       ) pc ON p.id = pc.post_id
       LEFT JOIN (
         SELECT post_id, true as user_liked
         FROM post_likes
         WHERE user_id = $2
       ) ul ON p.id = ul.post_id
       WHERE p.id = $1`,
      [postId, userId]
    );

    if (rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: "Post not found"
      });
    }

    res.json({
      success: true,
      data: rows[0]
    });
  } catch (err) {
    console.error("Get Post Error:", err);
    res.status(500).json({
      success: false,
      message: "Server error retrieving post"
    });
  }
});

// Create a new post
router.post("/", authenticate, async (req, res) => {
  try {
    const {
      title,
      content,
      visibility,
      location_point,
      location_address,
      category,
    } = req.body;
    const member_id = req.member.id; // Authenticated user

    // Basic validation
    if (!title || !content) {
      return res.status(400).json({
        success: false,
        message: "Title and content are required"
      });
    }

    // Insert new post
    const { rows } = await contentDb.query(
      `INSERT INTO posts 
       (member_id, title, content, visibility, location_point, location_address, category)
       VALUES ($1, $2, $3, $4, $5, $6, $7)
       RETURNING *`,
      [
        member_id,
        title,
        content,
        visibility || "public",
        location_point,
        location_address,
        category,
      ]
    );

    res.status(201).json({
      success: true,
      message: "Post created successfully",
      data: rows[0]
    });
  } catch (err) {
    console.error("Create Post Error:", err);
    res.status(500).json({
      success: false,
      message: "Server error creating post"
    });
  }
});

// Update a post
router.put("/:postId", authenticate, async (req, res) => {
  try {
    const { postId } = req.params;
    const {
      title,
      content,
      visibility,
      location_point,
      location_address,
      category,
    } = req.body;
    const member_id = req.member.id; // Authenticated user

    // Check if post exists and belongs to the user
    const postResult = await contentDb.query(
      "SELECT id FROM posts WHERE id = $1 AND member_id = $2",
      [postId, member_id]
    );

    if (postResult.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: "Post not found or unauthorized"
      });
    }

    // Build dynamic update query
    const fields = {
      title,
      content,
      visibility,
      location_point,
      location_address,
      category
    };
    
    const updates = [];
    const values = [];
    
    Object.entries(fields).forEach(([key, value]) => {
      if (value !== undefined) {
        updates.push(`${key} = $${updates.length + 1}`);
        values.push(value);
      }
    });
    
    if (updates.length === 0) {
      return res.status(400).json({
        success: false,
        message: "No fields to update"
      });
    }
    
    // Add the post ID for the WHERE clause
    values.push(postId);
    
    const { rows } = await contentDb.query(
      `UPDATE posts 
       SET ${updates.join(', ')}, updated_at = NOW()
       WHERE id = $${values.length}
       RETURNING *`,
      values
    );

    res.json({
      success: true,
      message: "Post updated successfully",
      data: rows[0]
    });
  } catch (err) {
    console.error("Update Post Error:", err);
    res.status(500).json({
      success: false,
      message: "Server error updating post"
    });
  }
});

