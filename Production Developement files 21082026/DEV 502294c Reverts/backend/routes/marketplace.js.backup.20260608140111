    if (quantity <= 0) {
      // Remove item if quantity is 0 or negative
      await identityDb.query(
        "DELETE FROM shopping_cart WHERE member_id = $1 AND product_id = $2",
        [memberId, productId]
      );
      return res.json({ message: "Item removed from cart" });
    }

    await identityDb.query(
      "UPDATE shopping_cart SET quantity = $1, updated_at = CURRENT_TIMESTAMP WHERE member_id = $2 AND product_id = $3",
      [quantity, memberId, productId]
    );

    res.json({ message: "Cart updated", quantity });
  } catch (error) {
    console.error("Error updating cart:", error);
    res.status(500).json({ error: "Failed to update cart" });
  }
});

