// ===== PURCHASE ENDPOINT =====

// Purchase product (authenticated)
router.post("/products/:id/purchase", authenticate, async (req, res) => {
  try {
    const { id } = req.params;
    const { quantity = 1 } = req.body;
    const memberId = req.member.id;

    // Get product details
    const product = await identityDb.query(
      "SELECT * FROM products WHERE id = $1 AND is_active = true",
      [id]
    );

    if (product.rows.length === 0) {
      return res.status(404).json({ error: "Product not found or inactive" });
    }

    const productData = product.rows[0];

    // Check stock
    if (productData.stock_quantity < quantity) {
      return res.status(400).json({ error: "Insufficient stock" });
    }

    // Calculate total
    const total = productData.price * quantity;

    // Create order (simplified - in production use transactions)
    const order = await identityDb.query(
      `INSERT INTO marketplace_orders 
       (member_id, seller_id, total_amount, status, created_at)
       VALUES ($1, $2, $3, 'pending', NOW())
       RETURNING *`,
      [memberId, productData.creator_id, total]
    );

    // Update stock
    await identityDb.query(
      "UPDATE products SET stock_quantity = stock_quantity - $1 WHERE id = $2",
      [quantity, id]
    );

    // Remove from cart if present
    await identityDb.query(
      "DELETE FROM shopping_cart WHERE member_id = $1 AND product_id = $2",
      [memberId, id]
    );

    res.status(201).json({
      message: "Purchase successful",
      order: order.rows[0],
      total,
    });
  } catch (error) {
    console.error("Error processing purchase:", error);
    res.status(500).json({ error: "Failed to process purchase" });
  }
});

