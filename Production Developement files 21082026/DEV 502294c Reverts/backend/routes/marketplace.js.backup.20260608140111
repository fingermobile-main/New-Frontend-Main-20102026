// Get user's shopping cart (authenticated)
router.get("/cart", authenticate, async (req, res) => {
  try {
    const memberId = req.member.id;

    const { rows } = await identityDb.query(
      `SELECT sc.*, p.name, p.price, p.image_url, p.stock_quantity,
              CASE WHEN sc.quantity > p.stock_quantity THEN false ELSE true END as available
       FROM shopping_cart sc
       JOIN products p ON sc.product_id = p.id
       WHERE sc.member_id = $1
       ORDER BY sc.added_at DESC`,
      [memberId]
    );

    const total = rows.reduce((sum, item) => sum + (item.price * item.quantity), 0);

    res.json({ items: rows, total, itemCount: rows.length });
  } catch (error) {
    console.error("Error fetching cart:", error);
    res.status(500).json({ error: "Failed to fetch cart" });
  }
});

// Add item to cart (authenticated)
router.post("/cart", authenticate, async (req, res) => {
  try {
    const { product_id, quantity = 1 } = req.body;
    const memberId = req.member.id;

    // Check if item already in cart
    const existing = await identityDb.query(
      "SELECT * FROM shopping_cart WHERE member_id = $1 AND product_id = $2",
      [memberId, product_id]
    );

    if (existing.rows.length > 0) {
      // Update quantity
      const newQuantity = existing.rows[0].quantity + quantity;
      await identityDb.query(
        "UPDATE shopping_cart SET quantity = $1, updated_at = CURRENT_TIMESTAMP WHERE member_id = $2 AND product_id = $3",
        [newQuantity, memberId, product_id]
      );
      res.json({ message: "Cart updated", quantity: newQuantity });
    } else {
      // Add new item
      await identityDb.query(
        "INSERT INTO shopping_cart (member_id, product_id, quantity) VALUES ($1, $2, $3)",
        [memberId, product_id, quantity]
      );
      res.status(201).json({ message: "Item added to cart", quantity });
    }
  } catch (error) {
    console.error("Error adding to cart:", error);
    res.status(500).json({ error: "Failed to add to cart" });
  }
});

// Update cart item quantity (authenticated)
