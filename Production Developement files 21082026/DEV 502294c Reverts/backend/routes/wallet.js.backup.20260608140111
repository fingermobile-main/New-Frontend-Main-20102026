// Get wallet transactions
router.get("/transactions", authenticate, async (req, res) => {
  try {
    const userId = req.user.id;
    const { page = 1, limit = 10, type } = req.query;

    // Calculate offset for pagination
    const offset = (parseInt(page) - 1) * parseInt(limit);

    // Build WHERE clause for filtering by type if specified
    let whereClause = "WHERE w.user_id = $1";
    const params = [userId];
    let paramIndex = 2;

    if (type) {
      whereClause += ` AND ft.transaction_type = $${paramIndex}`;
      params.push(type);
      paramIndex++;
    }

    // Get wallet transactions with pagination
    const transactionsQuery = `
      SELECT ft.id, ft.amount, ft.transaction_type, ft.description, 
             ft.from_account, ft.to_account, ft.transaction_status, 
             ft.transaction_reference, ft.metadata, ft.created_at
      FROM fic_transactions ft
      JOIN fic_wallets w ON ft.wallet_id = w.id
      ${whereClause}
      ORDER BY ft.created_at DESC
      LIMIT $${paramIndex - 1} OFFSET $${paramIndex}
    `;

    params.push(parseInt(limit));
    params.push(offset);

    const transactionsResult = await monetizationDb.query(transactionsQuery, params);

    // Get total count for pagination
    const countQuery = `
      SELECT COUNT(*) as total 
      FROM fic_transactions ft
      JOIN fic_wallets w ON ft.wallet_id = w.id
      ${whereClause.replace('ORDER BY', '')}
    `;
    const countParams = [userId];
    if (type) countParams.push(type);
    const countResult = await monetizationDb.query(countQuery, countParams);

    res.json({
      success: true,
      message: "Transactions retrieved successfully",
      data: {
        transactions: transactionsResult.rows,
        pagination: {
          currentPage: parseInt(page),
          totalPages: Math.ceil(parseInt(countResult.rows[0].total) / parseInt(limit)),
          totalItems: parseInt(countResult.rows[0].total),
          itemsPerPage: parseInt(limit)
        }
      }
    });
  } catch (error) {
    console.error("Get Transactions Error:", error);
    res.status(500).json({
      success: false,
      message: "Internal server error retrieving transactions"
    });
  }
});

// Deposit funds to wallet
router.post("/deposit", authenticate, async (req, res) => {
  try {
    const userId = req.user.id;
    const { amount, source, reference, description } = req.body;

    // Validation
    if (!amount || amount <= 0) {
      return res.status(400).json({
        success: false,
        message: "Positive amount is required"
      });
    }

    if (isNaN(parseFloat(amount))) {
      return res.status(400).json({
        success: false,
        message: "Amount must be a valid number"
      });
    }

    // Begin transaction to ensure consistency
    const client = await monetizationDb.connect();
    try {
      await client.query('BEGIN');

      // Get user's wallet
      const walletQuery = "SELECT id, balance, currency FROM fic_wallets WHERE user_id = $1 FOR UPDATE";
      const walletResult = await client.query(walletQuery, [userId]);

      if (walletResult.rows.length === 0) {
        return res.status(404).json({
          success: false,
          message: "Wallet not found"
        });
      }

      const wallet = walletResult.rows[0];
      const newBalance = parseFloat(wallet.balance) + parseFloat(amount);

      // Update wallet balance
      const updateWalletQuery = "UPDATE fic_wallets SET balance = $1 WHERE id = $2";
      await client.query(updateWalletQuery, [newBalance, wallet.id]);

      // Generate transaction reference if not provided
      const transactionRef = reference || `deposit_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;

      // Record transaction
      const transactionQuery = `
        INSERT INTO fic_transactions (wallet_id, amount, transaction_type, description, from_account, to_account, transaction_status, transaction_reference, metadata)
        VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
        RETURNING id
      `;
      const transactionResult = await client.query(transactionQuery, [
        wallet.id,
        parseFloat(amount),
        'deposit',
        description || 'Deposit to wallet',
        source || 'external',
        wallet.wallet_address,
        'completed',
        transactionRef,
        JSON.stringify({ source: source, depositType: 'manual' })
      ]);

      await client.query('COMMIT');

      res.json({
        success: true,
        message: "Deposit completed successfully",
        data: {
          transactionId: transactionResult.rows[0].id,
          walletId: wallet.id,
          amount: parseFloat(amount),
          newBalance: newBalance,
          transactionReference: transactionRef
        }
      });
    } catch (txError) {
      await client.query('ROLLBACK');
      throw txError;
    } finally {
      client.release();
    }
  } catch (error) {
    console.error("Deposit Error:", error);
    res.status(500).json({
      success: false,
      message: "Internal server error processing deposit"
    });
  }
});

// Withdraw funds from wallet
router.post("/withdraw", authenticate, async (req, res) => {
  try {
    const userId = req.user.id;
    const { amount, destination, reference, description } = req.body;

    // Validation
    if (!amount || amount <= 0) {
      return res.status(400).json({
        success: false,
        message: "Positive amount is required"
      });
    }

    if (isNaN(parseFloat(amount))) {
      return res.status(400).json({
        success: false,
        message: "Amount must be a valid number"
      });
    }

    // Begin transaction to ensure consistency
    const client = await monetizationDb.connect();
    try {
      await client.query('BEGIN');

      // Get user's wallet
      const walletQuery = "SELECT id, balance, currency, wallet_address FROM fic_wallets WHERE user_id = $1 FOR UPDATE";
      const walletResult = await client.query(walletQuery, [userId]);

      if (walletResult.rows.length === 0) {
        return res.status(404).json({
          success: false,
          message: "Wallet not found"
        });
      }

      const wallet = walletResult.rows[0];
      const withdrawalAmount = parseFloat(amount);

      if (parseFloat(wallet.balance) < withdrawalAmount) {
        return res.status(400).json({
          success: false,
          message: "Insufficient balance"
        });
      }

      const newBalance = parseFloat(wallet.balance) - withdrawalAmount;

      // Update wallet balance
      const updateWalletQuery = "UPDATE fic_wallets SET balance = $1 WHERE id = $2";
      await client.query(updateWalletQuery, [newBalance, wallet.id]);

      // Generate transaction reference if not provided
      const transactionRef = reference || `withdrawal_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;

      // Record transaction
      const transactionQuery = `
        INSERT INTO fic_transactions (wallet_id, amount, transaction_type, description, from_account, to_account, transaction_status, transaction_reference, metadata)
        VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
        RETURNING id
      `;
      const transactionResult = await client.query(transactionQuery, [
        wallet.id,
        -withdrawalAmount, // Negative for withdrawal
        'withdrawal',
        description || 'Withdrawal from wallet',
        wallet.wallet_address,
        destination || 'external',
        'completed',
        transactionRef,
        JSON.stringify({ destination: destination, withdrawalType: 'manual' })
      ]);

      await client.query('COMMIT');

      res.json({
        success: true,
        message: "Withdrawal completed successfully",
        data: {
          transactionId: transactionResult.rows[0].id,
          walletId: wallet.id,
          amount: withdrawalAmount,
          newBalance: newBalance,
          transactionReference: transactionRef
        }
      });
    } catch (txError) {
      await client.query('ROLLBACK');
      throw txError;
    } finally {
      client.release();
    }
  } catch (error) {
    console.error("Withdrawal Error:", error);
    res.status(500).json({
      success: false,
      message: "Internal server error processing withdrawal"
    });
  }
});

// Transfer funds between wallets
router.post("/transfer", authenticate, async (req, res) => {
  try {
    const userId = req.user.id;
    const { toWalletAddress, amount, reference, description } = req.body;

    // Validation
    if (!toWalletAddress || !amount || amount <= 0) {
      return res.status(400).json({
        success: false,
        message: "Destination wallet address and positive amount are required"
      });
    }

    if (isNaN(parseFloat(amount))) {
      return res.status(400).json({
        success: false,
        message: "Amount must be a valid number"
      });
    }

    // Begin transaction to ensure consistency
    const client = await monetizationDb.connect();
    try {
      await client.query('BEGIN');

      // Get sender's wallet
      const senderWalletQuery = "SELECT id, balance, wallet_address FROM fic_wallets WHERE user_id = $1 FOR UPDATE";
      const senderWalletResult = await client.query(senderWalletQuery, [userId]);

      if (senderWalletResult.rows.length === 0) {
        return res.status(404).json({
          success: false,
          message: "Sender wallet not found"
        });
      }

      // Get recipient's wallet
      const recipientWalletQuery = "SELECT id, balance, wallet_address FROM fic_wallets WHERE wallet_address = $1 FOR UPDATE";
      const recipientWalletResult = await client.query(recipientWalletQuery, [toWalletAddress]);

      if (recipientWalletResult.rows.length === 0) {
        return res.status(404).json({
          success: false,
          message: "Recipient wallet not found"
        });
      }

      const senderWallet = senderWalletResult.rows[0];
      const recipientWallet = recipientWalletResult.rows[0];
      const transferAmount = parseFloat(amount);

      if (parseFloat(senderWallet.balance) < transferAmount) {
        return res.status(400).json({
          success: false,
          message: "Insufficient balance"
        });
      }

      if (senderWallet.wallet_address === recipientWallet.wallet_address) {
        return res.status(400).json({
          success: false,
          message: "Cannot transfer to the same wallet"
        });
      }

      // Calculate new balances
      const newSenderBalance = parseFloat(senderWallet.balance) - transferAmount;
      const newRecipientBalance = parseFloat(recipientWallet.balance) + transferAmount;

      // Update sender's wallet balance
      const updateSenderQuery = "UPDATE fic_wallets SET balance = $1 WHERE id = $2";
      await client.query(updateSenderQuery, [newSenderBalance, senderWallet.id]);

      // Update recipient's wallet balance
      const updateRecipientQuery = "UPDATE fic_wallets SET balance = $1 WHERE id = $2";
      await client.query(updateRecipientQuery, [newRecipientBalance, recipientWallet.id]);

      // Generate transaction reference if not provided
      const transactionRef = reference || `transfer_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;

      // Record sender's transaction
      const senderTxQuery = `
        INSERT INTO fic_transactions (wallet_id, amount, transaction_type, description, from_account, to_account, transaction_status, transaction_reference, metadata)
        VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
        RETURNING id
      `;
      const senderTxResult = await client.query(senderTxQuery, [
        senderWallet.id,
        -transferAmount, // Negative for sender
        'transfer_out',
        description || `Transfer to ${toWalletAddress}`,
        senderWallet.wallet_address,
        recipientWallet.wallet_address,
        'completed',
        `${transactionRef}_out`,
        JSON.stringify({ toWallet: toWalletAddress, transferType: 'internal' })
      ]);

      // Record recipient's transaction
      const recipientTxQuery = `
        INSERT INTO fic_transactions (wallet_id, amount, transaction_type, description, from_account, to_account, transaction_status, transaction_reference, metadata)
        VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9)
        RETURNING id
      `;
      const recipientTxResult = await client.query(recipientTxQuery, [
        recipientWallet.id,
        transferAmount, // Positive for recipient
        'transfer_in',
        description || `Transfer from ${senderWallet.wallet_address}`,
        senderWallet.wallet_address,
        recipientWallet.wallet_address,
        'completed',
        `${transactionRef}_in`,
        JSON.stringify({ fromWallet: senderWallet.wallet_address, transferType: 'internal' })
      ]);

      await client.query('COMMIT');

      res.json({
        success: true,
        message: "Transfer completed successfully",
        data: {
          senderTransactionId: senderTxResult.rows[0].id,
          recipientTransactionId: recipientTxResult.rows[0].id,
          fromWallet: senderWallet.wallet_address,
          toWallet: recipientWallet.wallet_address,
          amount: transferAmount,
          senderNewBalance: newSenderBalance,
          recipientNewBalance: newRecipientBalance,
          transactionReference: transactionRef
        }
      });
    } catch (txError) {
      await client.query('ROLLBACK');
      throw txError;
    } finally {
      client.release();
    }
  } catch (error) {
    console.error("Transfer Error:", error);
    res.status(500).json({
      success: false,
      message: "Internal server error processing transfer"
    });
  }
});

