// Create wallet tables if they don't exist
async function ensureWalletTablesExist() {
  try {
    // Create fic_wallets table if it doesn't exist
    await monetizationDb.query(`
      CREATE TABLE IF NOT EXISTS fic_wallets (
        id SERIAL PRIMARY KEY,
        user_id INTEGER REFERENCES users(id) ON DELETE CASCADE,
        wallet_address VARCHAR(255) UNIQUE NOT NULL,
        balance DECIMAL(15, 2) DEFAULT 0.00,
        currency VARCHAR(10) DEFAULT 'FIC',
        is_active BOOLEAN DEFAULT TRUE,
        created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP,
        updated_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
      );
    `);

    // Create fic_transactions table if it doesn't exist
    await monetizationDb.query(`
      CREATE TABLE IF NOT EXISTS fic_transactions (
        id SERIAL PRIMARY KEY,
        wallet_id INTEGER REFERENCES fic_wallets(id) ON DELETE CASCADE,
        amount DECIMAL(15, 2) NOT NULL,
        transaction_type VARCHAR(50) NOT NULL,
        description TEXT,
        from_account VARCHAR(255),
        to_account VARCHAR(255),
        transaction_status VARCHAR(50) DEFAULT 'completed',
        transaction_reference VARCHAR(255) UNIQUE,
        metadata JSONB,
        created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
      );
    `);

    // Create fic_exchange_rates table if it doesn't exist
    await monetizationDb.query(`
      CREATE TABLE IF NOT EXISTS fic_exchange_rates (
        id SERIAL PRIMARY KEY,
        base_currency VARCHAR(10) DEFAULT 'FIC',
        target_currency VARCHAR(10) NOT NULL,
        rate DECIMAL(15, 6) NOT NULL,
        source VARCHAR(50),
        last_updated TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
      );
    `);

    // Create indexes for performance
    await monetizationDb.query(`
      CREATE INDEX IF NOT EXISTS idx_fic_wallets_user_id ON fic_wallets(user_id);
      CREATE INDEX IF NOT EXISTS idx_fic_wallets_address ON fic_wallets(wallet_address);
      CREATE INDEX IF NOT EXISTS idx_fic_transactions_wallet_id ON fic_transactions(wallet_id);
      CREATE INDEX IF NOT EXISTS idx_fic_transactions_reference ON fic_transactions(transaction_reference);
      CREATE INDEX IF NOT EXISTS idx_fic_exchange_rates_pair ON fic_exchange_rates(base_currency, target_currency);
    `);

    // Create trigger to update timestamps
    await monetizationDb.query(`
      CREATE OR REPLACE FUNCTION update_wallet_timestamp()
      RETURNS TRIGGER AS $$
      BEGIN
          NEW.updated_at = CURRENT_TIMESTAMP;
          RETURN NEW;
      END;
      $$ language 'plpgsql';

      DROP TRIGGER IF EXISTS update_fic_wallets_timestamp ON fic_wallets;
      CREATE TRIGGER update_fic_wallets_timestamp 
          BEFORE UPDATE ON fic_wallets 
          FOR EACH ROW 
          EXECUTE FUNCTION update_wallet_timestamp();
    `);

    // Add some default exchange rates if none exist
    const countResult = await monetizationDb.query("SELECT COUNT(*) as count FROM fic_exchange_rates");
    if (parseInt(countResult.rows[0].count) === 0) {
      await monetizationDb.query(`
        INSERT INTO fic_exchange_rates (base_currency, target_currency, rate, source)
        VALUES 
          ('FIC', 'USD', 0.0025, 'estimated'),
          ('FIC', 'EUR', 0.0023, 'estimated'),
          ('FIC', 'NGN', 1.80, 'estimated'),
          ('FIC', 'BTC', 0.000000025, 'estimated'),
          ('FIC', 'ETH', 0.000045, 'estimated')
      `);
    }
  } catch (error) {
    console.error("Error ensuring wallet tables exist:", error);
    throw error;
  }
}

// Initialize wallet tables when module loads
ensureWalletTablesExist().catch(console.error);

module.exports = router;