// Update reading progress
router.put("/reading-list-items/:itemId", async (req, res) => {
  try {
    const { itemId } = req.params;
    const { progress, notes } = req.body;

    if (!progress || !['unread', 'reading', 'completed'].includes(progress)) {
      return res.status(400).json({ error: "Valid progress status required" });
    }

    const updates = { progress };
    if (progress === 'completed') {
      updates.completed_at = new Date().toISOString();
    }
    if (notes !== undefined) {
      updates.notes = notes;
    }

    const fields = Object.keys(updates).map((key, idx) => `${key} = $${idx + 1}`).join(', ');
    const values = Object.values(updates);

    const { rows } = await contentDb.query(
      `UPDATE blog_reading_list_items SET ${fields}, updated_at = NOW()
       WHERE id = $${values.length + 1}
       RETURNING *`,
      [...values, itemId]
    );

    if (rows.length === 0) {
      return res.status(404).json({ error: "Item not found" });
    }

    res.json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

