// Get comments for a post (threaded)
router.get("/posts/:postId/comments", async (req, res) => {
  try {
    const { postId } = req.params;
    const { status = 'approved' } = req.query;

    // Get top-level comments first
    const topLevelResult = await contentDb.query(
      `SELECT bc.*, m.username as author_name, m.profile_picture_url as author_avatar
       FROM blog_comments bc
       LEFT JOIN members m ON bc.author_id::text = m.id::text
       WHERE bc.post_id = $1 AND bc.parent_id IS NULL AND bc.status = $2
       ORDER BY bc.created_at DESC`,
      [postId, status]
    );

    // For each top-level comment, get replies
    const comments = topLevelResult.rows;
    for (const comment of comments) {
      const repliesResult = await contentDb.query(
        `SELECT bc.*, m.username as author_name, m.profile_picture_url as author_avatar
         FROM blog_comments bc
         LEFT JOIN members m ON bc.author_id::text = m.id::text
         WHERE bc.parent_id = $1 AND bc.status = $2
         ORDER BY bc.created_at ASC`,
        [comment.id, status]
      );
      comment.replies = repliesResult.rows;
    }

    res.json(comments);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Create a comment
router.post("/comments", async (req, res) => {
  try {
    const { post_id, parent_id, content } = req.body;
    const author_id = req.member?.id;

    if (!author_id) {
      return res.status(401).json({ error: "Authentication required" });
    }

    if (!post_id || !content) {
      return res.status(400).json({ error: "Post ID and content are required" });
    }

    const { rows } = await contentDb.query(
      `INSERT INTO blog_comments (post_id, author_id, parent_id, content, ip_address, user_agent)
       VALUES ($1, $2, $3, $4, $5, $6)
       RETURNING *`,
      [post_id, author_id, parent_id || null, content, req.ip, req.get('User-Agent')]
    );

    // If this is a reply, increment parent's replies_count
    if (parent_id) {
      await contentDb.query(
        "UPDATE blog_comments SET replies_count = replies_count + 1 WHERE id = $1",
        [parent_id]
      );
    }

    res.status(201).json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

