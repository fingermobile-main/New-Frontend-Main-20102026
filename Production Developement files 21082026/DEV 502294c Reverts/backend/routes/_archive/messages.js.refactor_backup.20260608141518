const express = require("express");
const messagesController = require('../controllers/messagesController.js');
const router = express.Router();
const communicationDb = require("../db");

// Get member's conversations
router.get("/conversations", async (req, res) => {
  try {
    const member_id = req.member.id; // Assuming member is authenticated

    // Get all conversations where the member is a participant
    const { rows } = await communicationDb.query(
      `SELECT DISTINCT 
                CASE 
                    WHEN m1.id = $1 THEN m2.id 
                    ELSE m1.id 
                END as other_member_id,
                CASE 
                    WHEN m1.id = $1 THEN m2.membername 
                    ELSE m1.membername 
                END as other_member_name,
                CASE 
                    WHEN m1.id = $1 THEN m2.profile_picture_url 
                    ELSE m1.profile_picture_url 
                END as other_member_avatar,
                (SELECT COUNT(*) FROM messages ms 
                 WHERE (ms.sender_id = $1 OR ms.recipient_id = $1) 
                 AND ((ms.sender_id = m1.id AND ms.recipient_id = m2.id) 
                      OR (ms.sender_id = m2.id AND ms.recipient_id = m1.id))
                 AND ms.is_read = false AND ms.recipient_id = $1) as unread_count,
                (SELECT ms.content FROM messages ms 
                 WHERE ((ms.sender_id = m1.id AND ms.recipient_id = m2.id) 
                        OR (ms.sender_id = m2.id AND ms.recipient_id = m1.id))
                 ORDER BY ms.created_at DESC LIMIT 1) as last_message,
                (SELECT ms.created_at FROM messages ms 
                 WHERE ((ms.sender_id = m1.id AND ms.recipient_id = m2.id) 
                        OR (ms.sender_id = m2.id AND ms.recipient_id = m1.id))
                 ORDER BY ms.created_at DESC LIMIT 1) as last_message_at
             FROM messages m
             JOIN members m1 ON (m.sender_id = m1.id OR m.recipient_id = m1.id)
             JOIN members m2 ON (m.sender_id = m2.id OR m.recipient_id = m2.id)
             WHERE m.sender_id = $1 OR m.recipient_id = $1
             ORDER BY last_message_at DESC`,
      [member_id],
    );

    res.json(rows);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Get messages with a specific member
router.get("/conversations/:otherMemberId", async (req, res) => {
  try {
    const member_id = req.member.id; // Assuming member is authenticated
    const otherMemberId = req.params.otherMemberId;
    const { limit = 50, offset = 0 } = req.query;

    // Check if other member exists
    const otherMemberResult = await communicationDb.query(
      "SELECT id FROM members WHERE id = $1",
      [otherMemberId],
    );

    if (otherMemberResult.rows.length === 0) {
      return res.status(404).json({ error: "Other member not found" });
    }

    // Get messages between the two members
    const { rows } = await communicationDb.query(
      `SELECT m.*, 
                    sender.membername as sender_name, 
                    sender.profile_picture_url as sender_avatar,
                    recipient.membername as recipient_name,
                    recipient.profile_picture_url as recipient_avatar
             FROM messages m
             JOIN members sender ON m.sender_id = sender.id
             JOIN members recipient ON m.recipient_id = recipient.id
             WHERE (m.sender_id = $1 AND m.recipient_id = $2) 
                OR (m.sender_id = $2 AND m.recipient_id = $1)
             ORDER BY m.created_at DESC
             LIMIT $3 OFFSET $4`,
      [member_id, otherMemberId, parseInt(limit), parseInt(offset)],
    );

    // Mark messages as read if the current member is the recipient
    await communicationDb.query(
      `UPDATE messages 
             SET is_read = true, read_at = NOW()
             WHERE sender_id = $1 AND recipient_id = $2 AND is_read = false`,
      [otherMemberId, member_id],
    );

    res.json(rows.reverse()); // Reverse to show oldest first like a typical chat
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Send a new message
router.post("/", async (req, res) => {
  try {
    const sender_id = req.member.id; // Assuming member is authenticated
    const { recipient_id, content, message_type = "text" } = req.body;

    // Validate inputs
    if (!recipient_id || !content) {
      return res
        .status(400)
        .json({ error: "Recipient ID and content are required" });
    }

    // Check if recipient exists
    const recipientResult = await communicationDb.query(
      "SELECT id FROM members WHERE id = $1",
      [recipient_id],
    );

    if (recipientResult.rows.length === 0) {
      return res.status(404).json({ error: "Recipient not found" });
    }

    // Check if sender and recipient are the same
    if (sender_id == recipient_id) {
      return res.status(400).json({ error: "Cannot send message to yourself" });
    }

    // Create the message
    const { rows } = await communicationDb.query(
      `INSERT INTO messages 
             (sender_id, recipient_id, content, message_type)
             VALUES ($1, $2, $3, $4)
             RETURNING *`,
      [sender_id, recipient_id, content, message_type],
    );

    res.status(201).json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Get a specific message
router.get("/:messageId", async (req, res) => {
  try {
    const member_id = req.member.id; // Assuming member is authenticated
    const messageId = req.params.messageId;

    const { rows } = await communicationDb.query(
      `SELECT m.*, 
                    sender.membername as sender_name, 
                    sender.profile_picture_url as sender_avatar,
                    recipient.membername as recipient_name,
                    recipient.profile_picture_url as recipient_avatar
             FROM messages m
             JOIN members sender ON m.sender_id = sender.id
             JOIN members recipient ON m.recipient_id = recipient.id
             WHERE m.id = $1 
                AND (m.sender_id = $2 OR m.recipient_id = $2)`,
      [messageId, member_id],
    );

    if (rows.length === 0) {
      return res.status(404).json({ error: "Message not found" });
    }

    // Mark message as read if the current member is the recipient
    if (rows[0].recipient_id == member_id && !rows[0].is_read) {
      await communicationDb.query(
        `UPDATE messages 
                 SET is_read = true, read_at = NOW()
                 WHERE id = $1`,
        [messageId],
      );
    }

    res.json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Update a message (for editing)
router.put("/:messageId", async (req, res) => {
  try {
    const member_id = req.member.id; // Assuming member is authenticated
    const messageId = req.params.messageId;
    const { content } = req.body;

    // Check if message exists and belongs to the member
    const messageResult = await communicationDb.query(
      "SELECT * FROM messages WHERE id = $1 AND sender_id = $2",
      [messageId, member_id],
    );

    if (messageResult.rows.length === 0) {
      return res
        .status(404)
        .json({ error: "Message not found or unauthorized" });
    }

    // Check if message is too old to edit (e.g., older than 1 hour)
    const message = messageResult.rows[0];
    const messageTime = new Date(message.created_at);
    const now = new Date();
    const timeDiff = (now - messageTime) / (1000 * 60); // difference in minutes

    if (timeDiff > 60) {
      // 1 hour limit
      return res
        .status(400)
        .json({ error: "Cannot edit message older than 1 hour" });
    }

    // Update the message
    const { rows } = await communicationDb.query(
      `UPDATE messages 
             SET content = $1, updated_at = NOW(), is_edited = true
             WHERE id = $2
             RETURNING *`,
      [content, messageId],
    );

    res.json(rows[0]);
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Delete a message
router.delete("/:messageId", async (req, res) => {
  try {
    const member_id = req.member.id; // Assuming member is authenticated
    const messageId = req.params.messageId;

    // Check if message exists and belongs to the member
    const messageResult = await communicationDb.query(
      "SELECT * FROM messages WHERE id = $1 AND sender_id = $2",
      [messageId, member_id],
    );

    if (messageResult.rows.length === 0) {
      return res
        .status(404)
        .json({ error: "Message not found or unauthorized" });
    }

    // In a real implementation, you might want to soft delete
    // For now, we'll hard delete the message
    await communicationDb.query("DELETE FROM messages WHERE id = $1", [
      messageId,
    ]);

    res.json({ message: "Message deleted successfully" });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Mark messages as read
router.post("/mark-as-read", async (req, res) => {
  try {
    const member_id = req.member.id; // Assuming member is authenticated
    const { conversation_partner_id } = req.body;

    // Update all messages from the conversation partner that are addressed to the current member
    await communicationDb.query(
      `UPDATE messages 
             SET is_read = true, read_at = NOW()
             WHERE sender_id = $1 AND recipient_id = $2 AND is_read = false`,
      [conversation_partner_id, member_id],
    );

    res.json({ message: "Messages marked as read" });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

// Get unread message count
router.get("/unread-count", async (req, res) => {
  try {
    const member_id = req.member.id; // Assuming member is authenticated

    const { rows } = await communicationDb.query(
      `SELECT COUNT(*) as count
             FROM messages
             WHERE recipient_id = $1 AND is_read = false`,
      [member_id],
    );

    res.json({ unread_count: parseInt(rows[0].count) });
  } catch (err) {
    console.error(err);
    res.status(500).json({ error: "Server error" });
  }
});

module.exports = router;
