const express = require("express");
const { identityDb } = require("../db");
const { authenticate } = require("../middleware/authenticate");
const router = express.Router();

// Get all members (admin only)
router.get("/", authenticate, async (req, res) => {
  try {
    // In a real implementation, you would check if member is admin
    const membersResult = await identityDb.query(
      "SELECT id, membername, email, first_name, last_name, profile_picture_url, bio, created_at FROM members ORDER BY created_at DESC LIMIT 100",
    );

    res.status(200).json({
      success: true,
      members: membersResult.rows,
    });
  } catch (_error) {
    console.error(_error);
    res.status(500).json({
      success: false,
      message: "Server error",
    });
  }
});

// Get specific member
router.get("/:memberId", authenticate, async (req, res) => {
  try {
    const { memberId } = req.params;

    const memberResult = await identityDb.query(
      "SELECT id, membername, email, first_name, last_name, profile_picture_url, bio, created_at FROM members WHERE id = $1",
      [memberId],
    );

    if (memberResult.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: "Member not found",
      });
    }

    res.status(200).json({
      success: true,
      member: memberResult.rows[0],
    });
  } catch (_error) {
    console.error(_error);
    res.status(500).json({
      success: false,
      message: "Server error",
    });
  }
});

// Update member profile
router.put("/:memberId", authenticate, async (req, res) => {
  try {
    const { memberId } = req.params;
    const { first_name, last_name, bio, profile_picture_url } = req.body;

    // Check if member is authorized to update this profile
    if (req.member.id !== parseInt(memberId)) {
      return res.status(403).json({
        success: false,
        message: "Access denied",
      });
    }

    const updatedMember = await identityDb.query(
      `UPDATE members
       SET first_name = $1, last_name = $2, bio = $3, profile_picture_url = $4, updated_at = NOW()
       WHERE id = $5
       RETURNING id, membername, email, first_name, last_name, profile_picture_url, bio, created_at`,
      [first_name, last_name, bio, profile_picture_url, memberId],
    );

    if (updatedMember.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: "Member not found",
      });
    }

    res.status(200).json({
      success: true,
      message: "Profile updated successfully",
      member: updatedMember.rows[0],
    });
  } catch (_error) {
    console.error(_error);
    res.status(500).json({
      success: false,
      message: "Server error",
    });
  }
});

