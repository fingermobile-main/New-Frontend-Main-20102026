// Follow a member
router.post("/:memberId/follow", authenticate, async (req, res) => {
  try {
    const { memberId } = req.params;
    const followerId = req.member.id;

    // Check if already following
    const followCheck = await identityDb.query(
      "SELECT * FROM follows WHERE follower_id = $1 AND followed_id = $2",
      [followerId, memberId],
    );

    if (followCheck.rows.length > 0) {
      return res.status(400).json({
        success: false,
        message: "Already following this member",
      });
    }

    // Create follow relationship
    await identityDb.query(
      "INSERT INTO follows (follower_id, followed_id) VALUES ($1, $2)",
      [followerId, memberId],
    );

    res.status(200).json({
      success: true,
      message: "Successfully followed member",
    });
  } catch (_error) {
    console.error(_error);
    res.status(500).json({
      success: false,
      message: "Server error",
    });
  }
});

// Unfollow a member
router.post("/:memberId/unfollow", authenticate, async (req, res) => {
  try {
    const { memberId } = req.params;
    const followerId = req.member.id;

    // Check if following
    const followCheck = await identityDb.query(
      "SELECT * FROM follows WHERE follower_id = $1 AND followed_id = $2",
      [followerId, memberId],
    );

    if (followCheck.rows.length === 0) {
      return res.status(400).json({
        success: false,
        message: "Not following this member",
      });
    }

    // Remove follow relationship
    await identityDb.query(
      "DELETE FROM follows WHERE follower_id = $1 AND followed_id = $2",
      [followerId, memberId],
    );

    res.status(200).json({
      success: true,
      message: "Successfully unfollowed member",
    });
  } catch (_error) {
    console.error(_error);
    res.status(500).json({
      success: false,
      message: "Server error",
    });
  }
});

// Get current member's profile
router.get("/profile", authenticate, async (req, res) => {
  try {
    const memberId = req.member.id;

    // Join with member_profiles to get full data
    const profileResult = await identityDb.query(
      `SELECT m.id, m.membername, m.email, m.first_name, m.last_name, m.profile_picture_url, m.bio,
              mp.display_name, mp.location, mp.website_url, mp.birth_date, mp.gender,
              mp.occupation, mp.education, mp.interests, mp.skills, mp.social_links
       FROM members m
       LEFT JOIN member_profiles mp ON m.id = mp.member_id
       WHERE m.id = $1`,
      [memberId],
    );

    if (profileResult.rows.length === 0) {
      return res.status(404).json({
        success: false,
        message: "Profile not found",
      });
    }

    res.status(200).json({
      success: true,
      profile: profileResult.rows[0],
    });
  } catch (_error) {
    console.error(_error);
    res.status(500).json({
      success: false,
      message: "Server error",
    });
  }
});

