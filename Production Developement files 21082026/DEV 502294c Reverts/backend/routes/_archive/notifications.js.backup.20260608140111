// @route   PUT /api/notifications/:memberId/read-all
// @desc    Mark all notifications as read
// @access  Private
router.put("/:memberId/read-all", authenticate, async (req, res) => {
  try {
    const { memberId } = req.params;

    // Verify member identity
    if (req.member.id !== memberId) {
      return res.status(403).json({
        success: false,
        message: "Forbidden",
      });
    }

    await communicationDb.query(
      `UPDATE member_notifications 
       SET is_read = true,
           read_at = NOW(),
           updated_at = NOW()
       WHERE member_id = $1 AND is_read = false`,
      [memberId],
    );

    res.json({
      success: true,
      message: "All notifications marked as read",
    });
  } catch (err) {
    console.error("Error marking all notifications as read:", err);
    res.status(500).json({
      success: false,
      message: "Server error",
    });
  }
});

