// backend/routes/comments.js
// Comments system API endpoints

const express = require('express');
const { authenticate } = require('../middleware/authenticate'); // Correct file
const router = express.Router();

// Mock data store (in production, this would be a database)
let comments = [];

// GET /api/comments - Retrieve comments for a specific post
router.get('/', authenticate, (req, res) => {
  const { postId, limit = 20, offset = 0 } = req.query;
  
  try {
    let filteredComments = comments;
    
    if (postId) {
      filteredComments = filteredComments.filter(comment => comment.postId === postId);
    }
    
    // Sort by creation date (newest first)
    filteredComments.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
    
    const paginatedComments = filteredComments.slice(parseInt(offset), parseInt(offset) + parseInt(limit));
    
    res.json({
      success: true,
      data: paginatedComments,
      pagination: {
        total: filteredComments.length,
        limit: parseInt(limit),
        offset: parseInt(offset)
      }
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: 'Error retrieving comments',
      error: error.message
    });
  }
});

// GET /api/comments/:id - Retrieve a specific comment
router.get('/:id', authenticate, (req, res) => {
  const { id } = req.params;
  
  try {
    const comment = comments.find(c => c.id === id);
    
    if (!comment) {
      return res.status(404).json({
        success: false,
        message: 'Comment not found'
      });
    }
    
    res.json({
      success: true,
      data: comment
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: 'Error retrieving comment',
      error: error.message
    });
  }
});

// POST /api/comments - Create a new comment
router.post('/', authenticate, (req, res) => {
  const { postId, content, parentId } = req.body;
  const userId = req.user?.id || req.member?.id; // Use member from JWT token
  
  // Validate required fields
  if (!postId || !content || content.trim().length === 0) {
    return res.status(400).json({
      success: false,
      message: 'Post ID and comment content are required'
    });
  }
  
  try {
    const newComment = {
      id: Date.now().toString(), // In production, use UUID
      postId,
      userId,
      content: content.trim(),
      parentId: parentId || null, // For nested replies
      likes: 0,
      replies: 0,
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString()
    };
    
    comments.push(newComment);
    
    res.status(201).json({
      success: true,
      message: 'Comment created successfully',
      data: newComment
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: 'Error creating comment',
      error: error.message
    });
  }
});

// PUT /api/comments/:id - Update a comment
router.put('/:id', authenticate, (req, res) => {
  const { id } = req.params;
  const { content } = req.body;
  const userId = req.user?.id || req.member?.id; // Use member from JWT token
  
  if (!content || content.trim().length === 0) {
    return res.status(400).json({
      success: false,
      message: 'Comment content is required'
    });
  }
  
  try {
    const commentIndex = comments.findIndex(c => c.id === id);
    
    if (commentIndex === -1) {
      return res.status(404).json({
        success: false,
        message: 'Comment not found'
      });
    }
    
    // Check if the user owns this comment
    if (comments[commentIndex].userId !== userId) {
      return res.status(403).json({
        success: false,
        message: 'Not authorized to update this comment'
      });
    }
    
    comments[commentIndex] = {
      ...comments[commentIndex],
      content: content.trim(),
      updatedAt: new Date().toISOString()
    };
    
    res.json({
      success: true,
      message: 'Comment updated successfully',
      data: comments[commentIndex]
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: 'Error updating comment',
      error: error.message
    });
  }
});

// DELETE /api/comments/:id - Delete a comment
router.delete('/:id', authenticate, (req, res) => {
  const { id } = req.params;
  const userId = req.user?.id || req.member?.id; // Use member from JWT token
  
  try {
    const commentIndex = comments.findIndex(c => c.id === id);
    
    if (commentIndex === -1) {
      return res.status(404).json({
        success: false,
        message: 'Comment not found'
      });
    }
    
    // Check if the user owns this comment or is an admin
    if (comments[commentIndex].userId !== userId && !req.member?.role === 'admin') {
      return res.status(403).json({
        success: false,
        message: 'Not authorized to delete this comment'
      });
    }
    
    // Remove the comment and all its replies
    comments = comments.filter(c => c.id !== id && c.parentId !== id);
    
    res.json({
      success: true,
      message: 'Comment deleted successfully'
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: 'Error deleting comment',
      error: error.message
    });
  }
});

// POST /api/comments/:id/like - Like/unlike a comment
router.post('/:id/like', authenticate, (req, res) => {
  const { id } = req.params;
  const userId = req.user?.id || req.member?.id; // Use member from JWT token
  
  try {
    const comment = comments.find(c => c.id === id);
    
    if (!comment) {
      return res.status(404).json({
        success: false,
        message: 'Comment not found'
      });
    }
    
    // In a real app, you'd store likes in a separate collection/table
    // and check if the user already liked this comment
    comment.likes = (comment.likes || 0) + 1;
    
    res.json({
      success: true,
      message: 'Comment liked',
      data: { likes: comment.likes }
    });
  } catch (error) {
    res.status(500).json({
      success: false,
      message: 'Error liking comment',
      error: error.message
    });
  }
});

module.exports = router;