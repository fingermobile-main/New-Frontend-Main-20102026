# Server Configuration
NODE_ENV=staging
PORT=3000
HOST=0.0.0.0
WS_PORT=3001

# Database Configuration (PostgreSQL)
DB_USER=fingermobile_staging
DB_PASSWORD=Staging_DB_Pass_2026_Secure!@#$%
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fingermobile_staging
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_ACQUIRE_TIMEOUT=30000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Staging_Redis_Pass_2026_Secure!@#$%
REDIS_DB=0
REDIS_SESSION_TTL=86400

# JWT & Authentication
JWT_SECRET=Staging_JWT_Secret_Key_2026_Must_Be_At_Least_32_Characters_Long_For_Security_Purposes
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# AWS/S3 Configuration (Using placeholder values for staging)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=fingermobile-staging
AWS_CLOUDFRONT_DOMAIN=staging-cdn.fingermobile.com

# Email Configuration (SendGrid - using test key)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.test_key_for_staging_environment_only
EMAIL_FROM=noreply@staging.fingermobile.com

# Payment Gateway Configuration (Test keys)
PAYSTACK_SECRET_KEY=sk_test_staging_paystack_key_2026
PAYSTACK_PUBLIC_KEY=pk_test_staging_paystack_key_2026
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_staging_flutterwave_key_2026

# AI Services (OpenAI - using test key format)
OPENAI_API_KEY=sk-proj-test_openai_key_for_staging_2026
AI_RATE_LIMIT_PER_MINUTE=60
AI_CREDIT_COST_CHAT=1
AI_CREDIT_COST_IMAGE=10

# Security Configuration
CORS_ORIGINS=https://staging.fingermobile.com,http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
HELMET_ENABLED=true
CSRF_PROTECTION=true

# Monitoring & Logging
SENTRY_DSN=https://test@sentry.io/123456
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_METRICS=true

# Grafana Admin
GRAFANA_ADMIN_PASSWORD=Staging_Grafana_Admin_2026!

# Feature Flags
ENABLE_2FA=true
ENABLE_BIOMETRIC=true
ENABLE_AI_FEATURES=true
ENABLE_PAYMENTS=true
ENABLE_WEBSOCKET=true
ENABLE_MONITORING=true

# CDN & Cache
CDN_URL=https://staging-cdn.fingermobile.com
CACHE_TTL=3600
ENABLE_GZIP=true
