// Security configuration for the FingerMobile platform

module.exports = {
  // Two-factor authentication configuration,
twoFactorAuth: {totp: {
      // Time-based One-Time Password settings,
  window: 2, // Allow some time drift,
  step: 30, // Time step in seconds,
  digits: 6, // Number of digits in token,
  algorithm: "SHA1", // Hash algorithm
    },
sms: {
      // SMS-based authentication settings
enabled: true,
provider: "twilio", // Or other SMS provider
messageTemplate: "Your FingerMobile verification code is: {code}"
    },
backupCodes: {
      // Backup codes for 2FA recovery,
count: 10,
length: 8,
encrypted: true
    }
  },

  // Multi-factor authentication configuration,
multiFactorAuth: {maxFactors: 3, // Maximum number of factors allowed,
  requiredFactors: 2, // Number of factors required for high-risk operations,
  factorTypes: ["totp", "sms", "biometric"], // Supported factor types,
  timeout: 300, // Timeout in seconds for MFA session
  },

  // Biometric authentication configuration,
biometric: {supportedTypes: ["face_id", "fingerprint"],
  encryption: {
      // Security settings for biometric data,
  enabled: true,
  algorithm: "AES-256-GCM", // More secure encryption for biometric data,
  keyRotation: 90, // Rotate keys every 90 days
    },
timeout: 300, // 5 minutes timeout for biometric sessions,
maxRetries: 3, // Max retry attempts for biometric verification,
lockoutDuration: 900, // 15 minutes lockout after max retries
  },

  // Additional security configurations,
totp: {
    // TOTP-specific settings,
encryption: {enabled: true,
  algorithm: "AES-256-GCM",
  keyRotation: 180, // Rotate keys every 180 days
    },
backup: {enabled: true,
  codesCount: 10,
  encryptedStorage: true
    }
  },

  // Security headers configuration
securityHeaders: {hsts: {
  maxAge: 31536000, // 1 year
  includeSubDomains: true,
  preload: true
    },
csp: {directives: {
  defaultSrc: ["'self'"],
  scriptSrc: ["'self'", "'unsafe-inline'"],
  styleSrc: ["'self'", "'unsafe-inline'", "https://fonts.googleapis.com"],
  fontSrc: ["'self'", "https://fonts.gstatic.com"],

  imgSrc: ["'self'", "data:", "https:"],
  connectSrc: ["'self'", "https://api.example.com"]
      }
    },
xssProtection: true,
contentTypeOptions: true,
frameOptions: "DENY",
referrerPolicy: "strict-origin-when-cross-origin"
  },

  // Rate limiting configuration
rateLimiting: {login: {
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 5, // Limit each IP to 5 login requests per windowMs
  message: "Too many login attempts, please try again later."
    },
register: {windowMs: 60 * 60 * 1000, // 1 hour
  max: 3, // Limit each IP to 3 registration requests per windowMs
  message: "Too many registration attempts, please try again later."
    },
passwordReset: {windowMs: 15 * 60 * 1000, // 15 minutes
  max: 3, // Limit each IP to 3 password reset requests per windowMs
  message: "Too many password reset attempts, please try again later."

  },

  // Security event logging configuration
securityEvents: {logFailedAttempts: true,
  logSuspiciousActivity: true,
  logDataAccess: true,
  retentionPeriod: 90, // Days to retain security logs
  alertThresholds: {
  failedLogin: 5, // Alert after 5 failed login attempts
  suspiciousIP: 10, // Alert after 10 suspicious activities from same IP
  dataExport: 1 // Alert on any data export request
    }
  },

  // Encryption configuration
encryption: {
    // Data encryption settings
algorithm: "AES-256-GCM",
keyLength: 32, // 32 bytes = 256 bits
keyRotation: 90, // days
    // For the 32-bit key implementation mentioned in security document
    // This is for specific security features, not general encryption
key32Bit: {enabled: true,
  rotation: 30, // days
  purpose: "metadata protection and sealed sender implementation"
    }
  },

  // Session security
session: {secret:
      process.env.SESSION_SECRET ||
      "a_very_secret_session_key_of_32_chars_!!!!",
  cookie: {
  secure: process.env.NODE_ENV === "production", // Use secure cookies in production
  httpOnly: true, // Prevent XSS attacks
  maxAge: 24 * 60 * 60 * 1000, // 24 hours
  sameSite: "strict" // Prevent CSRF
    },
resave: false,
saveUninitialized: false,
maxAge: 24 * 60 * 60 * 1000, // 24 hours
rolling: true // Reset maxAge on each request
  },

  // Password security
password: {minLength: 12,
  requireUppercase: true,
  requireLowercase: true,
  requireNumbers: true,
  requireSymbols: true,
  maxAge: 90, // Days before password must be changed
  history: 5, // Number of previous passwords to remember
  complexity: "high" // Use high complexity requirements
  },

  // Account security
account: {lockoutThreshold: 5, // Failed attempts before lockout
  lockoutDuration: 900, // 15 minutes lockout
  passwordResetRequired: true, // Require password reset after lockout
  notifyOnSuspiciousActivity: true
  },

  // Disappearing messages configuration
disappearingMessages: {enabled: true,
  defaultLifetime: 24 * 60 * 60 * 1000, // 24 hours in milliseconds
  maxLifetime: 7 * 24 * 60 * 60 * 1000, // 7 days maximum
  autoDeletion: true,
  deletionCron: "0 0 * * *" // Run daily at midnight
  },

  // Sealed sender implementation (metadata protection)
sealedSender: {enabled: true,
  implementation: "double ratchet algorithm",
  metadataProtection: {
  enabled: true,
  implementation: "signal protocol based"
    }
  },

  // Registration lock (PIN) implementation
registrationLock: {enabled: true,
  pinLength: 6,
  attemptsAllowed: 3,
  lockoutDuration: 900, // 15 minutes
  recoveryMechanism: "backup codes"
  }
};
