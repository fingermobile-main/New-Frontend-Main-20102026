/**
 * Integrations Module Controller
 * Complete implementation for integrations module management
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class IntegrationsModuleController {
    /**
     * GET /api/integrations-module/modules
     * Get available integration modules
     */
    async getModules(req, res) {
        try {
            const result = await pool.query(
                `SELECT * FROM integration_modules
         WHERE is_available = true
         ORDER BY category, name ASC`
            );

            res.json({
                success: true, data: result.rows.map(module => ({
                    ...module, configSchema: typeof module.config_schema === 'string' ? JSON.parse(module.config_schema) : module.config_schema
                })), count: result.rows.length
            });
        } catch (error) {
            logger.error('Error in IntegrationsModuleController.getModules:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to get modules',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * POST /api/integrations-module/install
     * Install an integration module
     */
    async installModule(req, res) {
        try {
            const userId = req.user?.id;
            const { moduleId, config } = req.body;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            if (!moduleId) {
                return res.status(400).json({
                    success: false,
                    message: 'Module ID is required'
                });
            }

            // Check if already installed
            const existing = await pool.query(
                'SELECT id FROM user_integrations WHERE user_id = $1 AND module_id = $2', [userId, moduleId]
            );

            if (existing.rows.length > 0) {
                return res.status(400).json({
                    success: false,
                    message: 'Module already installed'
                });
            }

            await pool.query(
                `INSERT INTO user_integrations (user_id, module_id, config, status, installed_at)
         VALUES ($1, $2, $3, 'active', NOW())`, [userId, moduleId, JSON.stringify(config || {})]
            );

            res.status(201).json({
                success: true,
                message: 'Module installed successfully'
            });
        } catch (error) {
            logger.error('Error in IntegrationsModuleController.installModule:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to install module',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * DELETE /api/integrations-module/:id/uninstall
     * Uninstall an integration module
     */
    async uninstallModule(req, res) {
        try {
            const userId = req.user?.id;
            const { id : integrationId } = req.params;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            const result = await pool.query(
                'DELETE FROM user_integrations WHERE id = $1 AND user_id = $2 RETURNING id', [integrationId, userId]
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Integration not found'
                });
            }

            res.json({
                success: true,
                message: 'Module uninstalled successfully'
            });
        } catch (error) {
            logger.error('Error in IntegrationsModuleController.uninstallModule:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to uninstall module',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/integrations-module/my-integrations
     * Get user's installed integrations
     */
    async getMyIntegrations(req, res) {
        try {
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            const result = await pool.query(
                `SELECT 
          ui.*,
          im.name as module_name,
          im.description as module_description
          im.category as module_category
         FROM user_integrations ui
         JOIN integration_modules im ON ui.module_id = im.id
         WHERE ui.user_id = $1
         ORDER BY ui.installed_at DESC`,
                [userId]
            );

            res.json({
                success: true, data: result.rows.map(integration => ({
                    ...integration, config: typeof integration.config === 'string' ? JSON.parse(integration.config) : integration.config
                })), count: result.rows.length
            });
        } catch (error) {
            logger.error('Error in IntegrationsModuleController.getMyIntegrations:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to get integrations',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * PUT /api/integrations-module/:id/configure
     * Configure an integration module
     */
    async configureModule(req, res) {
        try {
            const userId = req.user?.id;
            const { id : integrationId } = req.params;
            const { config } = req.body;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            if (!config) {
                return res.status(400).json({
                    success: false,
                    message: 'Configuration is required'
                });
            }

            const result = await pool.query(
                `UPDATE user_integrations 
         SET config = $1, updated_at = NOW()
         WHERE id = $2 AND user_id = $3
         RETURNING *` [JSON.stringify(config), integrationId, userId]
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Integration not found'
                });
            }

            res.json({
                success: true,
                message: 'Module configured successfully',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in IntegrationsModuleController.configureModule:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to configure module',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }
}

module.exports = new IntegrationsModuleController();