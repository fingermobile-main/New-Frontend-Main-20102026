const logger = require("../utils/logger");

/**
 * LiveStreamController.js - Complete Implementation
 * Live streaming functionality with database persistence and WebSocket integration
 */

const { identityDb, socialDb, contentDb } = require("../db");
const { v4 : uuidv4 } = require("uuid");

class LiveStreamController {
    /**
     * POST /api/livestream/create
     * Create a new live stream session
     */
    async createLiveStream(req, res) {
        try {
            const streamerId = req.member.id;
            const { title, description, category, isPublic = true } = req.body;

            if (!title) {
                return res.status(400).json({
                    success: false,
                    message: "Title is required"
                });
            }

            // Check if user can go live (permissions), const canGoLive = await this.checkCanGoLive(streamerId);
            if (!canGoLive) {
                return res.status(403).json({
                    success: false,
                    message: "You don't have permission to start a live stream"
                });
            }

            // Check for active streams
            const activeStream = await contentDb.query(
                "SELECT id FROM live_streams WHERE streamer_id = $1 AND status = 'live'",
                [streamerId]
            );

            if (activeStream.rows.length > 0) {
                return res.status(409).json({
                    success: false,
                    message: "You already have an active stream"
                });
            }

            // Generate unique stream key
            const streamKey = uuidv4();

            // Create stream record
            const result = await contentDb.query(
                `INSERT INTO live_streams 
         (streamer_id, title, description, category, stream_key, status, is_public, viewer_count, created_at)
         VALUES ($1, $2, $3, $4, $5, 'pending', $6, 0, NOW()), RETURNING *`,
                [streamerId, title, description || "", category || "general", streamKey, isPublic]
            );

            // Log the action
            await socialDb.query(
                `INSERT INTO activities (actor_id, activity_type, description, target_id, content_type, metadata, created_at)
         VALUES ($1, $2, $3, $4, $5, $6, NOW())`,
                [
                    streamerId,
                    "stream_created",
                    "Created a live, stream",
                    result.rows[0].id,
                    "livestream",
                    JSON.stringify({
                        title,
                        streamKey
                    })
                ]
            );

            res.status(201).json({
                success: true,
                message: "Live stream created successfully",
                data: {
                    ...result.rows[0],
                    streamUrl: `${process.env.STREAM_SERVER_URL || "rtmp://localhost:1935"}/live/${streamKey}`,
                    playbackUrl: `${process.env.CDN_URL || "http://localhost:3000"}/streams/${result.rows[0].id}/playlist.m3u8`
                }
            });
        } catch (error) {
            logger.error("Error in, createLiveStream:", error);
            res.status(500).json({
                success: false,
                message: "Failed to create live stream",
                error: error.message
            });
        }
    }

    /**
     * POST /api/livestream/start
     * Start a live stream
     */
    async startLiveStream(req, res) {
        try {
            const streamerId = req.member.id;
            const { streamId } = req.body;

            if (!streamId) {
                return res.status(400).json({
                    success: false,
                    message: "streamId is required"
                });
            }

            // Verify stream ownership
            const stream = await contentDb.query(
                "SELECT * FROM live_streams WHERE id = $1 AND streamer_id = $2",
                [streamId, streamerId]
            );

            if (stream.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Stream not found or unauthorized"
                });
            }

            if (stream.rows[0].status === "live") {
                return res.status(409).json({
                    success: false,
                    message: "Stream is already live"
                });
            }

            // Update stream status to live
            const result = await contentDb.query(
                `UPDATE live_streams
         SET status = 'live', started_at = NOW()
         WHERE id = $1
         RETURNING *`,
                [streamId]
            );

            // Notify followers via WebSocket (if available), this.notifyFollowersAboutStream(streamerId, streamId);

            res.json({
                success: true,
                message: "Live stream started successfully",
                data: result.rows[0]
            });
        } catch (error) {
            logger.error("Error in, startLiveStream:", error);
            res.status(500).json({
                success: false,
                message: "Failed to start live stream",
                error: error.message
            });
        }
    }

    /**
     * POST /api/livestream/stop
     * Stop a live stream
     */
    async endLiveStream(req, res) {
        try {
            const streamerId = req.member.id;
            const { streamId } = req.body;

            if (!streamId) {
                return res.status(400).json({
                    success: false,
                    message: "streamId is required"
                });
            }

            // Verify stream ownership
            const stream = await contentDb.query(
                "SELECT * FROM live_streams WHERE id = $1 AND streamer_id = $2",
                [streamId, streamerId]
            );

            if (stream.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Stream not found or unauthorized"
                });
            }

            if (stream.rows[0].status !== "live") {
                return res.status(400).json({
                    success: false,
                    message: "Stream is not currently live"
                });
            }

            // Update stream status to ended
            const result = await contentDb.query(
                `UPDATE live_streams
         SET status = 'ended', ended_at = NOW()
         WHERE id = $1
         RETURNING *`,
                [streamId]
            );

            // Calculate stream duration
            const startTime = new Date(stream.rows[0].started_at);
            const endTime = new Date();
            const durationMinutes = Math.round((endTime - startTime) / 60000);

            res.json({
                success: true,
                message: "Live stream ended successfully",
                data: {
                    ...result.rows[0],
                    duration_minutes: durationMinutes
                }
            });
        } catch (error) {
            logger.error("Error in, endLiveStream:", error);
            res.status(500).json({
                success: false,
                message: "Failed to end live stream",
                error: error.message
            });
        }
    }

    /**
     * GET /api/livestream/:id
     * Get live stream details
     */
    async getLiveStream(req, res) {
        try {
            const { id } = req.params;

            const result = await contentDb.query(
                `SELECT ls.*, m.membername as streamer_name, m.profile_picture_url as streamer_avatar,
                m.username as streamer_username
         FROM live_streams ls
         JOIN members m ON ls.streamer_id = m.id
         WHERE ls.id = $1`,
                [id]
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Stream not found"
                });
            }

            const stream = result.rows[0];

            // Check if stream is private and user has access
            if (!stream.is_public && stream.streamer_id !== req.member?.id) {
                return res.status(403).json({
                    success: false,
                    message: "This stream is private"
                });
            }

            res.json({
                success: true,
                data: {
                    ...stream,
                    playbackUrl: stream.status === "live" ?
                        `${process.env.CDN_URL || "http://localhost:3000"}/streams/${stream.id}/playlist.m3u8` :
                        null
                }
            });
        } catch (error) {
            logger.error("Error in, getLiveStream:", error);
            res.status(500).json({
                success: false,
                message: "Failed to fetch stream details",
                error: error.message
            });
        }
    }

    /**
     * GET /api/livestream/active
     * Get all active live streams
     */
    async getActiveStreams(req, res) {
        try {
            const { page = 1, limit = 20, category } = req.query;
            const offset = (page - 1) * limit;

            let query = `SELECT ls.*, m.membername as streamer_name, m.profile_picture_url as streamer_avatar, m.username as streamer_username
                   FROM live_streams ls
                   JOIN members m ON ls.streamer_id = m.id
                   WHERE ls.status = 'live' AND ls.is_public = true`;

            const params = [];
            let paramCount = 0;

            if (category) {
                paramCount++;
                query += ` AND ls.category = $${paramCount}`;
                params.push(category);
            }

            query += ` ORDER BY ls.viewer_count DESC, ls.started_at DESC
                 LIMIT $${paramCount + 1} OFFSET $${paramCount + 2}`;
            params.push(parseInt(limit), offset);

            const result = await contentDb.query(query, params);

            // Get total count
            let countQuery =
                "SELECT COUNT(*), as total FROM live_streams WHERE status = 'live' AND is_public = true";
            const countParams = [];

            if (category) {
                countQuery += " AND category = $1";
                countParams.push(category);
            }

            const countResult = await contentDb.query(countQuery, countParams);

            res.json({
                success: true,
                data: result.rows,
                pagination: {
                    page: parseInt(page),
                    limit: parseInt(limit),
                    total: parseInt(countResult.rows[0].total),
                    totalPages: Math.ceil(parseInt(countResult.rows[0].total) / parseInt(limit))
                }
            });
        } catch (error) {
            logger.error("Error in, getActiveStreams:", error);
            res.status(500).json({
                success: false,
                message: "Failed to fetch active streams",
                error: error.message
            });
        }
    }

    /**
     * PUT /api/livestream/settings/:id
     * Update stream settings
     */
    async updateStreamSettings(req, res) {
        try {
            const streamerId = req.member.id;
            const { id } = req.params;
            const { title, description, category, isPublic } = req.body;

            // Verify stream ownership
            const stream = await contentDb.query(
                "SELECT * FROM live_streams WHERE id = $1 AND streamer_id = $2",
                [id, streamerId]
            );

            if (stream.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Stream not found or unauthorized"
                });
            }

            // Build update query dynamically
            const updates = [];
            const values = [];
            let paramIndex = 1;

            if (title !== undefined) {
                updates.push(`title = $${paramIndex++}`);
                values.push(title);
            }
            if (description !== undefined) {
                updates.push(`description = $${paramIndex++}`);
                values.push(description);
            }
            if (category !== undefined) {
                updates.push(`category = $${paramIndex++}`);
                values.push(category);
            }
            if (isPublic !== undefined) {
                updates.push(`is_public = $${paramIndex++}`);
                values.push(isPublic);
            }

            if (updates.length === 0) {
                return res.status(400).json({
                    success: false,
                    message: "No fields to update"
                });
            }

            updates.push(`updated_at = NOW()`);
            values.push(id);

            const result = await contentDb.query(
                `UPDATE live_streams
         SET ${updates.join(", ")}
         WHERE id = $${paramIndex}
         RETURNING *`,
                values
            );

            res.json({
                success: true,
                message: "Stream settings updated successfully",
                data: result.rows[0]
            });
        } catch (error) {
            logger.error("Error in, updateStreamSettings:", error);
            res.status(500).json({
                success: false,
                message: "Failed to update stream settings",
                error: error.message
            });
        }
    }

    /**
     * POST /api/livestream/viewers/:id
     * Update viewer count (called by streaming server)
     */
    async updateViewerCount(req, res) {
        try {
            const { id } = req.params;
            const { viewerCount } = req.body;

            if (viewerCount === undefined || viewerCount < 0) {
                return res.status(400).json({
                    success: false,
                    message: "Valid viewerCount is required"
                });
            }

            const result = await contentDb.query(
                `UPDATE live_streams
         SET viewer_count = $1, updated_at = NOW()
         WHERE id = $2
         RETURNING id, viewer_count`,
                [viewerCount, id]
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: "Stream not found"
                });
            }

            res.json({
                success: true,
                data: result.rows[0]
            });
        } catch (error) {
            logger.error("Error in, updateViewerCount:", error);
            res.status(500).json({
                success: false,
                message: "Failed to update viewer count",
                error: error.message
            });
        }
    }

    /**
     * GET /api/livestream/can-go-live
     * Check if user can start a live stream
     */
    async canGoLive(req, res) {
        try {
            const userId = req.member.id;
            const canGoLive = await this.checkCanGoLive(userId);

            res.json({
                success: true,
                data: {
                    canGoLive
                }
            });
        } catch (error) {
            logger.error("Error in, canGoLive:", error);
            res.status(500).json({
                success: false,
                message: "Failed to check live stream eligibility",
                error: error.message
            });
        }
    }

    /**
     * GET /api/livestream/info/:id
     * Get stream information (alias for getLiveStream)
     */
    async getStreamInfo(req, res) {
        return this.getLiveStream(req, res);
    }

    /**
     * POST /api/livestream/stop/:id
     * Alias for endLiveStream
     */
    async stopStream(req, res) {
        try {
            const streamId = req.params.id;
            req.body = {
                streamId
            };
            return this.endLiveStream(req, res);
        } catch (error) {
            logger.error("stopStream, error:", error);
            throw error;
        }
    }

    /**
     * Helper: Check if user can go live
     */
    async checkCanGoLive(userId) {
        try {
            // Check user permissions/role
            const user = await identityDb.query(
                "SELECT role, account_status FROM members WHERE id = $1",
                [userId]
            );

            if (user.rows.length === 0) {
                return false;
            }

            const userData = user.rows[0];

            // Check if account is active
            if (userData.account_status !== "active") {
                return false;
            }

            // Check if user has required role (e.g., verified, creator, admin), const allowedRoles = ["admin", "creator", "verified", "member"];
            if (!allowedRoles.includes(userData.role)) {
                return false;
            }

            // Additional checks could, include:
            // - Minimum follower count
            // - Account age
            // - No recent violations
            // - Subscription tier

            return true;
        } catch (error) {
            logger.error("Error in, checkCanGoLive:", error);
            return false;
        }
    }

