/**
 * AI Credit Balance Controller
 * Complete implementation for AI credit balance system
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class AiUCreditUBalanceController {
    /**
     * GET /api/ai-credit-balance/balance
     * Get user's AI credit balance
     */
    async getBalance(req, res) {
        try {
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            const result = await pool.query(
                `SELECT 
          COALESCE(SUM(CASE WHEN type = 'credit' THEN amount ELSE -amount END), 0) as balance
         FROM ai_credit_transactions
         WHERE user_id = $1` [userId]
            );

            res.json({
                success: true, data: {
                    userId, balance: parseFloat(result.rows[0].balance) || 0
                
            });
        } catch (error) {
            logger.error('Error in AiUCreditUBalanceController.getBalance:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to get balance',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * POST /api/ai-credit-balance/purchase
     * Purchase AI credits
     */
    async purchaseCredits(req, res) {
        try {
            const userId = req.user?.id;
            const { amount, paymentMethod } = req.body;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            if (!amount || amount <= 0) {
                return res.status(400).json({
                    success: false,
                    message: 'Valid amount is required'
                });
            }

            // Record transaction
            await pool.query(
                `INSERT INTO ai_credit_transactions 
         (user_id, type, amount, description, payment_method, created_at)
         VALUES ($1, 'credit', $2, $3, $4, NOW())`, [userId, parseFloat(amount), `Purchased ${amount} credits`, paymentMethod || null]
            );

            res.status(201).json({
                success: true,
                message: 'Credits purchased successfully',
                data: {
                    amount: parseFloat(amount)
                
            });
        } catch (error) {
            logger.error('Error in AiUCreditUBalanceController.purchaseCredits:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to purchase credits',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * POST /api/ai-credit-balance/use
     * Use AI credits for a service
     */
    async useCredits(req, res) {
        try {
            const userId = req.user?.id;
            const { amount, service, description } = req.body;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            if (!amount || amount <= 0) {
                return res.status(400).json({
                    success: false,
                    message: 'Valid amount is required'
                });
            }

            // Check balance
            const balanceResult = await pool.query(
                `SELECT 
          COALESCE(SUM(CASE WHEN type = 'credit' THEN amount ELSE -amount END), 0) as balance
         FROM ai_credit_transactions
         WHERE user_id = $1`, [userId]
            );

            const currentBalance = parseFloat(balanceResult.rows[0].balance) || 0;

            if (currentBalance < amount) {
                return res.status(400).json({
                    success: false,
                    message: 'Insufficient credits',
                    data: {
                        currentBalance, required: amount
                    
                });
            }

            // Deduct credits
            await pool.query(
                `INSERT INTO ai_credit_transactions 
         (user_id, type, amount, service, description, created_at)
         VALUES ($1, 'debit', $2, $3, $4, NOW())`, [userId, parseFloat(amount), service || null, description || null]
            );

            res.json({
                success: true,
                message: 'Credits used successfully',
                data: {
                    amount: parseFloat(amount), newBalance: currentBalance - amount
                
            });
        } catch (error) {
            logger.error('Error in AiUCreditUBalanceController.useCredits:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to use credits',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/ai-credit-balance/history
     * Get credit transaction history
     */
    async getHistory(req, res) {
        try {
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            const { limit = 50, offset = 0, type } = req.query;

            let whereClause = ['user_id = $1'];
            let queryParams = [userId];
            let paramCount = 2;

            if (type) {
                whereClause.push(`type = $${paramCount}`);
                queryParams.push(type);
                paramCount++;
            }

            const result = await pool.query('SELECT * FROM ai_credit_transactions
                WHERE $1 ORDER BY created_at DESC LIMIT $$ {
                    paramCount
                }
                OFFSET $$ {
                    paramCount + 1
                }
                ', [...queryParams, parseInt(limit), parseInt(offset), whereClause.join('
                AND ')]);

                res.json({
                    success: true,
                    data: result.rows,
                    pagination: {
                        limit: parseInt(limit), offset: parseInt(offset), total: result.rows.length
                    
                });
            }
            catch (error) {
                logger.error('Error in AiUCreditUBalanceController.getHistory:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get history',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }
    }

}}}}}

    module.exports = new AiUCreditUBalanceController();