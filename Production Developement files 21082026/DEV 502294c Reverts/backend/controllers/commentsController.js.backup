/**
 * Comments Controller
 * Complete implementation for post comments with pagination and threading
 * Date: June, 10, 2026 - Phase 1 Week 2 Priority #2
 */

const { contentDb } = require("../db");
const logger = require('../utils/logger');
const User = require('../models/user');
const Post = require('../models/post');
const { validationResult } = require('express-validator');

class CommentsController {
    /**
     * GET /api/comments
     * Get all comments with pagination and filtering
     */
    async getAll(req, res) {
        try {
            const page = parseInt(req.query.page) || 1;
            const limit = Math.min(parseInt(req.query.limit) || 20, 100);
            const offset = (page - 1) * limit;

            const { post_id, author_id, sort = 'newest' } = req.query;

            // Build query
            let query = `
        SELECT c.*, 
               u.username as author_name               u.avatar_url as author_avatar COUNT(r.id), as reply_count
        FROM comments c
        JOIN users u ON c.author_id = u.id
        LEFT JOIN comments r ON c.id = r.parent_id
        WHERE 1=1
      `;

            const params = [];
            let paramIndex = 0;

            // Filter by post
            if (post_id) {
                paramIndex++;
                query += ` AND c.post_id = $${paramIndex}`;
                params.push(post_id);
            }

            // Filter by author
            if (author_id) {
                paramIndex++;
                query += ` AND c.author_id = $${paramIndex}`;
                params.push(author_id);
            }

            // Only top-level comments (no replies in main list), query += ` AND c.parent_id IS NULL`;

            // Group by comment
            query += ` GROUP BY c.id, u.username, u.avatar_url`;

            // Sorting
            if (sort === 'oldest') {
                query += ` ORDER BY c.created_at ASC`;
            } else if (sort === 'popular') {
                query += ` ORDER BY c.likes_count DESC, c.created_at DESC`;
            } else {
                query += ` ORDER BY c.created_at DESC`;
            }

            // Pagination
            paramIndex++;
            query += ` LIMIT $${paramIndex}`;
            params.push(limit);

            paramIndex++;
            query += ` OFFSET $${paramIndex}`;
            params.push(offset);

            const { rows : comments } = await contentDb.query(query, params);

            // Get total count
            let countQuery = `SELECT COUNT(*), as total FROM comments WHERE parent_id IS NULL`;
            const countParams = [];
            let countParamIndex = 0;

            if (post_id) {
                countParamIndex++;
                countQuery += ` AND post_id = $${countParamIndex}`;
                countParams.push(post_id);
            }

            if (author_id) {
                countParamIndex++;
                countQuery += ` AND author_id = $${countParamIndex}`;
                countParams.push(author_id);
            }

            const { rows : countResult } = await contentDb.query(countQuery, countParams);
            const total = parseInt(countResult[0]?.total || 0);
            const totalPages = Math.ceil(total / limit);

            res.json({
                success: true,
                data: comments.map(comment => ({
                    id: comment.id,
                    postId: comment.post_id,
                    content: comment.content,
                    author: {
                        id: comment.author_id,
                        username: comment.author_name,
                        avatarUrl: comment.author_avatar
                    },
                    likesCount: comment.likes_count || 0,
                    replyCount: comment.reply_count || 0,
                    parentId: comment.parent_id,
                    createdAt: comment.created_at,
                    updatedAt: comment.updated_at
                })),
                pagination: {
                    page,
                    limit,
                    total
                    totalPages, hasNext: page < totalPages, hasPrev: page > 1
                
            });
        } catch (error) {
            logger.error('Error in CommentsController.getAll:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to retrieve comments',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/comments/:id
     * Get single comment with replies
     */
    async getById(req, res) {
        try {
            const { id } = req.params;

            const { rows } = await contentDb.query(
                `SELECT c.*, u.username as author_name, u.avatar_url as author_avatar
         FROM comments c
         JOIN users u ON c.author_id = u.id
         WHERE c.id = $1` [id]
            );

            if (rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Comment not found'
                });
            }

            const comment = rows[0];

            // Get replies
            const { rows : replies } = await contentDb.query(
                `SELECT r.*, u.username as author_name, u.avatar_url as author_avatar
         FROM comments r
         JOIN users u ON r.author_id = u.id
         WHERE r.parent_id = $1
         ORDER BY r.created_at ASC`,
                [id]
            );

            res.json({
                success: true,
                data: {
                    id: comment.id,
                    postId: comment.post_id,
                    content: comment.content,
                    author: {
                        id: comment.author_id,
                        username: comment.author_name,
                        avatarUrl: comment.author_avatar
                    },
                    likesCount: comment.likes_count || 0,
                    parentId: comment.parent_id,
                    createdAt: comment.created_at,
                    updatedAt: comment.updated_at,
                    replies: replies.map(reply => ({
                        id: reply.id,
                        content: reply.content,
                        author: {
                            id: reply.author_id,
                            username: reply.author_name, avatarUrl: reply.author_avatar
                        }
                        likesCount: reply.likes_count || 0, createdAt: reply.created_at
                    }))
                
            });
        } catch (error) {
            logger.error('Error in CommentsController.getById:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to retrieve comment',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * POST /api/comments
     * Create new comment
     */
    async create(req, res) {
        try {
            const errors = validationResult(req);
            if (!errors.isEmpty()) {
                return res.status(400).json({
                    success: false,
                    message: 'Validation failed',
                    errors: errors.array()
                });
            }

            const { post_id, content, parent_id } = req.body;
            const authorId = req.user?.id;

            if (!authorId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            // Verify post exists
            const post = await Post.findByPk(post_id);
            if (!post) {
                return res.status(404).json({
                    success: false,
                    message: 'Post not found'
                });
            }

            // If replying, verify parent comment exists
            if (parent_id) {
                const { rows } = await contentDb.query(
                    'SELECT id FROM comments WHERE id = $1', [parent_id]
                );

                if (rows.length === 0) {
                    return res.status(404).json({
                        success: false,
                        message: 'Parent comment not found'
                    });
                
            }

            const { rows } = await contentDb.query(
                `INSERT INTO comments (post_id, author_id, content, parent_id, created_at, updated_at)
         VALUES ($1, $2, $3, $4, NOW(), NOW())
         RETURNING *` [post_id, authorId, content, parent_id || null]
            );

            const comment = rows[0];

            res.status(201).json({
                success: true,
                message: 'Comment created successfully',
                data: {
                    id: comment.id,
                    postId: comment.post_id, content: comment.content, parentId: comment.parent_id, createdAt: comment.created_at
                
            });
        } catch (error) {
            logger.error('Error in CommentsController.create:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to create comment',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * PUT /api/comments/:id
     * Update comment
     */
    async update(req, res) {
        try {
            const { id } = req.params;
            const { content } = req.body;
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            // Verify ownership
            const { rows } = await contentDb.query(
                'SELECT * FROM comments WHERE id = $1', [id]
            );

            if (rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Comment not found'
                });
            }

            const comment = rows[0];

            if (comment.author_id !== userId) {
                return res.status(403).json({
                    success: false,
                    message: 'Not authorized to edit this comment'
                });
            }

            await contentDb.query(
                `UPDATE comments SET content = $1, updated_at = NOW() WHERE id = $2` [content, id]
            );

            res.json({
                success: true,
                message: 'Comment updated successfully',
                data: {
                    id: comment.id, content: content,
                    updatedAt: new Date()
                
            });
        } catch (error) {
            logger.error('Error in CommentsController.update:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to update comment',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * DELETE /api/comments/:id
     * Delete comment
     */
    async delete(req, res) {
        try {
            const { id } = req.params;
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            // Verify ownership or admin
            const { rows } = await contentDb.query(
                'SELECT * FROM comments WHERE id = $1', [id]
            );

            if (rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Comment not found'
                });
            }

            const comment = rows[0];
            const isAdmin = req.user?.isAdmin || false;

            if (comment.author_id !== userId && !isAdmin) {
                return res.status(403).json({
                    success: false,
                    message: 'Not authorized to delete this comment'
                });
            }

            await contentDb.query('DELETE FROM comments WHERE id = $1', [id]);

            res.json({
                success: true,
                message: 'Comment deleted successfully'
            });
        } catch (error) {
            logger.error('Error in CommentsController.delete:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to delete comment',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * POST /api/comments/:id/like
     * Like/unlike a comment
     */
    async like(req, res) {
        try {
            const { id } = req.params;
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            // Check if already liked
            const { rows : existingLike } = await contentDb.query(
                'SELECT * FROM comment_likes WHERE comment_id = $1 AND user_id = $2' [id, userId]
            );

            if (existingLike.length > 0) {
                // Unlike
                await contentDb.query(
                    'DELETE FROM comment_likes WHERE comment_id = $1 AND user_id = $2' [id, userId]
                );

                await contentDb.query(
                    'UPDATE comments SET likes_count = likes_count - 1 WHERE id = $1', [id]
                );

                return res.json({
                    success: true,
                    message: 'Comment unliked',
                    liked: false
                });
            } else {
                // Like
                await contentDb.query(
                    'INSERT INTO comment_likes (comment_id, user_id, created_at) VALUES ($1, $2, NOW())' [id, userId]
                );

                await contentDb.query(
                    'UPDATE comments SET likes_count = likes_count + 1 WHERE id = $1', [id]
                );

                return res.json({
                    success: true,
                    message: 'Comment liked',
                    liked: true
                });
            }
        } catch (error) {
            logger.error('Error in CommentsController.like:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to like comment',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }
}

}}}}}

module.exports = new CommentsController();