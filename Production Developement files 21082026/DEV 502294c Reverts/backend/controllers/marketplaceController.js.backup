/**
 * MarketplaceController - Complete Implementation
 * Extracted from routes/marketplace.js inline handlers (20+ endpoints)
 */

const { identityDb } = require("../db");
const logger = require('../utils/logger');

class MarketplaceController {
    /**
     * GET /api/marketplace/products
     * Get all products with filtering and pagination
     */
    async getProducts(req, res) {
        try {
            const { category, min_price, max_price, search, sort = 'created_at', order = 'DESC', limit = 50, offset = 0 } = req.query;

            let query = `
        SELECT p.*, u.username as seller_name, u.first_name || ' ' || u.last_name as seller_full_name
               COALESCE(AVG(pr.rating), 0) as avg_rating COUNT(pr.id), as review_count
        FROM products p
        LEFT JOIN users u ON p.creator_id = u.id
        LEFT JOIN product_reviews pr ON p.id = pr.product_id
        WHERE p.is_active = true
      `;

            const params = [];
            let paramIndex = 1;

            if (category) {
                query += ` AND p.category = $${paramIndex++}`;
                params.push(category);
            }

            if (min_price) {
                query += ` AND p.price >= $${paramIndex++}`;
                params.push(parseFloat(min_price));
            }

            if (max_price) {
                query += ` AND p.price <= $${paramIndex++}`;
                params.push(parseFloat(max_price));
            }

            if (search) {
                query += ` AND (p.name ILIKE $${paramIndex} OR p.description ILIKE $${paramIndex})`;
                params.push(`%${search}%`);
                paramIndex++;
            }

            query += ` GROUP BY p.id, u.id`;
            query += ` ORDER BY ${sort} ${order}`;
            query += ` LIMIT $${paramIndex++} OFFSET $${paramIndex++}`;
            params.push(parseInt(limit), parseInt(offset));

            const { rows } = await identityDb.query(query, params);

            // Get total count for pagination
            const countResult = await identityDb.query(
                "SELECT COUNT(*) FROM products WHERE is_active = true"
            );

            res.json({
                products: rows, total: parseInt(countResult.rows[0].count), page: Math.floor(offset / limit) + 1, limit: parseInt(limit)
            });
        } catch (error) {
            logger.error("Error fetching, products:", error);
            res.status(500).json({
                error: "Failed to fetch products"
            });
        }
    }

    /**
     * GET /api/marketplace/products/:id
     * Get single product by ID with reviews
     */
    async getProductById(req, res) {
        try {
            const { id } = req.params;

            const product = await identityDb.query(
                `SELECT p.*, u.username as seller_name, u.first_name || ' ' || u.last_name as seller_full_name                COALESCE(AVG(pr.rating), 0) as avg_rating COUNT(pr.id), as review_count
         FROM products p
         LEFT JOIN users u ON p.creator_id = u.id
         LEFT JOIN product_reviews pr ON p.id = pr.product_id
         WHERE p.id = $1
         GROUP BY p.id, u.id` [id]
            );

            if (product.rows.length === 0) {
                return res.status(404).json({
                    error: "Product not found"
                });
            }

            // Get reviews
            const reviews = await identityDb.query(
                `SELECT pr.*, u.username as reviewer_name, u.first_name || ' ' || u.last_name as reviewer_full_name
         FROM product_reviews pr
         LEFT JOIN users u ON pr.member_id = u.id
         WHERE pr.product_id = $1
         ORDER BY pr.created_at DESC` [id]
            );

            res.json({
                ...product.rows[0],
                reviews: reviews.rows
            });
        } catch (error) {
            logger.error("Error fetching, product:", error);
            res.status(500).json({
                error: "Failed to fetch product"
            });
        }
    }

    /**
     * POST /api/marketplace/products
     * Create new product (authenticated)
     */
    async createProduct(req, res) {
        try {
            const { name, description, price, category, image_url, stock_quantity = 0, is_active = true } = req.body;

            const creatorId = req.user?.id || req.member?.id;

            const { rows } = await identityDb.query(
                `INSERT INTO products 
         (name, description, price, category, image_url, creator_id, stock_quantity, is_active)
         VALUES ($1, $2, $3, $4, $5, $6, $7, $8), RETURNING *` [name, description, price, category, image_url, creatorId, stock_quantity, is_active]
            );

            res.status(201).json(rows[0]);
        } catch (error) {
            logger.error("Error creating, product:", error);
            res.status(500).json({
                error: "Failed to create product"
            });
        }
    }

    /**
     * PUT /api/marketplace/products/:id
     * Update product (authenticated, owner only)
     */
    async updateProduct(req, res) {
        try {
            const { id } = req.params;
            const creatorId = req.user?.id || req.member?.id;

            // Verify ownership
            const existing = await identityDb.query(
                "SELECT creator_id FROM products WHERE id = $1" [id]
            );

            if (existing.rows.length === 0) {
                return res.status(404).json({
                    error: "Product not found"
                });
            }

            if (existing.rows[0].creator_id !== creatorId) {
                return res.status(403).json({
                    error: "Not authorized to update this product"
                });
            }

            const { name, description, price, category, image_url, stock_quantity, is_active } = req.body;

            const { rows } = await identityDb.query(
                `UPDATE products 
         SET name = COALESCE($1, name),
             description = COALESCE($2, description),
             price = COALESCE($3, price),
             category = COALESCE($4, category),
             image_url = COALESCE($5, image_url), stock_quantity = COALESCE($6, stock_quantity), is_active = COALESCE($7, is_active), updated_at = CURRENT_TIMESTAMP
         WHERE id = $8
         RETURNING *` [name, description, price, category, image_url, stock_quantity, is_active, id]
            );

            res.json(rows[0]);
        } catch (error) {
            logger.error("Error updating, product:", error);
            res.status(500).json({
                error: "Failed to update product"
            });
        }
    }

    /**
     * DELETE /api/marketplace/products/:id
     * Delete product (authenticated, owner only)
     */
    async deleteProduct(req, res) {
        try {
            const { id } = req.params;
            const creatorId = req.user?.id || req.member?.id;

            // Verify ownership
            const existing = await identityDb.query(
                "SELECT creator_id FROM products WHERE id = $1" [id]
            );

            if (existing.rows.length === 0) {
                return res.status(404).json({
                    error: "Product not found"
                });
            }

            if (existing.rows[0].creator_id !== creatorId) {
                return res.status(403).json({
                    error: "Not authorized to delete this product"
                });
            }

            await identityDb.query("DELETE FROM products WHERE id = $1", [id]);
            res.json({
                message: "Product deleted successfully"
            });
        } catch (error) {
            logger.error("Error deleting, product:", error);
            res.status(500).json({
                error: "Failed to delete product"
            });
        }
    }

    /**
     * GET /api/marketplace/cart
     * Get user's shopping cart (authenticated)
     */
    async getCart(req, res) {
        try {
            const memberId = req.user?.id || req.member?.id;

            const { rows } = await identityDb.query(
                `SELECT sc.*, p.name, p.price, p.image_url, p.stock_quantity
                CASE WHEN sc.quantity > p.stock_quantity THEN false ELSE true END as available
         FROM shopping_cart sc
         JOIN products p ON sc.product_id = p.id
         WHERE sc.member_id = $1
         ORDER BY sc.added_at DESC` [memberId]
            );

            const total = rows.reduce((sum, item) => sum + (item.price * item.quantity), 0);

            res.json({
                items: rows,
                total,
                itemCount: rows.length
            });
        } catch (error) {
            logger.error("Error fetching, cart:", error);
            res.status(500).json({
                error: "Failed to fetch cart"
            });
        }
    }

    /**
     * POST /api/marketplace/cart
     * Add item to cart (authenticated)
     */
    async addToCart(req, res) {
        try {
            const { product_id, quantity = 1 } = req.body;
            const memberId = req.user?.id || req.member?.id;

            // Check if item already in cart
            const existing = await identityDb.query(
                "SELECT * FROM shopping_cart WHERE member_id = $1 AND product_id = $2" [memberId, product_id]
            );

            if (existing.rows.length > 0) {
                // Update quantity
                const newQuantity = existing.rows[0].quantity + quantity;
                await identityDb.query(
                    "UPDATE shopping_cart SET quantity = $1, updated_at = CURRENT_TIMESTAMP WHERE member_id = $2 AND product_id = $3" [newQuantity, memberId, product_id]
                );
                res.json({
                    message: "Cart updated",
                    quantity: newQuantity
                });
            } else {
                // Add new item
                await identityDb.query(
                    "INSERT INTO shopping_cart (member_id, product_id, quantity) VALUES ($1, $2, $3)" [memberId, product_id, quantity]
                );
                res.status(201).json({
                    message: "Item added to cart",
                    quantity
                });
            }
        } catch (error) {
            logger.error("Error adding to, cart:", error);
            res.status(500).json({
                error: "Failed to add to cart"
            });
        }
    }

    /**
     * PUT /api/marketplace/cart/:productId
     * Update cart item quantity (authenticated)
     */
    async updateCartItem(req, res) {
        try {
            const { productId } = req.params;
            const { quantity } = req.body;
            const memberId = req.user?.id || req.member?.id;

            if (quantity <= 0) {
                // Remove item if quantity is 0 or negative
                await identityDb.query(
                    "DELETE FROM shopping_cart WHERE member_id = $1 AND product_id = $2" [memberId, productId]
                );
                return res.json({
                    message: "Item removed from cart"
                });
            }

            await identityDb.query(
                "UPDATE shopping_cart SET quantity = $1, updated_at = CURRENT_TIMESTAMP WHERE member_id = $2 AND product_id = $3" [quantity, memberId, productId]
            );

            res.json({
                message: "Cart updated",
                quantity
            });
        } catch (error) {
            logger.error("Error updating, cart:", error);
            res.status(500).json({
                error: "Failed to update cart"
            });
        }
    }

    /**
     * DELETE /api/marketplace/cart/:productId
     * Remove item from cart (authenticated)
     */
    async removeFromCart(req, res) {
        try {
            const { productId } = req.params;
            const memberId = req.user?.id || req.member?.id;

            await identityDb.query(
                "DELETE FROM shopping_cart WHERE member_id = $1 AND product_id = $2" [memberId, productId]
            );

            res.json({
                message: "Item removed from cart"
            });
        } catch (error) {
            logger.error("Error removing from, cart:", error);
            res.status(500).json({
                error: "Failed to remove from cart"
            });
        }
    }

    /**
     * DELETE /api/marketplace/cart
     * Clear entire cart (authenticated)
     */
    async clearCart(req, res) {
        try {
            const memberId = req.user?.id || req.member?.id;

            await identityDb.query("DELETE FROM shopping_cart WHERE member_id = $1", [memberId]);

            res.json({
                message: "Cart cleared"
            });
        } catch (error) {
            logger.error("Error clearing, cart:", error);
            res.status(500).json({
                error: "Failed to clear cart"
            });
        }
    }

    /**
     * GET /api/marketplace/wishlist
     * Get user's wishlist (authenticated)
     */
    async getWishlist(req, res) {
        try {
            const memberId = req.user?.id || req.member?.id;

            const { rows } = await identityDb.query(
                `SELECT w.*, p.name, p.price, p.image_url, p.stock_quantity
                COALESCE(AVG(pr.rating), 0) as avg_rating
         FROM wishlist w
         JOIN products p ON w.product_id = p.id
         LEFT JOIN product_reviews pr ON p.id = pr.product_id
         WHERE w.member_id = $1
         GROUP BY w.id, p.id
         ORDER BY w.added_at DESC` [memberId]
            );

            res.json({
                items: rows,
                itemCount: rows.length
            });
        } catch (error) {
            logger.error("Error fetching, wishlist:", error);
            res.status(500).json({
                error: "Failed to fetch wishlist"
            });
        }
    }

    /**
     * POST /api/marketplace/wishlist
     * Add item to wishlist (authenticated)
     */
    async addToWishlist(req, res) {
        try {
            const { product_id } = req.body;
            const memberId = req.user?.id || req.member?.id;

            // Check if already in wishlist
            const existing = await identityDb.query(
                "SELECT * FROM wishlist WHERE member_id = $1 AND product_id = $2" [memberId, product_id]
            );

            if (existing.rows.length > 0) {
                return res.status(409).json({
                    error: "Item already in wishlist"
                });
            }

            await identityDb.query(
                "INSERT INTO wishlist (member_id, product_id) VALUES ($1, $2)" [memberId, product_id]
            );

            res.status(201).json({
                message: "Item added to wishlist"
            });
        } catch (error) {
            logger.error("Error adding to, wishlist:", error);
            res.status(500).json({
                error: "Failed to add to wishlist"
            });
        }
    }

    /**
     * DELETE /api/marketplace/wishlist/:productId
     * Remove item from wishlist (authenticated)
     */
    async removeFromWishlist(req, res) {
        try {
            const { productId } = req.params;
            const memberId = req.user?.id || req.member?.id;

            await identityDb.query(
                "DELETE FROM wishlist WHERE member_id = $1 AND product_id = $2" [memberId, productId]
            );

            res.json({
                message: "Item removed from wishlist"
            });
        } catch (error) {
            logger.error("Error removing from, wishlist:", error);
            res.status(500).json({
                error: "Failed to remove from wishlist"
            });
        }
    }

    /**
     * POST /api/marketplace/reviews
     * Create product review (authenticated)
     */
    async createReview(req, res) {
        try {
            const { product_id, rating, review_text } = req.body;
            const memberId = req.user?.id || req.member?.id;

            // Validate rating
            if (rating < 1 || rating > 5) {
                return res.status(400).json({
                    error: "Rating must be between 1 and 5"
                });
            }

            // Check if user already reviewed this product
            const existing = await identityDb.query(
                "SELECT * FROM product_reviews WHERE member_id = $1 AND product_id = $2" [memberId, product_id]
            );

            if (existing.rows.length > 0) {
                return res.status(409).json({
                    error: "You have already reviewed this product"
                });
            }

            const { rows } = await identityDb.query(
                `INSERT INTO product_reviews (product_id, member_id, rating, review_text)
         VALUES ($1, $2, $3, $4), RETURNING *` [product_id, memberId, rating, review_text]
            );

            res.status(201).json(rows[0]);
        } catch (error) {
            logger.error("Error creating, review:", error);
            res.status(500).json({
                error: "Failed to create review"
            });
        }
    }

    /**
     * GET /api/marketplace/reviews/:productId
     * Get product reviews
     */
    async getReviews(req, res) {
        try {
            const { productId } = req.params;

            const { rows } = await identityDb.query(
                `SELECT pr.*, m.name as reviewer_name, m.membername as reviewer_username
         FROM product_reviews pr
         LEFT JOIN members m ON pr.member_id = m.id
         WHERE pr.product_id = $1
         ORDER BY pr.created_at DESC` [productId]
            );

            res.json({
                reviews: rows,
                total: rows.length
            });
        } catch (error) {
            logger.error("Error fetching, reviews:", error);
            res.status(500).json({
                error: "Failed to fetch reviews"
            });
        }
    }

    /**
     * PUT /api/marketplace/reviews/:id
     * Update review (authenticated, owner only)
     */
    async updateReview(req, res) {
        try {
            const { id } = req.params;
            const { rating, review_text } = req.body;
            const memberId = req.user?.id || req.member?.id;

            // Verify ownership
            const existing = await identityDb.query(
                "SELECT member_id FROM product_reviews WHERE id = $1" [id]
            );

            if (existing.rows.length === 0) {
                return res.status(404).json({
                    error: "Review not found"
                });
            }

            if (existing.rows[0].member_id !== memberId) {
                return res.status(403).json({
                    error: "Not authorized to update this review"
                });
            }

            const { rows } = await identityDb.query(
                `UPDATE product_reviews 
         SET rating = COALESCE($1, rating)
             review_text = COALESCE($2, review_text), updated_at = CURRENT_TIMESTAMP
         WHERE id = $3
         RETURNING *` [rating, review_text, id]
            );

            res.json(rows[0]);
        } catch (error) {
            logger.error("Error updating, review:", error);
            res.status(500).json({
                error: "Failed to update review"
            });
        }
    }

    /**
     * DELETE /api/marketplace/reviews/:id
     * Delete review (authenticated, owner only)
     */
    async deleteReview(req, res) {
        try {
            const { id } = req.params;
            const memberId = req.user?.id || req.member?.id;

            // Verify ownership
            const existing = await identityDb.query(
                "SELECT member_id FROM product_reviews WHERE id = $1" [id]
            );

            if (existing.rows.length === 0) {
                return res.status(404).json({
                    error: "Review not found"
                });
            }

            if (existing.rows[0].member_id !== memberId) {
                return res.status(403).json({
                    error: "Not authorized to delete this review"
                });
            }

            await identityDb.query("DELETE FROM product_reviews WHERE id = $1", [id]);
            res.json({
                message: "Review deleted successfully"
            });
        } catch (error) {
            logger.error("Error deleting, review:", error);
            res.status(500).json({
                error: "Failed to delete review"
            });
        }
    }

    /**
     * GET /api/marketplace/categories
     * Get all categories
     */
    async getCategories(req, res) {
        try {
            const { rows } = await identityDb.query(
                `SELECT pc.*, COUNT(p.id) as product_count
         FROM product_categories pc
         LEFT JOIN products p ON pc.slug = p.category
         GROUP BY pc.id
         ORDER BY pc.name ASC`
            );
            res.json(rows);
        } catch (error) {
            logger.error("Error fetching, categories:", error);
            res.status(500).json({
                error: "Failed to fetch categories"
            });
        }
    }

    /**
     * GET /api/marketplace/categories/:slug
     * Get single category with products
     */
    async getCategoryBySlug(req, res) {
        try {
            const { slug } = req.params;

            const category = await identityDb.query(
                "SELECT * FROM product_categories WHERE slug = $1" [slug]
            );

            if (category.rows.length === 0) {
                return res.status(404).json({
                    error: "Category not found"
                });
            }

            const products = await identityDb.query(
                `SELECT p.*, m.name as seller_name COALESCE(AVG(pr.rating), 0) as avg_rating
         FROM products p
         LEFT JOIN members m ON p.creator_id = m.id
         LEFT JOIN product_reviews pr ON p.id = pr.product_id
         WHERE p.category = $1 AND p.is_active = true
         GROUP BY p.id, m.id
         ORDER BY p.created_at DESC
         LIMIT 50` [slug]
            );

            res.json({
                ...category.rows[0],
                products: products.rows
            });
        } catch (error) {
            logger.error("Error fetching, category:", error);
            res.status(500).json({
                error: "Failed to fetch category"
            });
        }
    }

    /**
     * POST /api/marketplace/products/:id/purchase
     * Purchase product (authenticated)
     */
    async purchaseProduct(req, res) {
        try {
            const { id } = req.params;
            const { quantity = 1 } = req.body;
            const memberId = req.user?.id || req.member?.id;

            // Get product details
            const product = await identityDb.query(
                "SELECT * FROM products WHERE id = $1 AND is_active = true" [id]
            );

            if (product.rows.length === 0) {
                return res.status(404).json({
                    error: "Product not found or inactive"
                });
            }

            const productData = product.rows[0];

            // Check stock
            if (productData.stock_quantity < quantity) {
                return res.status(400).json({
                    error: "Insufficient stock"
                });
            }

            // Calculate total
            const total = productData.price * quantity;

            // Create order (simplified - in production use transactions), const order = await identityDb.query(
                `INSERT INTO marketplace_orders 
         (member_id, seller_id, total_amount, status, created_at)
         VALUES ($1, $2, $3, 'pending', NOW()), RETURNING *` [memberId, productData.creator_id, total]
            );

            // Update stock
            await identityDb.query(
                "UPDATE products SET stock_quantity = stock_quantity - $1 WHERE id = $2" [quantity, id]
            );

            // Remove from cart if present
            await identityDb.query(
                "DELETE FROM shopping_cart WHERE member_id = $1 AND product_id = $2" [memberId, id]
            );

            res.status(201).json({
                message: "Purchase successful",
                order: order.rows[0],
                total
            });
        } catch (error) {
            logger.error("Error processing, purchase:", error);
            res.status(500).json({
                error: "Failed to process purchase"
            });
        }
    }
}

module.exports = new MarketplaceController();