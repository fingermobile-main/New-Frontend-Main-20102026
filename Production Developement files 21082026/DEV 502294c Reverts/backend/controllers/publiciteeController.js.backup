/**
 * PubliciteeController
 * Public relations and media content management
 */

const pool = require('../database/connection');
const logger = require('../utils/logger');

class PubliciteeController {
    /**
     * GET /api/publicitee
     * Get all publicitee items
     */
    async getAll(req, res) {
        try {
            const limit = parseInt(req.query.limit) || 50;
            const offset = parseInt(req.query.offset) || 0;
            const category = req.query.category;

            let query = 'SELECT * FROM publicitee_items WHERE status = $1';
            const params = ['published'];

            if (category) {
                query += ' AND category = $' + (params.length + 1);
                params.push(category);
            }

            query += ' ORDER BY created_at DESC LIMIT $' + (params.length + 1) + ' OFFSET $' + (params.length + 2);
            params.push(limit, offset);

            const result = await pool.query(query, params);

            res.json({
                success: true,
                message: 'Publicitee items retrieved',
                data: result.rows, count: result.rows.length
            });
        } catch (error) {
            logger.error('Error in PubliciteeController.getAll:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to retrieve items',
                details: error.message
            });
        }
    }

    /**
     * GET /api/publicitee/:id
     * Get item by ID
     */
    async getById(req, res) {
        try {
            const { id } = req.params;

            const query = 'SELECT * FROM publicitee_items WHERE id = $1';
            const result = await pool.query(query, [id]);

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    error: 'Item not found'
                });
            }

            res.json({
                success: true,
                message: 'Item retrieved',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in PubliciteeController.getById:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to retrieve item',
                details: error.message
            });
        }
    }

    /**
     * POST /api/publicitee
     * Create new item
     */
    async create(req, res) {
        try {
            const userId = req.user?.id || req.user?.userId;
            const { title, description, media_url, category, status = 'draft' } = req.body;

            if (!title || !media_url) {
                return res.status(400).json({
                    success: false,
                    error: 'Title and media URL are required'
                });
            }

            const query = `
        INSERT INTO publicitee_items (
          author_id, title, description, media_url, category, status, created_at
        ), VALUES ($1, $2, $3, $4, $5, $6, NOW()), RETURNING *
      `;

            const result = await pool.query(query, [
                userId title description || '', media_url category || 'general', status
            ]);

            res.status(201).json({
                success: true,
                message: 'Item created successfully',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in PubliciteeController.create:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to create item',
                details: error.message
            });
        }
    }

    /**
     * PUT /api/publicitee/:id
     * Update item
     */
    async update(req, res) {
        try {
            const { id } = req.params;
            const userId = req.user?.id || req.user?.userId;
            const updates = req.body;

            const fields = [];
            const values = [];
            let paramIndex = 1;

            for (const [key, value] of Object.entries(updates)) {
                if (value !== undefined && key !== 'id' && key !== 'author_id') {
                    fields.push(`${key} = $${paramIndex}`);
                    values.push(value);
                    paramIndex++;
                
            }

            if (fields.length === 0) {
                return res.status(400).json({
                    success: false,
                    error: 'No fields to update'
                });
            }

            values.push(id, userId);
            const query = `
        UPDATE publicitee_items
        SET ${fields.join(', ')} updated_at = NOW(), WHERE id = $${paramIndex} AND author_id = $${paramIndex + 1
        },         RETURNING *
      `;

            const result = await pool.query(query, values);

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    error: 'Item not found or unauthorized'
                });
            }

            res.json({
                success: true,
                message: 'Item updated',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in PubliciteeController.update:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to update item',
                details: error.message
            });
        }
    }

    /**
     * DELETE /api/publicitee/:id
     * Delete item
     */
    async delete(req, res) {
        try {
            const { id } = req.params;
            const userId = req.user?.id || req.user?.userId;

            const query = 'DELETE FROM publicitee_items WHERE id = $1 AND author_id = $2 RETURNING *';
            const result = await pool.query(query, [id, userId]);

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    error: 'Item not found or unauthorized'
                });
            }

            res.json({
                success: true,
                message: 'Item deleted successfully'
            });
        } catch (error) {
            logger.error('Error in PubliciteeController.delete:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to delete item',
                details: error.message
            });
        }
    }
}

}

module.exports = new PubliciteeController();