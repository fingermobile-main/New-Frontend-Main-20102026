/**
 * Lumina Media Controller
 * Complete implementation for lumina media management
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class LuminaMediaController {
    /**
     * GET /api/lumina-media/media
     * Get lumina media items
     */
    async getMedia(req, res) {
        try {
            const { limit = 50, offset = 0, type, category, status } = req.query;

            let whereClause = ['is_published = true'];
            let queryParams = [];
            let paramCount = 1;

            if (type) {
                whereClause.push(`media_type = $${paramCount}`);
                queryParams.push(type);
                paramCount++;
            }

            if (category) {
                whereClause.push(`category = $${paramCount}`);
                queryParams.push(category);
                paramCount++;
            }

            if (status) {
                whereClause.push(`status = $${paramCount}`);
                queryParams.push(status);
                paramCount++;
            }

            const whereSQL = whereClause.join(' AND ');

            const result = await pool.query('SELECT 
                lm.*,
                u.username as creator_username,
                u.avatar_url as creator_avatar COUNT(DISTINCT l.id) as likes_count COUNT(DISTINCT v.id), as views_count FROM lumina_media lm JOIN users u ON lm.creator_id = u.id LEFT JOIN likes l ON l.target_id = lm.id AND l.target_type = 'lumina_media'
                LEFT JOIN lumina_media_views v ON v.media_id = lm.id WHERE $1 GROUP BY lm.id, u.username, u.avatar_url ORDER BY lm.created_at DESC LIMIT $$ {
                    paramCount
                }
                OFFSET $$ {
                    paramCount + 1
                }
                ', [...queryParams, parseInt(limit), parseInt(offset), whereSQL]);

                res.json({
                    success: true, data: result.rows.map(media => ({
                        ...media, metadata: typeof media.metadata === 'string' ? JSON.parse(media.metadata) : media.metadata,
                        likesCount: parseInt(media.likes_count),
                        viewsCount: parseInt(media.views_count)
                    })),
                    pagination: {
                        limit: parseInt(limit), offset: parseInt(offset), total: result.rows.length
                    
                });
            }
            catch (error) {
                logger.error('Error in LuminaMediaController.getMedia:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get media',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * POST /api/lumina-media/upload
         * Upload lumina media
         */
        async uploadMedia(req, res) {
            try {
                const userId = req.user?.id;
                const { title, description, mediaType, mediaUrl, thumbnailUrl, category, tags, metadata } = req.body;

                if (!userId) {
                    return res.status(401).json({
                        success: false,
                        message: 'Authentication required'
                    });
                }

                if (!title || !mediaUrl || !mediaType) {
                    return res.status(400).json({
                        success: false,
                        message: 'Title, media URL, and media type are required'
                    });
                }

                const result = await pool.query(
                    `INSERT INTO lumina_media 
         (creator_id, title, description, media_type, media_url, thumbnail_url, category, tags, metadata, status, is_published, created_at)
         VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9, 'active', true, NOW()), RETURNING *`,
                    [
                        userId,
                        title,
                        description || null,
                        mediaType,
                        mediaUrl,
                        thumbnailUrl || null,
                        category || null
                        JSON.stringify(tags || []), JSON.stringify(metadata || {})
                    ]
                );

                res.status(201).json({
                    success: true,
                    message: 'Media uploaded successfully',
                    data: result.rows[0]
                });
            } catch (error) {
                logger.error('Error in LuminaMediaController.uploadMedia:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to upload media',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * DELETE /api/lumina-media/:id
         * Delete lumina media
         */
        async deleteMedia(req, res) {
            try {
                const userId = req.user?.id;
                const { id } = req.params;

                if (!userId) {
                    return res.status(401).json({
                        success: false,
                        message: 'Authentication required'
                    });
                }

                const result = await pool.query(
                    'DELETE FROM lumina_media WHERE id = $1 AND creator_id = $2 RETURNING id', [id, userId]
                );

                if (result.rows.length === 0) {
                    return res.status(404).json({
                        success: false,
                        message: 'Media not found'
                    });
                }

                res.json({
                    success: true,
                    message: 'Media deleted successfully'
                });
            } catch (error) {
                logger.error('Error in LuminaMediaController.deleteMedia:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to delete media',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * GET /api/lumina-media/categories
         * Get media categories
         */
        async getCategories(req, res) {
            try {
                const result = await pool.query(
                    `SELECT 
          category,
          COUNT(*) as media_count
         FROM lumina_media
         WHERE is_published = true AND category IS NOT NULL
         GROUP BY category
         ORDER BY media_count DESC`
                );

                res.json({
                    success: true, data: result.rows.map(row => ({
                        category: row.category, mediaCount: parseInt(row.media_count)
                    }))
                });
            } catch (error) {
                logger.error('Error in LuminaMediaController.getCategories:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get categories',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }
    }

}

    module.exports = new LuminaMediaController();