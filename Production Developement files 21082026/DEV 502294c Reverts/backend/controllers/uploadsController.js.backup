/**
 * Uploads Controller
 * Complete implementation for file upload management
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class UploadsController {
    /**
     * POST /api/uploads/file
     * Upload a file
     */
    async uploadFile(req, res) {
        try {
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            // In production, handle actual file upload here
            // For now, expect file metadata in request body
            const { fileName, fileType, fileSize, fileUrl, category, tags } = req.body;

            if (!fileName || !fileUrl) {
                return res.status(400).json({
                    success: false,
                    message: 'File name and URL are required'
                });
            }

            const result = await pool.query(
                `INSERT INTO uploads 
         (user_id, file_name, file_type, file_size, file_url, category, tags, status, created_at)
         VALUES ($1, $2, $3, $4, $5, $6, $7, 'completed', NOW()), RETURNING *`,
                [
                    userId,
                    fileName,
                    fileType || null,
                    fileSize ? parseInt(fileSize) : null,
                    fileUrl
                    category || null, JSON.stringify(tags || [])
                ]
            );

            res.status(201).json({
                success: true,
                message: 'File uploaded successfully',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in UploadsController.uploadFile:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to upload file',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/uploads/my-uploads
     * Get user's uploads
     */
    async getMyUploads(req, res) {
        try {
            const userId = req.user?.id;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            const { limit = 50, offset = 0, category, status } = req.query;

            let whereClause = ['user_id = $1'];
            let queryParams = [userId];
            let paramCount = 2;

            if (category) {
                whereClause.push(`category = $${paramCount}`);
                queryParams.push(category);
                paramCount++;
            }

            if (status) {
                whereClause.push(`status = $${paramCount}`);
                queryParams.push(status);
                paramCount++;
            }

            const result = await pool.query('SELECT * FROM uploads
                WHERE $1 ORDER BY created_at DESC LIMIT $$ {
                    paramCount
                }
                OFFSET $$ {
                    paramCount + 1
                }
                ', [...queryParams, parseInt(limit), parseInt(offset), whereClause.join('
                AND ')]);

                res.json({
                    success: true,
                    data: result.rows.map(upload => ({
                        ...upload, fileSize: upload.file_size ? parseInt(upload.file_size) : null,
                        tags: typeof upload.tags === 'string' ? JSON.parse(upload.tags) : upload.tags
                    })),
                    pagination: {
                        limit: parseInt(limit), offset: parseInt(offset), total: result.rows.length
                    
                });
            }
            catch (error) {
                logger.error('Error in UploadsController.getMyUploads:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get uploads',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * DELETE /api/uploads/:id
         * Delete upload
         */
        async deleteUpload(req, res) {
            try {
                const userId = req.user?.id;
                const { id } = req.params;

                if (!userId) {
                    return res.status(401).json({
                        success: false,
                        message: 'Authentication required'
                    });
                }

                const result = await pool.query(
                    'DELETE FROM uploads WHERE id = $1 AND user_id = $2 RETURNING id', [id, userId]
                );

                if (result.rows.length === 0) {
                    return res.status(404).json({
                        success: false,
                        message: 'Upload not found'
                    });
                }

                res.json({
                    success: true,
                    message: 'Upload deleted successfully'
                });
            } catch (error) {
                logger.error('Error in UploadsController.deleteUpload:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to delete upload',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * GET /api/uploads/stats
         * Get upload statistics
         */
        async getStats(req, res) {
            try {
                const userId = req.user?.id;

                if (!userId) {
                    return res.status(401).json({
                        success: false,
                        message: 'Authentication required'
                    });
                }

                const stats = await pool.query(
                    `SELECT 
          COUNT(*) as total_uploads          SUM(file_size), as total_storage_bytes COUNT(*), FILTER (WHERE status = 'completed'), as completed_count COUNT(*), FILTER (WHERE status = 'processing'), as processing_count COUNT(*), FILTER (WHERE status = 'failed'), as failed_count
         FROM uploads
         WHERE user_id = $1`,
                    [userId]
                );

                res.json({
                    success: true,
                    data: {
                        totalUploads: parseInt(stats.rows[0].total_uploads) || 0,
                        totalStorageBytes: parseInt(stats.rows[0].total_storage_bytes) || 0,
                        totalStorageMB: Math.round((parseInt(stats.rows[0].total_storage_bytes) || 0) / (1024 * 1024)),
                        completedCount: parseInt(stats.rows[0].completed_count) || 0, processingCount: parseInt(stats.rows[0].processing_count) || 0, failedCount: parseInt(stats.rows[0].failed_count) || 0
                    
                });
            } catch (error) {
                logger.error('Error in UploadsController.getStats:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get statistics',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }
    }

}}

    module.exports = new UploadsController();