/**
 * Leaderboards Controller
 * Complete implementation for ranking and leaderboard system
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');
const User = require('../models/user');

class LeaderboardsController {
    /**
     * GET /api/leaderboards
     * Get all available leaderboards
     */
    async getAll(req, res) {
        try {
            const result = await pool.query(
                `SELECT 
          id,
          name,
          description,
          category,
          metric_type,
          is_active,
          reset_period
          created_at
         FROM leaderboards
         WHERE is_active = true
         ORDER BY category, name`
            );

            res.json({
                success: true, data: result.rows, count: result.rows.length
            });
        } catch (error) {
            logger.error('Error in LeaderboardsController.getAll:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to get leaderboards',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/leaderboards/:id
     * Get specific leaderboard with rankings
     */
    async getById(req, res) {
            try {
                const { id } = req.params;
                const { limit = 50, offset = 0, timeframe = 'all' } = req.query;

                // Get leaderboard details
                const leaderboard = await pool.query(
                    'SELECT * FROM leaderboards WHERE id = $1', [id]
                );

                if (leaderboard.rows.length === 0) {
                    return res.status(404).json({
                        success: false,
                        message: 'Leaderboard not found'
                    });
                }

                // Build time filter
                let timeFilter = '';
                if (timeframe === 'week') {
                    timeFilter = 'AND lr.recorded_at >= NOW() - INTERVAL \'7 days\'';
                } else if (timeframe === 'month') {
                    timeFilter = 'AND lr.recorded_at >= NOW() - INTERVAL \'30 days\'';
                } else if (timeframe === 'year') {
                    timeFilter = 'AND lr.recorded_at >= NOW() - INTERVAL \'365 days\'';
                }

                // Get rankings
                const rankings = await pool.query('SELECT 
                    u.id as user_id,
                    u.username,
                    u.avatar_url,
                    COALESCE(SUM(lr.value), 0) as total_value COUNT(lr.id), as record_count RANK(), OVER(ORDER BY COALESCE(SUM(lr.value), 0) DESC) as rank FROM users u LEFT JOIN leaderboard_records lr ON u.id = lr.user_id AND lr.leaderboard_id = $1 $1 GROUP BY u.id HAVING COALESCE(SUM(lr.value), 0) > 0 ORDER BY total_value DESC LIMIT $2 OFFSET $3 ', [id, parseInt(limit), parseInt(offset), timeFilter]);

                    // Get current user's position if authenticated
                    let userPosition = null;
                    if (req.user?.id) {
                        const positionResult = await pool.query('SELECT 
                            u.id as user_id,
                            u.username COALESCE(SUM(lr.value), 0) as total_value RANK(), OVER(ORDER BY COALESCE(SUM(lr.value), 0) DESC) as rank FROM users u LEFT JOIN leaderboard_records lr ON u.id = lr.user_id AND lr.leaderboard_id = $1 $1 WHERE u.id = $4 GROUP BY u.id ', [id, parseInt(limit), parseInt(offset), req.user.id, timeFilter]);
                            userPosition = positionResult.rows[0] || null;
                        }

                        res.json({
                            success: true,
                            data: {
                                leaderboard: leaderboard.rows[0],
                                rankings: rankings.rows.map(row => ({
                                    userId: row.user_id,
                                    username: row.username,
                                    avatarUrl: row.avatar_url,
                                    value: parseFloat(row.total_value),
                                    recordCount: parseInt(row.record_count),
                                    rank: parseInt(row.rank)
                                })),
                                userPosition,
                                pagination: {
                                    limit: parseInt(limit),
                                    offset: parseInt(offset),
                                    total: rankings.rows.length
                                
                            }
                        });
                    } catch (error) {
                        logger.error('Error in LeaderboardsController.getById:', error);
                        res.status(500).json({
                            success: false,
                            message: 'Failed to get leaderboard',
                            error: process.env.NODE_ENV === 'development' ? error.message : undefined
                        });
                    }
                }

                /**
                 * POST /api/leaderboards/record
                 * Submit a leaderboard record
                 */
                async submitRecord(req, res) {
                    try {
                        const userId = req.user?.id;
                        const { leaderboardId, value, metadata } = req.body;

                        if (!userId) {
                            return res.status(401).json({
                                success: false,
                                message: 'Authentication required'
                            });
                        }

                        if (!leaderboardId || value === undefined) {
                            return res.status(400).json({
                                success: false,
                                message: 'Leaderboard ID and value are required'
                            });
                        }

                        // Verify leaderboard exists
                        const leaderboard = await pool.query(
                            'SELECT * FROM leaderboards WHERE id = $1 AND is_active = true', [leaderboardId]
                        );

                        if (leaderboard.rows.length === 0) {
                            return res.status(404).json({
                                success: false,
                                message: 'Leaderboard not found or inactive'
                            });
                        }

                        // Record the score
                        await pool.query(
                            `INSERT INTO leaderboard_records (user_id, leaderboard_id, value, metadata, recorded_at)
         VALUES ($1, $2, $3, $4, NOW())` [userId, leaderboardId, value, metadata || null]
                        );

                        res.status(201).json({
                            success: true,
                            message: 'Leaderboard record submitted successfully', data: {
                                leaderboardId,
                                value, recordedAt: new Date()
                            
                        });
                    } catch (error) {
                        logger.error('Error in LeaderboardsController.submitRecord:', error);
                        res.status(500).json({
                            success: false,
                            message: 'Failed to submit leaderboard record',
                            error: process.env.NODE_ENV === 'development' ? error.message : undefined
                        });
                    }
                }

                /**
                 * GET /api/leaderboards/user/:userId
                 * Get user's positions across all leaderboards
                 */
                async getUserPositions(req, res) {
                    try {
                        const { userId } = req.params;

                        // Verify user exists
                        const user = await User.findByPk(userId);
                        if (!user) {
                            return res.status(404).json({
                                success: false,
                                message: 'User not found'
                            });
                        }

                        // Get all active leaderboards
                        const leaderboards = await pool.query(
                            'SELECT * FROM leaderboards WHERE is_active = true'
                        );

                        // Get user's position in each leaderboard
                        const positions = [];
                        for (const lb of leaderboards.rows) {
                            const result = await pool.query(
                                `SELECT 
            COALESCE(SUM(lr.value), 0) as total_value,
            RANK(), OVER (ORDER BY COALESCE(SUM(lr.value), 0) DESC) as rank
           FROM leaderboard_records lr
           WHERE lr.leaderboard_id = $1
           GROUP BY lr.user_id
           HAVING lr.user_id = $2`,
                                [lb.id, userId]
                            );

                            if (result.rows.length > 0) {
                                positions.push({
                                    leaderboardId: lb.id,
                                    leaderboardName: lb.name,
                                    category: lb.category,
                                    value: parseFloat(result.rows[0].total_value),
                                    rank: parseInt(result.rows[0].rank)
                                });
                            
                        }

                        res.json({
                            success: true,
                            data: {
                                userId, username: user.username, positions, totalLeaderboards: positions.length
                            
                        });
                    } catch (error) {
                        logger.error('Error in LeaderboardsController.getUserPositions:', error);
                        res.status(500).json({
                            success: false,
                            message: 'Failed to get user positions',
                            error: process.env.NODE_ENV === 'development' ? error.message : undefined
                        });
                    }
                }

                /**
                 * GET /api/leaderboards/category/:category
                 * Get leaderboards by category
                 */
                async getByCategory(req, res) {
                    try {
                        const { category } = req.params;
                        const { limit = 10 } = req.query;

                        const result = await pool.query(
                            `SELECT 
          l.*,
          COUNT(DISTINCT lr.user_id) as participant_count
         FROM leaderboards l
         LEFT JOIN leaderboard_records lr ON l.id = lr.leaderboard_id
         WHERE l.category = $1 AND l.is_active = true
         GROUP BY l.id
         ORDER BY l.name
         LIMIT $2`,
                            [category, parseInt(limit)]
                        );

                        res.json({
                            success: true,
                            data: result.rows.map(lb => ({
                                ...lb, participants: parseInt(lb.participant_count)
                            })), count: result.rows.length
                        });
                    } catch (error) {
                        logger.error('Error in LeaderboardsController.getByCategory:', error);
                        res.status(500).json({
                            success: false,
                            message: 'Failed to get leaderboards by category',
                            error: process.env.NODE_ENV === 'development' ? error.message : undefined
                        });
                    }
                }

                /**
                 * DELETE /api/leaderboards/reset/:id
                 * Reset leaderboard (admin only)
                 */
                async resetLeaderboard(req, res) {
                    try {
                        const { id } = req.params;

                        // Check admin permission
                        if (!req.user?.isAdmin) {
                            return res.status(403).json({
                                success: false,
                                message: 'Admin access required'
                            });
                        }

                        // Delete all records
                        await pool.query(
                            'DELETE FROM leaderboard_records WHERE leaderboard_id = $1', [id]
                        );

                        res.json({
                            success: true,
                            message: 'Leaderboard reset successfully'
                        });
                    } catch (error) {
                        logger.error('Error in LeaderboardsController.resetLeaderboard:', error);
                        res.status(500).json({
                            success: false,
                            message: 'Failed to reset leaderboard',
                            error: process.env.NODE_ENV === 'development' ? error.message : undefined
                        });
                    }
                }
            }

}}}}

            module.exports = new LeaderboardsController();