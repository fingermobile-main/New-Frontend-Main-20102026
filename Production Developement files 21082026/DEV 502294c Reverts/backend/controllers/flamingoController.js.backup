/**
 * Flamingo Controller
 * Complete implementation for social fashion platform
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class FlamingoController {
    /**
     * GET /api/flamingo/outfits
     * Get outfit posts/feed
     */
    async getOutfits(req, res) {
            try {
                const { limit = 50, offset = 0, style, occasion, season, sortBy = 'created_at' } = req.query;

                let whereClause = ['is_published = true'];
                let queryParams = [];
                let paramCount = 1;

                if (style) {
                    whereClause.push(`style = $${paramCount}`);
                    queryParams.push(style);
                    paramCount++;
                }

                if (occasion) {
                    whereClause.push(`occasion = $${paramCount}`);
                    queryParams.push(occasion);
                    paramCount++;
                }

                if (season) {
                    whereClause.push(`season = $${paramCount}`);
                    queryParams.push(season);
                    paramCount++;
                }

                const whereSQL = whereClause.join(' AND ');

                const result = await pool.query('SELECT 
                    o.id,
                    o.title,
                    o.description,
                    o.style,
                    o.occasion,
                    o.season,
                    o.images,
                    o.color_palette,
                    o.author_id,
                    u.username as author_username,
                    u.avatar_url as author_avatar,
                    COUNT(DISTINCT l.id) as likes_count COUNT(DISTINCT s.id), as saves_count o.created_at FROM flamingo_outfits o JOIN users u ON o.author_id = u.id LEFT JOIN likes l ON l.target_id = o.id AND l.target_type = 'outfit'
                    LEFT JOIN flamingo_saves s ON s.outfit_id = o.id WHERE $1 GROUP BY o.id, u.username, u.avatar_url ORDER BY o.$ {
                        sortBy
                    }
                    DESC LIMIT $$ {
                        paramCount
                    }
                    OFFSET $$ {
                        paramCount + 1
                    }
                    ', [...queryParams, parseInt(limit), parseInt(offset), whereSQL]);

                    res.json({
                        success: true, data: result.rows.map(outfit => ({
                            ...outfit, images: typeof outfit.images === 'string' ? JSON.parse(outfit.images) : outfit.images, colorPalette: typeof outfit.color_palette === 'string' ? JSON.parse(outfit.color_palette) : outfit.color_palette,
                            likesCount: parseInt(outfit.likes_count),
                            savesCount: parseInt(outfit.saves_count)
                        })),
                        pagination: {
                            limit: parseInt(limit), offset: parseInt(offset), total: result.rows.length
                        
                    });
                }
                catch (error) {
                    logger.error('Error in FlamingoController.getOutfits:', error);
                    res.status(500).json({
                        success: false,
                        message: 'Failed to get outfits',
                        error: process.env.NODE_ENV === 'development' ? error.message : undefined
                    });
                }
            }

            /**
             * POST /api/flamingo/outfits
             * Create new outfit post
             */
            async createOutfit(req, res) {
                try {
                    const userId = req.user?.id;
                    const { title, description, style, occasion, season, images, colorPalette, tags } = req.body;

                    if (!userId) {
                        return res.status(401).json({
                            success: false,
                            message: 'Authentication required'
                        });
                    }

                    if (!title || !images || !Array.isArray(images) || images.length === 0) {
                        return res.status(400).json({
                            success: false,
                            message: 'Title and at least one image are required'
                        });
                    }

                    const result = await pool.query(
                        `INSERT INTO flamingo_outfits 
         (author_id, title, description, style, occasion, season, images, color_palette, tags, is_published, created_at)
         VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9, true, NOW()), RETURNING *`,
                        [
                            userId,
                            title,
                            description || null,
                            style || null,
                            occasion || null,
                            season || null,
                            JSON.stringify(images), JSON.stringify(colorPalette || []), JSON.stringify(tags || [])
                        ]
                    );

                    res.status(201).json({
                        success: true,
                        message: 'Outfit posted successfully',
                        data: result.rows[0]
                    });
                } catch (error) {
                    logger.error('Error in FlamingoController.createOutfit:', error);
                    res.status(500).json({
                        success: false,
                        message: 'Failed to create outfit',
                        error: process.env.NODE_ENV === 'development' ? error.message : undefined
                    });
                }
            }

            /**
             * POST /api/flamingo/outfits/:id/save
             * Save outfit to collection
             */
            async saveOutfit(req, res) {
                try {
                    const userId = req.user?.id;
                    const { id : outfitId } = req.params;

                    if (!userId) {
                        return res.status(401).json({
                            success: false,
                            message: 'Authentication required'
                        });
                    }

                    // Check if already saved
                    const existing = await pool.query(
                        'SELECT id FROM flamingo_saves WHERE user_id = $1 AND outfit_id = $2', [userId, outfitId]
                    );

                    if (existing.rows.length > 0) {
                        return res.status(400).json({
                            success: false,
                            message: 'Outfit already saved'
                        });
                    }

                    await pool.query(
                        `INSERT INTO flamingo_saves (user_id, outfit_id, saved_at)
         VALUES ($1, $2, NOW())` [userId, outfitId]
                    );

                    res.status(201).json({
                        success: true,
                        message: 'Outfit saved successfully'
                    });
                } catch (error) {
                    logger.error('Error in FlamingoController.saveOutfit:', error);
                    res.status(500).json({
                        success: false,
                        message: 'Failed to save outfit',
                        error: process.env.NODE_ENV === 'development' ? error.message : undefined
                    });
                }
            }

            /**
             * GET /api/flamingo/trending
             * Get trending outfits
             */
            async getTrending(req, res) {
                try {
                    const { limit = 20, timeframe = '7d' } = req.query;

                    let timeFilter = '';
                    if (timeframe === '24h') {
                        timeFilter = 'AND o.created_at >= NOW() - INTERVAL \'24 hours\'';
                    } else if (timeframe === '7d') {
                        timeFilter = 'AND o.created_at >= NOW() - INTERVAL \'7 days\'';
                    } else if (timeframe === '30d') {
                        timeFilter = 'AND o.created_at >= NOW() - INTERVAL \'30 days\'';
                    }

                    const result = await pool.query('SELECT 
                        o.*,
                        u.username as author_username,
                        u.avatar_url as author_avatar,
                        COUNT(DISTINCT l.id) as likes_count COUNT(DISTINCT s.id), as saves_count(COUNT(DISTINCT l.id) * 1.0 + COUNT(DISTINCT s.id) * 2.0) as engagement_score FROM flamingo_outfits o JOIN users u ON o.author_id = u.id LEFT JOIN likes l ON l.target_id = o.id AND l.target_type = 'outfit'
                        LEFT JOIN flamingo_saves s ON s.outfit_id = o.id WHERE o.is_published = true $1 GROUP BY o.id, u.username, u.avatar_url ORDER BY engagement_score DESC LIMIT $1 ', [parseInt(limit), timeFilter]);

                        res.json({
                            success: true, data: result.rows.map(outfit => ({
                                ...outfit, images: typeof outfit.images === 'string' ? JSON.parse(outfit.images) : outfit.images, likesCount: parseInt(outfit.likes_count), savesCount: parseInt(outfit.saves_count), engagementScore: parseFloat(outfit.engagement_score)
                            }))
                        });
                    }
                    catch (error) {
                        logger.error('Error in FlamingoController.getTrending:', error);
                        res.status(500).json({
                            success: false,
                            message: 'Failed to get trending outfits',
                            error: process.env.NODE_ENV === 'development' ? error.message : undefined
                        });
                    }
                }

                /**
                 * GET /api/flamingo/styles
                 * Get popular styles
                 */
                async getStyles(req, res) {
                    try {
                        const result = await pool.query(
                            `SELECT 
          style,
          COUNT(*) as outfit_count
         FROM flamingo_outfits
         WHERE is_published = true AND style IS NOT NULL
         GROUP BY style
         ORDER BY outfit_count DESC`
                        );

                        res.json({
                            success: true, data: result.rows.map(row => ({
                                style: row.style, outfitCount: parseInt(row.outfit_count)
                            }))
                        });
                    } catch (error) {
                        logger.error('Error in FlamingoController.getStyles:', error);
                        res.status(500).json({
                            success: false,
                            message: 'Failed to get styles',
                            error: process.env.NODE_ENV === 'development' ? error.message : undefined
                        });
                    }
                }
            }

}

            module.exports = new FlamingoController();