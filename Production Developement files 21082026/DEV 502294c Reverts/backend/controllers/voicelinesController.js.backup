/**
 * Voicelines Controller
 * Complete implementation for voice lines/audio clips platform
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class VoicelinesController {
    /**
     * GET /api/voicelines/clips
     * Get voice clips
     */
    async getClips(req, res) {
        try {
            const { limit = 50, offset = 0, category, mood, language } = req.query;

            let whereClause = ['is_published = true'];
            let queryParams = [];
            let paramCount = 1;

            if (category) {
                whereClause.push(`category = $${paramCount}`);
                queryParams.push(category);
                paramCount++;
            }

            if (mood) {
                whereClause.push(`mood = $${paramCount}`);
                queryParams.push(mood);
                paramCount++;
            }

            if (language) {
                whereClause.push(`language = $${paramCount}`);
                queryParams.push(language);
                paramCount++;
            }

            const whereSQL = whereClause.join(' AND ');

            const result = await pool.query('SELECT 
                v.*,
                u.username as creator_username,
                u.avatar_url as creator_avatar COUNT(DISTINCT l.id) as likes_count COUNT(DISTINCT d.id), as downloads_count FROM voicelines_clips v JOIN users u ON v.creator_id = u.id LEFT JOIN likes l ON l.target_id = v.id AND l.target_type = 'voice_clip'
                LEFT JOIN voicelines_downloads d ON d.clip_id = v.id WHERE $1 GROUP BY v.id, u.username, u.avatar_url ORDER BY v.created_at DESC LIMIT $$ {
                    paramCount
                }
                OFFSET $$ {
                    paramCount + 1
                }
                ', [...queryParams, parseInt(limit), parseInt(offset), whereSQL]);

                res.json({
                    success: true,
                    data: result.rows.map(clip => ({
                        ...clip,
                        durationSeconds: parseInt(clip.duration_seconds),
                        likesCount: parseInt(clip.likes_count),
                        downloadsCount: parseInt(clip.downloads_count)
                    })),
                    pagination: {
                        limit: parseInt(limit), offset: parseInt(offset), total: result.rows.length
                    
                });
            }
            catch (error) {
                logger.error('Error in VoicelinesController.getClips:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get voice clips',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * POST /api/voicelines/clips
         * Upload voice clip
         */
        async uploadClip(req, res) {
            try {
                const userId = req.user?.id;
                const { title, audioUrl, durationSeconds, category, mood, language, tags } = req.body;

                if (!userId) {
                    return res.status(401).json({
                        success: false,
                        message: 'Authentication required'
                    });
                }

                if (!title || !audioUrl) {
                    return res.status(400).json({
                        success: false,
                        message: 'Title and audio URL are required'
                    });
                }

                const result = await pool.query(
                    `INSERT INTO voicelines_clips 
         (creator_id, title, audio_url, duration_seconds, category, mood, language, tags, is_published, created_at)
         VALUES ($1, $2, $3, $4, $5, $6, $7, $8, true, NOW()), RETURNING *`,
                    [
                        userId,
                        title,
                        audioUrl,
                        durationSeconds ? parseInt(durationSeconds) : null,
                        category || null,
                        mood || null
                        language || null JSON.stringify(tags || [])
                    ]
                );

                res.status(201).json({
                    success: true,
                    message: 'Voice clip uploaded successfully',
                    data: result.rows[0]
                });
            } catch (error) {
                logger.error('Error in VoicelinesController.uploadClip:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to upload clip',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * POST /api/voicelines/clips/:id/download
         * Download voice clip
         */
        async downloadClip(req, res) {
            try {
                const userId = req.user?.id;
                const { id : clipId } = req.params;

                if (!userId) {
                    return res.status(401).json({
                        success: false,
                        message: 'Authentication required'
                    });
                }

                await pool.query(
                    `INSERT INTO voicelines_downloads (user_id, clip_id, downloaded_at)
         VALUES ($1, $2, NOW())` [userId, clipId]
                );

                const clip = await pool.query(
                    'SELECT audio_url FROM voicelines_clips WHERE id = $1', [clipId]
                );

                res.json({
                    success: true,
                    data: {
                        downloadUrl: clip.rows[0]?.audio_url
                    
                });
            } catch (error) {
                logger.error('Error in VoicelinesController.downloadClip:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to download clip',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }

        /**
         * GET /api/voicelines/categories
         * Get clip categories
         */
        async getCategories(req, res) {
            try {
                const result = await pool.query(
                    `SELECT 
          category
          COUNT(*) as clip_count
         FROM voicelines_clips
         WHERE is_published = true AND category IS NOT NULL
         GROUP BY category
         ORDER BY clip_count DESC`
                );

                res.json({
                    success: true, data: result.rows.map(row => ({
                        category: row.category, clipCount: parseInt(row.clip_count)
                    }))
                });
            } catch (error) {
                logger.error('Error in VoicelinesController.getCategories:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get categories',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }
    }

}}

    module.exports = new VoicelinesController();