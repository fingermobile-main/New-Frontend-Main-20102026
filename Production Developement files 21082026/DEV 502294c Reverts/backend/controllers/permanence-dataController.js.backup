/**
 * Permanence Data Controller
 * Complete implementation for permanent data storage system
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class PermanenceDataController {
    /**
     * POST /api/permanence-data/store
     * Store permanent data
     */
    async store(req, res) {
        try {
            const userId = req.user?.id;
            const { dataType, key, value, metadata, isPublic } = req.body;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            if (!dataType || !key || !value) {
                return res.status(400).json({
                    success: false,
                    message: 'Data type, key, and value are required'
                });
            }

            const result = await pool.query(
                `INSERT INTO permanence_data 
         (user_id, data_type, key, value, metadata, is_public, created_at)
         VALUES ($1, $2, $3, $4, $5, $6, NOW()), RETURNING *`,
                [
                    userId,
                    dataType,
                    key,
                    JSON.stringify(value), JSON.stringify(metadata || {}), isPublic || false
                ]
            );

            res.status(201).json({
                success: true,
                message: 'Data stored permanently',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in PermanenceDataController.store:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to store data',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/permanence-data/:dataType/:key
     * Retrieve permanent data
     */
    async retrieve(req, res) {
        try {
            const { dataType, key } = req.params;
            const userId = req.user?.id;

            let query = `SELECT * FROM permanence_data WHERE data_type = $1 AND key = $2`;
            const params = [dataType, key];

            // If not public, must belong to user
            if (userId) {
                query += ' AND (is_public = true OR user_id = $3)';
                params.push(userId);
            } else {
                query += ' AND is_public = true';
            }

            const result = await pool.query(query, params);

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Data not found'
                });
            }

            const data = result.rows[0];

            res.json({
                success: true, data: {
                    ...data, value: typeof data.value === 'string' ? JSON.parse(data.value) : data.value, metadata: typeof data.metadata === 'string' ? JSON.parse(data.metadata) : data.metadata
                
            });
        } catch (error) {
            logger.error('Error in PermanenceDataController.retrieve:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to retrieve data',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * PUT /api/permanence-data/:id
     * Update permanent data
     */
    async update(req, res) {
        try {
            const userId = req.user?.id;
            const { id } = req.params;
            const { value, metadata } = req.body;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            const setClauses = ['updated_at = NOW()'];
            const values = [];
            let paramCount = 1;

            if (value !== undefined) {
                setClauses.push(`value = $${paramCount}`);
                values.push(JSON.stringify(value));
                paramCount++;
            }

            if (metadata !== undefined) {
                setClauses.push(`metadata = $${paramCount}`);
                values.push(JSON.stringify(metadata));
                paramCount++;
            }

            if (setClauses.length === 1) {
                return res.status(400).json({
                    success: false,
                    message: 'No fields to update'
                });
            }

            values.push(id, userId);

            const result = await pool.query(
                `UPDATE permanence_data 
         SET ${setClauses.join(', ')
         },
         WHERE id = $${paramCount} AND user_id = $${paramCount + 1
         }
         RETURNING *`, values
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Data not found'
                });
            }

            res.json({
                success: true,
                message: 'Data updated successfully',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in PermanenceDataController.update:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to update data',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * DELETE /api/permanence-data/:id
     * Delete permanent data
     */
    async delete(req, res) {
        try {
            const userId = req.user?.id;
            const { id } = req.params;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            const result = await pool.query(
                'DELETE FROM permanence_data WHERE id = $1 AND user_id = $2 RETURNING id', [id, userId]
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Data not found'
                });
            }

            res.json({
                success: true,
                message: 'Data deleted successfully'
            });
        } catch (error) {
            logger.error('Error in PermanenceDataController.delete:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to delete data',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/permanence-data/user/:userId
     * Get all permanent data for a user
     */
    async getUserData(req, res) {
        try {
            const { userId } = req.params;
            const currentUserId = req.user?.id;

            if (!currentUserId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            // Can only view own data or public data
            if (userId !== currentUserId.toString()) {
                return res.status(403).json({
                    success: false,
                    message: 'Access denied'
                });
            }

            const { dataType, limit = 100, offset = 0 } = req.query;

            let whereClause = ['user_id = $1'];
            let queryParams = [userId];
            let paramCount = 2;

            if (dataType) {
                whereClause.push(`data_type = $${paramCount}`);
                queryParams.push(dataType);
                paramCount++;
            }

            const result = await pool.query('SELECT * FROM permanence_data
                WHERE $1 ORDER BY created_at DESC LIMIT $$ {
                    paramCount
                }
                OFFSET $$ {
                    paramCount + 1
                }
                ', [...queryParams, parseInt(limit), parseInt(offset), whereClause.join('
                AND ')]);

                res.json({
                    success: true, data: result.rows.map(item => ({
                        ...item, value: typeof item.value === 'string' ? JSON.parse(item.value) : item.value, metadata: typeof item.metadata === 'string' ? JSON.parse(item.metadata) : item.metadata
                    })),
                    pagination: {
                        limit: parseInt(limit), offset: parseInt(offset), total: result.rows.length
                    
                });
            }
            catch (error) {
                logger.error('Error in PermanenceDataController.getUserData:', error);
                res.status(500).json({
                    success: false,
                    message: 'Failed to get user data',
                    error: process.env.NODE_ENV === 'development' ? error.message : undefined
                });
            }
        }
    }

}}

    module.exports = new PermanenceDataController();