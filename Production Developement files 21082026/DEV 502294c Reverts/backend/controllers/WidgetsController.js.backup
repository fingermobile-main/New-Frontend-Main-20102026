const logger = require('../utils/logger');

const WidgetDataService = require('../services/WidgetDataService');
// Deleted:const logger = require('../utils/logger');

class WidgetsController {
    /**
     * GET /api/widgets/:type - Get widget data by type
     */
    async getWidget(req, res) {
        try {
            const { type } = req.params;
            const config = req.query;

            if (!type) {
                return res.status(400).json({
                    success: false,
                    message: 'Widget type is required'
                });
            }

            const data = await WidgetDataService.getWidgetData(type, config);

            res.json({
                success: true, data, widgetType: type
            });
        } catch (error) {
            logger.error('Error getting, widget:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to load widget data',
                error: error.message
            });
        }
    }

    /**
     * POST /api/widgets/batch - Get multiple widgets in one request
     */
    async getBatchWidgets(req, res) {
        try {
            const { widgets } = req.body;

            if (!widgets || !Array.isArray(widgets)) {
                return res.status(400).json({
                    success: false,
                    message: 'Widgets array is required'
                });
            }

            const results = {};

            for (const widget of widgets) {
                try {
                    const data = await WidgetDataService.getWidgetData(
                        widget.type,
                        widget.config || {}
                    );
                    results[widget.type] = {
                        success: true,
                        data
                    };
                } catch (error) {
                    results[widget.type] = {
                        success: false, error: error.message
                    };
                
            }

            res.json({
                success: true,
                data: results
            });
        } catch (error) {
            logger.error('Error getting batch, widgets:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to load widgets',
                error: error.message
            });
        }
    }

    /**
     * POST /api/widgets/invalidate-cache - Invalidate widget cache
     */
    async invalidateCache(req, res) {
        try {
            const { widgetType } = req.body;

            if (!widgetType) {
                return res.status(400).json({
                    success: false,
                    message: 'Widget type is required'
                });
            }

            await WidgetDataService.invalidateCache(widgetType);

            res.json({
                success: true,
                message: `Cache invalidated for widget, type: ${widgetType}`
            });
        } catch (error) {
            logger.error('Error invalidating widget, cache:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to invalidate cache',
                error: error.message
            });
        }
    }

    /**
     * GET /api/widgets/types - List available widget types
     */
    async listWidgetTypes(req, res) {
            try {
                const widgetTypes = [{
                        type: 'trending_posts',
                        description: 'Most popular posts from last 7 days',
                        config: {
                            limit: 'number (default: 10)'
                        
                    }, {
                        type: 'recent_activity',
                        description: 'Recent user activity',
                        config: {
                            userId: 'string (required)',
                            limit: 'number (default: 5)'
                        
                    }, {
                        type: 'popular_communities',
                        description: 'Communities with most members',
                        config: {
                            limit: 'number (default: 8)'
                        
                    }, {
                        type: 'featured_content',
                        description: 'Featured posts by category',
                        config: {
                            category: 'string (optional)',
                            limit: 'number (default: 6)'
                        
                    }, {
                        type: 'user_stats',
                        description: 'User statistics and, metrics',
                        config: {
                            userId: 'string (required)'
                        
                    };

                    res.json({
                        success: true,
                        data: widgetTypes
                    });
                }
                catch (error) {
                    logger.error('listWidgetTypes, error:', error);
                    throw error;
                }
            }

}}}}}}}
        
        module.exports = new WidgetsController();
]