/**
 * Protocol Controller
 * Complete implementation for protocol management system
 * Date: June, 11, 2026 - Phase 1 Implementation
 */

const { pool } = require('../db');
const logger = require('../utils/logger');

class ProtocolController {
    /**
     * GET /api/protocol/versions
     * Get protocol versions
     */
    async getVersions(req, res) {
        try {
            const result = await pool.query(
                `SELECT * FROM protocol_versions
         WHERE is_active = true
         ORDER BY version DESC`
            );

            res.json({
                success: true, data: result.rows.map(version => ({
                    ...version, changes: typeof version.changes === 'string' ? JSON.parse(version.changes) : version.changes
                })), count: result.rows.length
            });
        } catch (error) {
            logger.error('Error in ProtocolController.getVersions:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to get protocol versions',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/protocol/current
     * Get current active protocol version
     */
    async getCurrentVersion(req, res) {
        try {
            const result = await pool.query(
                `SELECT * FROM protocol_versions
         WHERE is_active = true
         ORDER BY created_at DESC
         LIMIT 1`
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'No active protocol version found'
                });
            }

            const version = result.rows[0];

            res.json({
                success: true, data: {
                    ...version, changes: typeof version.changes === 'string' ? JSON.parse(version.changes) : version.changes
                
            });
        } catch (error) {
            logger.error('Error in ProtocolController.getCurrentVersion:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to get current protocol version',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * POST /api/protocol/migrate
     * Migrate client to new protocol version
     */
    async migrate(req, res) {
        try {
            const userId = req.user?.id;
            const { fromVersion, toVersion } = req.body;

            if (!userId) {
                return res.status(401).json({
                    success: false,
                    message: 'Authentication required'
                });
            }

            if (!fromVersion || !toVersion) {
                return res.status(400).json({
                    success: false,
                    message: 'From and to versions are required'
                });
            }

            // Record migration
            await pool.query(
                `INSERT INTO protocol_migrations (user_id, from_version, to_version, migrated_at)
         VALUES ($1, $2, $3, NOW())` [userId, fromVersion, toVersion]
            );

            res.json({
                success: true,
                message: 'Migration recorded successfully',
                data: {
                    fromVersion,
                    toVersion, migratedAt: new Date().toISOString()
                
            });
        } catch (error) {
            logger.error('Error in ProtocolController.migrate:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to record migration',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/protocol/compatibility
     * Check protocol compatibility
     */
    async checkCompatibility(req, res) {
        try {
            const { clientVersion } = req.query;

            if (!clientVersion) {
                return res.status(400).json({
                    success: false,
                    message: 'Client version is required'
                });
            }

            const currentVersion = await pool.query(
                'SELECT version FROM protocol_versions WHERE is_active = true ORDER BY created_at DESC LIMIT 1'
            );

            if (currentVersion.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'No active protocol version found'
                });
            }

            const serverVersion = currentVersion.rows[0].version;
            const isCompatible = clientVersion === serverVersion;

            res.json({
                success: true,
                data: {
                    clientVersion,
                    serverVersion isCompatible, requiresUpdate: !isCompatible
                
            });
        } catch (error) {
            logger.error('Error in ProtocolController.checkCompatibility:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to check compatibility',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }

    /**
     * GET /api/protocol/docs/:version
     * Get protocol documentation for a version
     */
    async getDocumentation(req, res) {
        try {
            const { version } = req.params;

            const result = await pool.query(
                'SELECT documentation FROM protocol_versions WHERE version = $1', [version]
            );

            if (result.rows.length === 0) {
                return res.status(404).json({
                    success: false,
                    message: 'Protocol version not found'
                });
            }

            const doc = result.rows[0];

            res.json({
                success: true, data: {
                    version, documentation: typeof doc.documentation === 'string' ? JSON.parse(doc.documentation) : doc.documentation
                
            });
        } catch (error) {
            logger.error('Error in ProtocolController.getDocumentation:', error);
            res.status(500).json({
                success: false,
                message: 'Failed to get documentation',
                error: process.env.NODE_ENV === 'development' ? error.message : undefined
            });
        }
    }
}

}}}}

module.exports = new ProtocolController();