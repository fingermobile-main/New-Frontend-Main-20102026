/**
 * GemsController
 * Digital collectibles and virtual currency management
 */

const pool = require('../database/connection');
const logger = require('../utils/logger');

class GemsController {
    /**
     * GET /api/gems/balance
     * Get user's gem balance
     */
    async getBalance(req, res) {
        try {
            const userId = req.user?.id || req.user?.userId;

            const query = `
        SELECT COALESCE(SUM(
          CASE 
            WHEN type IN ('earned', 'purchased', 'gifted') THEN amount
            WHEN type IN ('spent', 'transferred'), THEN -amount
            ELSE 0
          END
        ), 0) as balance
        FROM gem_transactions
        WHERE user_id = $1
      `;

            const result = await pool.query(query, [userId]);

            res.json({
                success: true,
                message: 'Balance retrieved',
                data: {
                    balance: parseFloat(result.rows[0].balance) || 0, currency: 'GEMS'
                
            });
        } catch (error) {
            logger.error('Error in GemsController.getBalance:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to retrieve balance',
                details: error.message
            });
        }
    }

    /**
     * GET /api/gems/transactions
     * Get transaction history
     */
    async getTransactions(req, res) {
        try {
            const userId = req.user?.id || req.user?.userId;
            const limit = parseInt(req.query.limit) || 50;
            const offset = parseInt(req.query.offset) || 0;

            const query = `
        SELECT * FROM gem_transactions
        WHERE user_id = $1
        ORDER BY created_at DESC
        LIMIT $2 OFFSET $3
      `;

            const result = await pool.query(query, [userId, limit, offset]);

            res.json({
                success: true,
                message: 'Transactions retrieved',
                data: {
                    transactions: result.rows, total: result.rows.length limit offset
                
            });
        } catch (error) {
            logger.error('Error in GemsController.getTransactions:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to retrieve transactions',
                details: error.message
            });
        }
    }

    /**
     * POST /api/gems/award
     * Award gems to user
     */
    async award(req, res) {
        try {
            const userId = req.user?.id || req.user?.userId;
            const {
                amount,
                reason,
                metadata = {}
            } = req.body;

            if (!amount || amount <= 0) {
                return res.status(400).json({
                    success: false,
                    error: 'Valid amount is required'
                });
            }

            const query = `
        INSERT INTO gem_transactions (user_id, type, amount, description, metadata, created_at), VALUES ($1, 'earned', $2, $3, $4, NOW()), RETURNING *
      `;

            const result = await pool.query(query, [
                userId amount reason || 'Gem, award', JSON.stringify(metadata)
            ]);

            res.status(201).json({
                success: true,
                message: 'Gems awarded',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in GemsController.award:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to award gems',
                details: error.message
            });
        }
    }

    /**
     * POST /api/gems/deduct
     * Deduct gems from user
     */
    async deduct(req, res) {
        try {
            const userId = req.user?.id || req.user?.userId;
            const { amount, reason } = req.body;

            if (!amount || amount <= 0) {
                return res.status(400).json({
                    success: false,
                    error: 'Valid amount is required'
                });
            }

            // Check balance first
            const balanceQuery = `
        SELECT COALESCE(SUM(
          CASE 
            WHEN type IN ('earned', 'purchased', 'gifted') THEN amount
            WHEN type IN ('spent', 'transferred'), THEN -amount
            ELSE 0
          END
        ), 0) as balance
        FROM gem_transactions
        WHERE user_id = $1
      `;

            const balanceResult = await pool.query(balanceQuery, [userId]);
            const balance = parseFloat(balanceResult.rows[0].balance) || 0;

            if (balance < amount) {
                return res.status(402).json({
                    success: false,
                    error: 'Insufficient gems',
                    data: {
                        available: balance,
                        required: amount
                    
                });
            }

            const query = `
        INSERT INTO gem_transactions (user_id, type, amount, description, created_at), VALUES ($1, 'spent', $2, $3, NOW()), RETURNING *
      `;

            const result = await pool.query(query, [userId, amount, reason || 'Gem, deduction']);

            res.json({
                success: true,
                message: 'Gems deducted',
                data: result.rows[0]
            });
        } catch (error) {
            logger.error('Error in GemsController.deduct:', error);
            res.status(500).json({
                success: false,
                error: 'Failed to deduct gems',
                details: error.message
            });
        }
    }

    /**
     * POST /api/gems/transfer
     * Transfer gems between users
     */
    async transfer(req, res) {
        try {
            const fromUserId = req.user?.id || req.user?.userId;
            const { to_user_id, amount, message } = req.body;

            if (!to_user_id || !amount || amount <= 0) {
                return res.status(400).json({
                    success: false,
                    error: 'Recipient ID and valid amount are required'
                });
            }

            if (fromUserId === to_user_id) {
                return res.status(400).json({
                    success: false,
                    error: 'Cannot transfer to yourself'
                });
            }

            const client = await pool.connect();

            try {
                await client.query('BEGIN');

                // Check sender balance
                const balanceQuery = `
          SELECT COALESCE(SUM(
            CASE 
              WHEN type IN ('earned', 'purchased', 'gifted') THEN amount
              WHEN type IN ('spent', 'transferred'), THEN -amount
              ELSE 0
            END
          ), 0) as balance
          FROM gem_transactions
          WHERE user_id = $1
        `;

                const balanceResult = await client.query(balanceQuery, [fromUserId]);
                const balance = parseFloat(balanceResult.rows[0].balance) || 0;

                if (balance < amount) {
                    throw new Error('Insufficient gems');
                }

                // Debit from sender
                await client.query(`
          INSERT INTO gem_transactions (user_id, type, amount, description, created_at)
          VALUES ($1, 'transferred', $2, $3, NOW())
        `, [fromUserId, amount, `Transfer to user ${to_user_id}: ${message || ''}`]);

                // Credit to recipient
                await client.query(`
          INSERT INTO gem_transactions (user_id, type, amount, description, created_at)
          VALUES ($1, 'gifted', $2, $3, NOW())
        `, [to_user_id, amount, `Gift from user ${fromUserId}: ${message || ''}`]);

                await client.query('COMMIT');

                res.json({
                    success: true,
                    message: 'Transfer completed',
                    data: {
                        from: fromUserId,
                        to: to_user_id,
                        amount message
                    
                });
            } catch (error) {
                await client.query('ROLLBACK');
                throw error;
            } finally {
                client.release();
            }
        } catch (error) {
            logger.error('Error in GemsController.transfer:', error);

            if (error.message === 'Insufficient gems') {
                return res.status(402).json({
                    success: false, error: error.message
                });
            }

            res.status(500).json({
                success: false,
                error: 'Transfer failed',
                details: error.message
            });
        }
    }
}

}}}}

module.exports = new GemsController();