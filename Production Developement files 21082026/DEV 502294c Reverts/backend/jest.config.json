{
  "testEnvironment": "node",
  "roots": ["<rootDir>/__tests__", "<rootDir>/tests"],
  "testMatch": [
    "**/__tests__/**/*.test.js",
    "**/__tests__/**/*.test.ts",
    "**/tests/**/*.test.js",
    "**/tests/**/*.test.ts",
    "**/*.test.js",
    "**/*.test.ts"
  ],
  "collectCoverageFrom": [
    "controllers/**/*.{js,ts}",
    "models/**/*.{js,ts}",
    "routes/**/*.{js,ts}",
    "middleware/**/*.{js,ts}",
    "services/**/*.{js,ts}",
    "!**/node_modules/**",
    "!**/__tests__/**",
    "!**/tests/**"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 70,
      "functions": 70,
      "lines": 70,
      "statements": 70
    }
  },
  "moduleFileExtensions": ["ts", "js", "json"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!chai)/"
  ],
  "setupFilesAfterEnv": ["<rootDir>/jest.setup.js"],
  "verbose": true,
  "testTimeout": 30000
}
