{
  "name": "fingermobile-protocol-communication",
  "version": "1.0.0",
  "description": "FingerMobile Protocol Communication Layer",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:unit": "jest packages/*/src/**/__tests__/**/*.test.{js,ts}",
    "test:integration": "jest packages/*/src/**/__tests__/**/*.integration-test.{js,ts}",
    "test:payment": "jest packages/backend/src/**/__tests__/payment*.test.{js,ts}",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd packages/backend && npm run dev",
    "dev:frontend": "cd packages/frontend && npm run dev",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "cd packages/backend && npm run build",
    "build:frontend": "cd packages/frontend && npm run build",
    "start": "node dist/index.js",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "keywords": [
    "fingermobile",
    "protocol",
    "communication",
    "web3",
    "cryptocurrency",
    "payment",
    "stripe",
    "ethereum"
  ],
  "author": "FingerMobile Team",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "concurrently": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "husky": "^8.0.0",
    "jest": "^29.0.0",
    "lint-staged": "^13.0.0",
    "prettier": "^2.7.0",
    "ts-jest": "^29.0.0",
    "typescript": "^4.8.0"
  },
  "dependencies": {
    "ethers": "^6.0.0",
    "stripe": "^12.0.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "helmet": "^6.0.0",
    "swagger-ui-express": "^4.6.0",
    "dotenv": "^16.0.0",
    "pg": "^8.8.0",
    "sequelize": "^6.25.0",
    "axios": "^1.0.0",
    "bcrypt": "^5.1.0",
    "jsonwebtoken": "^9.0.0"
  },
  "lint-staged": {
    "*.{js,ts,json,md}": [
      "prettier --write"
    ],
    "*.{js,ts}": [
      "eslint --fix"
    ]
  }
}